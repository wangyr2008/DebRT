#!/bin/sh
# DebRT PPPoE 看门狗
#
# 背景（2026-11-05 真机实录）：pppd 的 persist 对"接口被外部删除"不敏感——服务
# 仍是 active、进程还在，但 ppp0 已经不存在，既不自愈也不报错，表现为"拨不了号"。
# 典型诱因是 networkd 重配 / 手工 reconfigure ppp0 打断了会话。
#
# 策略：周期检查（默认 1 分钟）。ppp0 缺失先打标记，给拨号留一个周期；连续缺失
# 超过 3 分钟才重启服务，避免正常拨号过程中被误杀。
set -u
CFG="/etc/dert/config.json"
FLAG="/run/dert/pppoe-watchdog-miss"
UNIT="dert-pppoe.service"

[ -f "$CFG" ] || exit 0
mkdir -p /run/dert 2>/dev/null || true

MODE="$(python3 -c "import json;print(json.load(open('$CFG')).get('wan',{}).get('mode',''))" 2>/dev/null)"
if [ "$MODE" != "pppoe" ]; then
  rm -f "$FLAG" 2>/dev/null
  exit 0
fi

# C-6：WAN 口无缆线时不清 flag 也不重启——pppd persist 本就在重试，
# 此刻重启只是无意义搅动；载波恢复由热插拔钩子负责轻推
WPORT="$(python3 -c "import json;print(next((p['name'] for p in json.load(open('$CFG')).get('ports',[]) if p.get('wan')),''))" 2>/dev/null)"
if [ -n "$WPORT" ] && [ "$(cat /sys/class/net/$WPORT/carrier 2>/dev/null || echo 0)" != "1" ]; then
  rm -f "$FLAG" 2>/dev/null
  exit 0
fi

# 服务没在跑：直接拉起
if ! systemctl is-active --quiet "$UNIT"; then
  logger -t dert-pppoe-watchdog "拨号服务未运行，拉起"
  systemctl start "$UNIT" 2>/dev/null || true
  rm -f "$FLAG" 2>/dev/null
  exit 0
fi

# 健康判据：ppp0 有 IPv4 或全局 IPv6 都算通。
# 只认 IPv4 会误杀 IPv6-only 链路（DS-Lite / 纯 IPv6 专线）：那类环境永远没有
# IPv4，看门狗会每 3 分钟重启一次拨号，比"卡死不恢复"更糟。
if ip -4 addr show ppp0 2>/dev/null | grep -q 'inet ' \
   || ip -6 addr show ppp0 2>/dev/null | grep -q 'scope global'; then
  rm -f "$FLAG" 2>/dev/null
  exit 0
fi

# 首次缺失：只打标记，等下一个周期（拨号建立本身需要时间）
if [ ! -f "$FLAG" ]; then
  date +%s > "$FLAG" 2>/dev/null || true
  exit 0
fi

AGE=$(( $(date +%s) - $(cat "$FLAG" 2>/dev/null || echo 0) ))
if [ "$AGE" -ge 180 ]; then
  logger -t dert-pppoe-watchdog "ppp0 缺失 ${AGE}s（服务 active 但无会话），重启拨号"
  systemctl restart "$UNIT" 2>/dev/null || true
  rm -f "$FLAG" 2>/dev/null
fi
exit 0
