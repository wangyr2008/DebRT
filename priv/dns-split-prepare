#!/usr/bin/env bash
# dns-split-prepare —— sing-box 启动前生成 00-dert-dns.json
#
# 为什么必须在启动前：sing-box 用 -C /etc/sing-box 做目录合并，配置只在启动时读取。
# 启动后再写这个文件不会生效，所以本脚本挂在 ExecStartPre（wait-wan 之后）。
#
# 生成内容（只含「设备维度」的规则，域名维度的分流归 sub-store 的 config.json）：
#   1. direct inbound 监听 5353 —— 白名单设备专用 DNS 入口，nft 按 MAC 把 53 端口
#      DNAT 到这里。用独立端口而不是 tun DNS，是为了让「按 MAC 分流」完全落在
#      nft 的二层匹配（ether saddr）上，不依赖源 IP，也不依赖邻居表。
#   1b. 路由器自身不再单独开 DNS 入口（v0.1.136）：改由 dert_dns 表的 out 链把本机
#      发往 127.0.0.1:53 / [::1]:53 的查询 redirect 到 5353，和白名单设备共用 dns-in。
#      以前（v0.1.118~v0.1.135）用 127.0.0.2:53 的 dns-self inbound，本机读两个
#      nameserver、靠 glibc 收 ICMP 端口不可达来回落——和局域网那套 nft 机制重复，
#      而且 dns-self 只监听 v4，resolv.conf 不能写 ::1，本机 v6 查询一直绕回
#      dnsmasq（污染照旧）。改后 resolv.conf 只有 127.0.0.1 一行，回落和局域网
#      设备一致：ExecStopPost 删表 → 查询回到 dnsmasq。见 priv/dns-split-sync。
#   2. route.rules hijack-dns —— 把 5353 收到的查询交给 sing-box 内部 DNS 模块。
#      不能带 protocol: "dns"：direct inbound 不做 sniff，protocol 识别不出来，
#      规则会静默不匹配、退回默认 direct outbound，把查询转发回 5353 自己形成
#      无限循环（真机 2026-11-11 实测 CPU 飙到 130%）。
#   3. xxx.lan → dnsmasq（landns，固定 127.0.0.1）—— 保住本地主机名与 PTR 反查。
#
# 非白名单设备由 dert_base 的 dstnat 链劫持到 dnsmasq:53，完全不进 sing-box，
# 因此这里不需要任何「按源 IP 分流」的规则（v0.1.57~v0.1.64 的 source_ip_cidr /
# carrier 已移除）。dnsmasq 的上游查询由 dert_base 的 dns_bypass 链打标绕过
# sing-box（见 netgen.py）。
#
# 写文件用 tmp + rename，避免 sing-box 读到半个 JSON。
set -u

# 测试缝（v0.1.75）：同 dns-split-sync，未设 DERT_FSROOT 时行为完全不变
FSROOT="${DERT_FSROOT:-}"
CONF="${FSROOT}/etc/sing-box/config.json"
DNSJSON="${FSROOT}/etc/sing-box/00-dert-dns.json"
[ -f "$CONF" ] || exit 0

# landns 直接指向 127.0.0.1（v0.1.139 起）：
#   - dnsmasq 有 interface=lo，本来就监听 127.0.0.1；
#   - sing-box 自己发出的查询被 out 链的 `meta skuid <sing-box uid> return` 排除，
#     不会被重定向回 5353（真机用 setpriv 验证过）；
#   - 查不到 uid、out 链没建时，sing-box 查 127.0.0.1 会直接到 dnsmasq，同样正确。
#
# 以前取 br-lan 的 IPv4（拿不到时回退写死 192.168.10.1），片段内容和 LAN 地址
# 绑死：改 LAN IP 时若恰好读不到地址，片段变了就会触发一次多余的 sing-box 重启
# （审计 §2.1）。改成 127.0.0.1 后彻底解耦。
#
# v0.1.65 起不再需要 br-lan 的 v6 前缀和运营商 DNS 地址：
#   - direct inbound 监听 "::" 双栈，不绑定具体 v6 地址
#   - 非白名单设备的 DNS 由 dert_base 的 dstnat 劫持到 dnsmasq，不经 sing-box，
#     所以这里也不需要「按源 IP 分流到运营商」的规则（v0.1.57~v0.1.64 的 carrier 已移除）

python3 - "$DNSJSON" "$CONF" <<'PYEOF'
import json, os, sys, tempfile

path, sb_conf = sys.argv[1], sys.argv[2]

# 本片段的 route.rules 会被 sing-box 的目录合并**排到最前面**（真机用
# `sing-box merge` 验证过：合并后 [0][1] 是这里的 hijack-dns，config.json 的
# bypass 被挤到 [2]）。所以这里是唯一能在不改订阅模板的前提下「抢在 bypass 之前」
# 的位置。
#
# 为什么要抢：config.json 里 bypass 的判据是 ip_is_private，而它覆盖 fc00::/7，
# Tailscale 的 fd7a:115c:a1e0::/48 正好在里面；三条 ts-ep 规则却排在 bypass 之后。
# 结果是发往 tailnet 的 v6 包被判 bypass、交回内核，而 endpoint 是用户态实现、
# 主路由表里没有 fd7a 的路由 → 从 WAN 发出去 → 超时（真机计数器实测：
# fd7a:: 的 bypass 计数 +1、redirect +0；100.100.100.100 反过来）。
# fakeip 之所以不受影响，是因为预匹配会把它还原成域名，ip_is_private 对域名不生效。
#
# 只加 v6 这一段：100.64.0.0/10 不在 ip_is_private 里，实测本来就是 redirect 的。
TAILSCALE_V6 = "fd7a:115c:a1e0::/48"
extra = []
try:
    with open(sb_conf, encoding="utf-8") as f:
        _sb = json.load(f)
    for e in _sb.get("endpoints") or []:
        if e.get("type") == "tailscale" and e.get("tag"):
            extra.append({"ip_cidr": [TAILSCALE_V6], "outbound": e["tag"]})
            break
except Exception:
    pass          # 读不到主配置（首装）或没有 tailscale：不加这条规则

cfg = {
    # 白名单专用 DNS 入口：nft 把白名单设备的 53 端口 DNAT 到这里。
    # 用独立端口而不是 tun DNS，是为了让「按 MAC 分流」在 nft 层完成，
    # sing-box 只负责把进来的 DNS 交给内部 DNS 模块（hijack-dns）。
    "inbounds": [
        {
            "type": "direct",
            "tag": "dns-in",
            # 必须监听双栈：nft 把白名单设备的 v6 DNS DNAT 到 [br-lan GUA]:5353，
            # 只绑 v4 地址的话 v6 查询会 connection refused（真机 2026-11-12 实测，
            # 白名单设备已发 437 个 v6 DNS 包全部落空）。
            "listen": "::",
            "listen_port": 5353,
            # 不写 network：省略时同时监听 tcp+udp（真机验证）。
            # nft 把白名单设备的 { tcp, udp } dport 53 都 DNAT 到这里，
            # 只绑 UDP 会让 TCP DNS 直接 connection refused——而且客户端
            # 不会自动退回 UDP，表现是"某个域名解析不了"。
            # 触发场景：响应被截断后重试、客户端强制 TCP、大记录查询。
            # （v0.1.101 修；此前写死 "udp"，dig +tcp 实测被拒。）
        },
    ],
    "route": {
        "rules": extra + [
            # 不能带 protocol: "dns" —— direct inbound 不做 sniff，protocol 识别不出来，
            # 规则不匹配就会走默认 direct outbound，把查询转发回 5353 自己，
            # 形成无限循环（真机 2026-11-11 实测 CPU 飙到 130%）。
            # nft 已经保证只有 53 端口的 DNS 会进这个 inbound，只匹配 inbound 就够。
            {"inbound": "dns-in", "action": "hijack-dns"},
        ]
    },
    "dns": {
        "servers": [
            {"type": "udp", "server": "127.0.0.1", "tag": "landns"},
        ],
        "rules": [
            # .lan 走 dnsmasq，保住本地主机名与 PTR
            {"domain_suffix": ["lan"], "server": "landns"},
        ],
    }
}

# 用 mkstemp 而不是固定名字的 path + ".tmp"：/etc/sing-box 被 sb_fix_perms
# 整体 chown 给了 sing-box，而本脚本可能以 root 运行（收敛、前缀钩子）。固定
# 名字的 tmp 允许被攻破的 sing-box 预先放置软链，把 root 的写入引到任意路径。
# mkstemp 用 O_EXCL 创建、名字随机，绕不开（审计附 A1）。
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".",
                           prefix=".00-dert-dns.", suffix=".tmp")
try:
    # 属主在这里改，**不经过路径**：os.fchown 作用在 fd 上，不会跟随软链。
    # 用 shell 的 `chown "$DNSJSON"` 不安全——/etc/sing-box 属于 sing-box，被攻破
    # 的进程可以在 os.replace 和 chown 之间把目标换成指向 /etc/shadow 的软链，
    # root 就会把那个文件的属主改掉（审计附 A1，第二次）。
    if os.geteuid() == 0:
        try:
            import pwd
            pw = pwd.getpwnam("sing-box")
            os.fchown(fd, pw.pw_uid, pw.pw_gid)
        except KeyError:
            pass      # 用户不存在（首装）：保持 root
    # 权限也走 fd：mkstemp 本来就是 0600，这行只是把意图写明。用 os.chmod(tmp)
    # 会跟随软链——被攻破的 sing-box 能在 mkstemp 和 chmod 之间把 tmp 换成指向
    # /etc/passwd 的软链，root 就会把那个文件改成 0600（审计附 A1，第三次）。
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, path)
except BaseException:
    # 任何失败都删掉临时文件，别在 /etc/sing-box 里留垃圾
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PYEOF

exit 0
