#!/usr/bin/env bash
# dns-split-prepare —— sing-box 启动前生成 00-dert-dns.json
#
# 为什么必须在启动前：sing-box 用 -C /etc/sing-box 做目录合并，配置只在启动时读取。
# 启动后再写这个文件不会生效，所以本脚本挂在 ExecStartPre（wait-wan 之后）。
#
# 生成内容（只含「设备维度」的规则，域名维度的分流归 sub-store 的 config.json）：
#   1. direct inbound 监听 5353 —— 白名单设备专用 DNS 入口，nft 按 MAC 把 53 端口
#      DNAT 到这里。用独立端口而不是 tun DNS，是为了让「按 MAC 分流」完全落在
#      nft 的二层匹配（ether saddr）上，不依赖源 IP，也不依赖邻居表。
#   2. route.rules hijack-dns —— 把 5353 收到的查询交给 sing-box 内部 DNS 模块。
#      不能带 protocol: "dns"：direct inbound 不做 sniff，protocol 识别不出来，
#      规则会静默不匹配、退回默认 direct outbound，把查询转发回 5353 自己形成
#      无限循环（真机 2026-11-11 实测 CPU 飙到 130%）。
#   3. xxx.lan → dnsmasq（landns）—— 保住本地主机名与 PTR 反查。
#
# 非白名单设备由 nft 直接 DNAT 到 dnsmasq:53，完全不进 sing-box，因此这里不需要
# 任何「按源 IP 分流」的规则（v0.1.57~v0.1.63 的 source_ip_cidr / carrier 已移除）。
# dnsmasq 的上游查询由 dert_base 的 dns_bypass 链打标绕过 sing-box（见 netgen.py）。
#
# 写文件用 tmp + rename，避免 sing-box 读到半个 JSON。
set -u

CONF=/etc/sing-box/config.json
DNSJSON=/etc/sing-box/00-dert-dns.json
[ -f "$CONF" ] || exit 0

# br-lan 的 v4 地址（dnsmasq 的监听地址，也是客户端 DNS 指向）
# 同时兼容多行（inet 在行首）与 ip -o 单行（inet 在第 3 列）两种输出——
# 只写 $1 == "inet" 的话，单行格式会静默回落到默认值，LAN 不是 192.168.10.x 时写错地址
LAN4=$(ip -4 addr show dev br-lan 2>/dev/null \
       | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }
              $3 == "inet" { split($4, a, "/"); print a[1]; exit }')
[ -n "$LAN4" ] || LAN4="192.168.10.1"

# br-lan 的全局 v6 前缀，统一成 x:x:x:x::/64
# 用 ipaddress 而不是 awk 拼 hextet：地址带 :: 压缩时（如 fd00:1234::1/64）
# awk 的 split 会分出错位的空字段，拼出 fd00:1234::1::/64 这种非法前缀
LAN6=$(ip -6 addr show dev br-lan scope global 2>/dev/null \
       | awk '$1 == "inet6" { print $2; exit } $3 == "inet6" { print $4; exit }' \
       | python3 -c '
import sys, ipaddress
s = sys.stdin.read().strip()
if s:
    try:
        net = ipaddress.ip_interface(s).network
        if net.prefixlen == 64:
            # 必须打印整个网络（含 /64）——只打印 network_address 会得到裸地址，
            # sing-box 的 source_ip_cidr 不接受不带前缀长度的 IPv6
            print(net)
    except Exception:
        pass
' 2>/dev/null)

# 运营商 DNS：用 dispatcher 已经算好的上游文件里的 v4 服务器，
# 保证「非白名单设备的解析结果」和「dnsmasq 的上游」是同一家，CDN 调度一致
CARRIER=""
if [ -f /run/dert-dns/upstream.conf ]; then
    CARRIER=$(sed -n 's/^server=\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$/\1/p' \
              /run/dert-dns/upstream.conf 2>/dev/null | head -1)
fi
[ -n "$CARRIER" ] || CARRIER="211.138.164.6"

python3 - "$DNSJSON" "$LAN4" "$LAN6" "$CARRIER" <<'PYEOF'
import json, os, sys

path, lan4, lan6, carrier = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

# 局域网网段：v4 取 /24（与 br-lan 的地址同网段），v6 用 PD 前缀
cidrs = [lan4.rsplit(".", 1)[0] + ".0/24"]
if lan6:
    cidrs.append(lan6)

cfg = {
    # 白名单专用 DNS 入口：nft 把白名单设备的 53 端口 DNAT 到这里。
    # 用独立端口而不是 tun DNS，是为了让「按 MAC 分流」在 nft 层完成，
    # sing-box 只负责把进来的 DNS 交给内部 DNS 模块（hijack-dns）。
    "inbounds": [
        {
            "type": "direct",
            "tag": "dns-in",
            # 必须监听双栈：nft 把白名单设备的 v6 DNS DNAT 到 [br-lan GUA]:5353，
            # 只绑 v4 地址的话 v6 查询会 connection refused（真机 2026-11-12 实测，
            # 白名单设备已发 437 个 v6 DNS 包全部落空）。
            "listen": "::",
            "listen_port": 5353,
            "network": "udp",
        }
    ],
    "route": {
        "rules": [
            # 不能带 protocol: "dns" —— direct inbound 不做 sniff，protocol 识别不出来，
            # 规则不匹配就会走默认 direct outbound，把查询转发回 5353 自己，
            # 形成无限循环（真机 2026-11-11 实测 CPU 飙到 130%）。
            # nft 已经保证只有 53 端口的 DNS 会进这个 inbound，只匹配 inbound 就够。
            {"inbound": "dns-in", "action": "hijack-dns"},
        ]
    },
    "dns": {
        "servers": [
            {"type": "udp", "server": lan4, "tag": "landns"},
        ],
        "rules": [
            # .lan 走 dnsmasq，保住本地主机名与 PTR
            {"domain_suffix": ["lan"], "server": "landns"},
        ],
    }
}

tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(cfg, f, ensure_ascii=False, indent=2)
    f.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PYEOF

# 文件由 sing-box 用户创建（ExecStartPre 以 User=sing-box 运行），属主本来就对；
# 这里只在以 root 手动执行时兜底修正，失败不影响功能
chown sing-box:sing-box "$DNSJSON" 2>/dev/null || true
exit 0
