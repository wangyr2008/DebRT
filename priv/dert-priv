# ---------------------------------------------------------------------------
# 升级（GitHub releases / 清单 URL）
# ---------------------------------------------------------------------------
fetch_body() { # fetch_body URL -> body
  local url="$1" prefix
  for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
    curl -fsSL --connect-timeout 8 --max-time 30 "${prefix}${url}" 2>/dev/null && return 0
  done
  return 1
}
github_latest_ver() { # github_latest_ver owner/repo
  local repo="$1" prefix out ver
  for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
    out="$(curl -sIL --connect-timeout 8 --max-time 30 -o /dev/null -w '%{url_effective}' "${prefix}https://github.com/${repo}/releases/latest" 2>/dev/null || true)"
    ver="$(printf '%s' "$out" | sed -n 's#.*/tag/v\{0,1\}\([0-9][0-9.]*\).*#\1#p')"
    [ -n "$ver" ] && { printf '%s' "$ver"; return 0; }
  done
  return 1
}
cur_version() { cat "$VERSION_FILE" 2>/dev/null || cat "${DERT_ROOT}/VERSION" 2>/dev/null || echo "0.0.0"; }
ver_ge() { python3 -c '
import re, sys
def parse(v):
    m = re.match(r"v?([0-9]+(?:\.[0-9]+)*)", v.strip())
    return [int(x) for x in m.group(1).split(".")] if m else [0]
a, b = parse(sys.argv[1]), parse(sys.argv[2])
n = max(len(a), len(b))
a += [0] * (n - len(a)); b += [0] * (n - len(b))
print("yes" if a >= b else "no")' "$1" "$2"; }

do_upgrade_check() {
  local src; src="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("upgrade",{}).get("source",""))' 2>/dev/null || echo "")"
  [ -n "$src" ] || die "UPG_NO_SOURCE" "尚未配置升级源" "请在「备份与升级」页填写 GitHub 仓库（如 yourname/dert）并保存"
  local cur latest
  cur="$(cur_version)"
  if [[ "$src" == *"://"* ]]; then
    local body
    body="$(fetch_body "$src")" || die "UPG_NET" "无法访问升级源清单" "请检查升级源 URL 与网络连通性；也可稍后重试"
    latest="$(printf '%s' "$body" | python3 -c 'import json,sys;d=json.load(sys.stdin);print(d.get("version") or d.get("tag_name") or "")' 2>/dev/null || echo "")"
    [ -n "$latest" ] || die "UPG_MANIFEST" "升级源清单格式不正确" "清单需为 JSON 且含 version 字段"
  else
    latest="$(github_latest_ver "$src")" || die "UPG_NET" "无法获取 GitHub 最新版本" "请检查仓库名（yourname/dert）与网络；GitHub 可能限流，可稍后重试"
  fi
  latest="${latest#v}"
  if [ "$(ver_ge "$latest" "$cur")" = "no" ] || [ "$latest" = "$cur" ]; then
    ok_out "up_to_date" "true" "current" "$cur" "latest" "$latest" "message" "已是最新版本 V${cur}"
  else
    ok_out "up_to_date" "false" "current" "$cur" "latest" "$latest" "message" "发现新版本"
  fi
}

do_upgrade_download() {
  local ver="${1:-}"
  [ -n "$ver" ] || die "USAGE" "缺少版本号"
  local src repo asset
  src="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("upgrade",{}).get("source",""))')"
  ver="${ver#v}"
  mkdir -p "${DERT_VAR}/staging"
  local out="${DERT_VAR}/staging/pkg.tar.gz"
  rm -f "$out" "${out}.sha256" "${out}.sig"
  local prefix base="https://github.com" rc=1
  if [[ "$src" == *"://"* ]]; then
    local body asset="" sha256=""
    body="$(fetch_body "$src")" || die "UPG_NET" "无法访问升级源"
    # 从清单 JSON 里取 url / sha256。
    # 以前的做法是让 python 打印 shlex.quote 后的赋值语句、再交给 shell 求值。
    # 那样虽然能防注入，但「执行动态生成的代码」本身就是坏味道——将来谁改了
    # 引号处理就变成命令执行。改成「python 输出两行、bash 用 read 读」：
    # 值原样传递（URL 与 sha256 不可能含换行，去掉 \r\n 是安全的），
    # 全程不经过 shell 求值，注入面为零。
    {
      IFS= read -r asset || true
      IFS= read -r sha256 || true
    } < <(printf '%s' "$body" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(d, dict):
    sys.exit(0)
def clean(v):
    if not isinstance(v, str):
        return ""
    return v.replace("\r", "").replace("\n", "")
sys.stdout.write(clean(d.get("url")) + "\n" + clean(d.get("sha256")) + "\n")
' 2>/dev/null)
    [ -n "$asset" ] || die "UPG_MANIFEST" "清单缺少 url 字段"
    # P3-26：清单里的 url 只接受 https://。curl 本身会照做 file:// 等协议，
    # 被篡改的清单可借此把任意本地文件当成"升级包"喂进后续解压/校验流程。
    case "$asset" in
      https://*) ;;
      *) die "UPG_MANIFEST" "升级源地址必须以 https:// 开头" \
               "清单里的 url 字段格式不正确（只允许 https）；当前值前 40 字符：${asset:0:40}" ;;
    esac
    # P3-26：限制单文件大小，防止恶意/错误源把磁盘写满（256MB 远大于实际包体）
    for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
      curl -fsSL --connect-timeout 10 --max-time 300 --max-filesize 268435456 \
        "${prefix}${asset}" -o "$out" 2>/dev/null && { rc=0; break; }
    done
    if [ "$rc" -eq 0 ]; then
      # sha256 强制校验（审计 B-13）：优先用清单内 sha256 字段，否则尝试 url+".sha256"
      if [ -n "$sha256" ]; then
        printf '%s  %s\n' "$sha256" "$(basename "$out")" > "${out}.sha256"
      else
        for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
          curl -fsSL --connect-timeout 10 --max-time 30 "${prefix}${asset}.sha256" -o "${out}.sha256" 2>/dev/null && [ -s "${out}.sha256" ] && break
        done
      fi
      [ -s "${out}.sha256" ] || { rm -f "$out"; die "UPG_MANIFEST" "清单式升级源未提供 sha256，拒绝安装" "请在清单 JSON 中加入 sha256 字段，或提供 <url>.sha256 文件"; }
      # 签名（可选，v0.1.74）：有就取，交给 upgrade-apply 验签。
      # 取不到不算失败——是否强制由 upgrade.require_signature 决定（见 apply）。
      for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
        curl -fsSL --connect-timeout 10 --max-time 30 "${prefix}${asset}.sig" -o "${out}.sig" 2>/dev/null \
          && [ -s "${out}.sig" ] && break
      done
    fi
  else
    repo="$src"
    for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
      curl -fsSL --connect-timeout 10 --max-time 300 --max-filesize 268435456 \
        "${prefix}${base}/${repo}/releases/download/v${ver}/dert-${ver}.tar.gz" -o "$out" 2>/dev/null && { rc=0; break; }
    done
    if [ "$rc" -eq 0 ]; then
      for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
        curl -fsSL --connect-timeout 10 --max-time 30 "${prefix}${base}/${repo}/releases/download/v${ver}/dert-${ver}.tar.gz.sha256" -o "${out}.sha256" 2>/dev/null && break
      done
      for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
        curl -fsSL --connect-timeout 10 --max-time 30 "${prefix}${base}/${repo}/releases/download/v${ver}/dert-${ver}.tar.gz.sig" -o "${out}.sig" 2>/dev/null \
          && [ -s "${out}.sig" ] && break
      done
    fi
  fi
  [ "$rc" -eq 0 ] && [ -s "$out" ] || die "UPG_NET" "下载升级包失败" "请检查升级源与网络；也可在页面手动上传升级包"
  # P2-4：此前 .sha256 下载失败会静默跳过校验——升级源支持第三方镜像，代理正是篡改风险点
  [ -s "${out}.sha256" ] || { rm -f "$out"; die "UPG_SHA" "升级源未提供 sha256 校验文件" "为防篡改，缺少 .sha256 时不安装；请确认发布页包含 dert-<版本>.tar.gz.sha256"; }
  # .sha256 内容记录的是原始资产名（dert-x.y.z.tar.gz），不能直接 -c；
  # 提取期望哈希与实际文件比对（存在性已由上方强制，无需再包一层 if）
  local want got
  want="$(awk 'NR==1{print $1}' "${out}.sha256" 2>/dev/null)"
  got="$(sha256sum "$out" 2>/dev/null | awk '{print $1}')"
  [ -n "$want" ] && [ "$want" = "$got" ] || \
    die "UPG_SHA" "升级包校验失败（sha256 不匹配）" "下载可能被篡改或损坏，请重试；连续失败请检查升级源"
  ok_out "path" "$out"
}

do_upgrade_apply() {
  require_root
  acquire_lock
  local pkg="${1:?缺少升级包路径}"
  [ -f "$pkg" ] || die "NO_FILE" "升级包不存在"

  # 0) 签名校验（v0.1.74）——先验来源真实性，再谈包结构。
  #    包和 .sha256 走同一通道（含 gh-proxy 第三方镜像回退），sha256 只能证明
  #    "没被改坏"，不能证明"是谁发的"：镜像被劫持时可以同时替换包和哈希。
  #    公钥随包安装，私钥不进 CI（本机保管，手动/发布流程签名）。
  local pub="${DERT_ROOT}/dert-signing.pub.pem" sig_state="未签名"
  if [ -s "${pkg}.sig" ]; then
    [ -f "$pub" ] || die "UPG_SIG" "升级包带签名，但本机缺少验签公钥" \
      "请确认 ${pub} 存在；可从仓库 signing/dert-signing.pub.pem 复制"
    if ! openssl pkeyutl -verify -pubin -inkey "$pub" -rawin \
           -in "$pkg" -sigfile "${pkg}.sig" >/dev/null 2>&1; then
      logger -t dert-upgrade "签名校验失败，拒绝安装：$pkg"
      die "UPG_SIG" "升级包签名校验失败" \
        "包可能被篡改，或不是用 DebRT 官方密钥签发的；已拒绝安装（未做任何改动）"
    fi
    sig_state="已验签"
    logger -t dert-upgrade "签名校验通过：$pkg"
  else
    # 没带签名：默认只警告（存量发布尚无签名，一刀切会锁死升级通道），
    # 配了 upgrade.require_signature=true 则拒绝。这是"只验不拦 → 强制"的过渡开关。
    local need_sig
    need_sig="$(python3 -c '
import json, os
try:
    c = json.load(open(os.environ.get("DERT_ETC", "/etc/dert") + "/config.json"))
    print("true" if (c.get("upgrade") or {}).get("require_signature") else "false")
except Exception:
    print("false")
' 2>/dev/null)"
    if [ "$need_sig" = "true" ]; then
      die "UPG_SIG" "升级源未提供签名，已拒绝" \
        "当前配置要求必须验签（upgrade.require_signature=true）；请使用带 .sig 的官方发布"
    fi
    logger -t dert-upgrade "升级包未带签名，仅做 sha256 校验（可通过 upgrade.require_signature 强制要求）：$pkg"
  fi
  # 1) 包结构校验 + 成员白名单（审计 B-12）：以 root 解压前必须防路径穿越。
  #    v0.1.76 起抽到 priv/tarcheck.py —— 这段逻辑此前只有源码字符串断言，
  #    而它是"以 root 解压之前"的最后一道防线，字符串断言证明不了真拦得住。
  #    抽出来后可以用真实恶意成员名做行为测试（tests/test_tarcheck.py）。
  # 先把成员清单取到变量里，再喂给校验器。
  # 不能写成 `tar -tzf "$pkg" 2>&1 | tarcheck.py`：tar 对含 `..` 的成员会往
  # stderr 打 "Removing leading ..."，合并进管道后那行会被当成成员名，
  # 于是拒绝原因变成 tar 的警告原文（真机 2026-11-12 实测踩到）。
  # 反过来，正常包若触发任何 tar 警告也会被误判为危险条目——两个方向都错。
  local tc_list tc_out
  tc_list="$(tar -tzf "$pkg" 2>/dev/null)" \
    || die "UPG_BAD" "升级包无法读取（损坏或不是 tar.gz）" "请重新下载或重新上传升级包"
  if ! tc_out="$(printf '%s\n' "$tc_list" | python3 "${PRIV_DIR}/tarcheck.py" 2>&1)"; then
    # 带上具体是哪个条目，比"包含不认识的条目"可诊断得多
    local tc_reason=""
    case "$tc_out" in
      *'"reason"'*) tc_reason="$(printf '%s' "$tc_out" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("reason", ""))
except Exception:
    pass
' 2>/dev/null)" ;;
    esac
    die "UPG_BAD" "升级包含不认识的条目" "请确认上传的是 DebRT 官方发布的 .tar.gz 升级包${tc_reason:+。具体：$tc_reason}"
  fi
  tar -tvzf "$pkg" 2>/dev/null | awk '{print substr($1,1,1)}' | grep -qE '^[lh]' \
    && die "UPG_BAD" "升级包含链接条目，已拒绝" "为防路径穿越，升级包只允许普通文件与目录"
  tar -tzf "$pkg" 2>/dev/null | grep -qE '^VERSION$' || die "UPG_BAD" "升级包缺少 VERSION 文件" "请确认上传的是 DebRT 官方发布的 .tar.gz 升级包"
  tar -tzf "$pkg" 2>/dev/null | grep -qE '^panel/' || die "UPG_BAD" "升级包缺少 panel/ 目录" "请确认上传的是 DebRT 官方发布的 .tar.gz 升级包"
  tar -tzf "$pkg" 2>/dev/null | grep -qE '^priv/' || die "UPG_BAD" "升级包缺少 priv/ 目录" "请确认上传的是 DebRT 官方发布的 .tar.gz 升级包"
  # 2) 版本校验（允许同版本重装，拒绝降级）
  local newver cur
  newver="$(tar -xOzf "$pkg" VERSION 2>/dev/null | tr -d '[:space:]')"
  [ -n "$newver" ] || die "UPG_BAD" "升级包缺少 VERSION 文件"
  cur="$(cur_version)"
  [ "$(ver_ge "$newver" "$cur")" = "yes" ] || die "UPG_DOWNGRADE" "不能从 V${cur} 降级到 V${newver}" "如需回退旧版本，请先恢复出厂前的备份并手动放置旧版包"
  # 3) 解压到暂存区 + 自检
  # 暂存区必须在被替换目录之外：放里面会随 mv 一起改名，第二步 mv 必 ENOENT（五审 P-03）
  local stg="/usr/local/lib/.dert.upgrade.$$"
  rm -rf "$stg"; mkdir -p "$stg"
  tar -C "$stg" --no-same-owner --no-overwrite-dir -xzf "$pkg" 2>/dev/null || { rm -rf "$stg"; die "UPG_BAD" "升级包解压失败（文件损坏）"; }
  find "$stg" -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true
  find "$stg" -name '*.pyc' -delete 2>/dev/null || true
  # 自检按文件类型分流：.py 走 py_compile，其余走 bash -n（审计 B-01：不能对 Python 跑 bash -n）
  local f
  for f in "$stg"/priv/*; do
    [ -f "$f" ] || continue
    case "$f" in
      *.py) python3 -m py_compile "$f" >/dev/null 2>&1 || { rm -rf "$stg"; die "UPG_BAD" "升级包内 Python 脚本异常：$(basename "$f")"; } ;;
      *)    bash -n "$f" 2>/dev/null || { rm -rf "$stg"; die "UPG_BAD" "升级包内脚本语法异常：$(basename "$f")"; } ;;
    esac
  done
  python3 -m py_compile "$stg"/panel/*.py >/dev/null 2>&1 || { rm -rf "$stg"; die "UPG_BAD" "升级包内面板程序异常（py_compile 失败）"; }
  for need in panel/static/index.html panel/static/app.js panel/static/app.css panel/static/icons.js panel/static/favicon.ico; do
    [ -f "$stg/$need" ] || { rm -rf "$stg"; die "UPG_BAD" "升级包缺少 $need"; }
  done
  # 4) 备份当前版本 → 原子换目录 → 修正属主
  # L3：同版本重装时目标已存在，cp -a 会嵌套成 app-<ver>/dert/，手工回退路径失效
  rm -rf "${DERT_VAR}/lastgood/app-$(cur_version)"
  cp -a "/usr/local/lib/dert" "${DERT_VAR}/lastgood/app-$(cur_version)" 2>/dev/null || true
  local old="/usr/local/lib/dert.prev.$$"
  mv "/usr/local/lib/dert" "$old" && mv "$stg" "/usr/local/lib/dert" || { mv "$old" "/usr/local/lib/dert" 2>/dev/null; rm -rf "$stg"; die "UPG_SWAP" "升级替换失败，已保留原版本"; }
  # 布局对齐（CI 冒烟揭出）：install.sh 是扁平布局（dert-priv/lib.sh/*.py 在根），
  # 而升级包保持 priv/ 子目录 —— 换目录后必须把 priv/* 拷回根并重整权限，
  # 否则 sudo 调用的 /usr/local/lib/dert/dert-priv 直接消失
  cp -f /usr/local/lib/dert/priv/* /usr/local/lib/dert/ 2>/dev/null || true
  local exef
  # 机制级：直接遍历根目录，有 shebang 的一律 755——与包结构（扁平/子目录）无关，
  # 也不依赖白名单（复审 v0.1.16 4.2）
  for exef in /usr/local/lib/dert/*; do
    [ -f "$exef" ] && head -c 2 "$exef" | grep -q '#!' && chmod 755 "$exef"
  done
  for exef in /usr/local/lib/dert/wait-wan /usr/local/lib/dert/wait-dns-upstream \
              /usr/local/lib/dert/singbox-cleanup /usr/local/lib/dert/qdisc-apply; do
    [ -f "$exef" ] && chmod 755 "$exef"
  done
  # sb.sh 管理器随升级保持最新（与 install.sh 同路径）：旧 sb 无更新状态记录，
  # 面板"上次更新"会一直空（2026-11-04 真机反馈）
  if [ -f "/usr/local/lib/dert/singbox/sb.sh" ]; then
    install -m 755 "/usr/local/lib/dert/singbox/sb.sh" /usr/local/bin/sb 2>/dev/null || true
  fi
  # A-04：同步 /etc 侧钩子——此前只有 install.sh 会写它们，升级用户永远停在旧钩子，
  # 而面板版本号已是最新（排查极误导）。A-09 改的 70-dert-dns 正是经此通道到达升级用户
  if [ -d /usr/local/lib/dert/network ]; then
    install -m 755 /usr/local/lib/dert/network/dispatcher/70-dert-dns /etc/networkd-dispatcher/routable.d/ 2>/dev/null || true
    install -m 755 /usr/local/lib/dert/network/dispatcher/80-dert-cake /etc/networkd-dispatcher/routable.d/ 2>/dev/null || true
    # v0.1.56 新增：WAN 换 IPv6 前缀后修 sing-box 本地地址集合 + 清旧前缀路由
    # （A-04/R-01/P3-02 同族第四处——升级通道漏装钩子时面板版本号已是最新，极误导）
    install -m 755 /usr/local/lib/dert/network/dispatcher/90-dert-lan-prefix /etc/networkd-dispatcher/routable.d/ 2>/dev/null || true
    install -m 755 /usr/local/lib/dert/network/dispatcher/70-dert-dns /etc/networkd-dispatcher/no-carrier.d/ 2>/dev/null || true
    # R-01：v0.1.43 新增的 PPPoE 热插拔钩子——install.sh/uninstall.sh 都带了它，
    # 升级通道曾漏掉，导致"插网线自愈"只对全新安装生效
    install -d -m 755 /etc/networkd-dispatcher/carrier.d 2>/dev/null || true
    install -m 755 /usr/local/lib/dert/network/dispatcher/75-dert-pppoe-hotplug /etc/networkd-dispatcher/carrier.d/ 2>/dev/null || true
    install -m 755 /usr/local/lib/dert/network/dispatcher/75-dert-pppoe-hotplug /etc/networkd-dispatcher/routable.d/ 2>/dev/null || true
    install -m 755 /usr/local/lib/dert/network/ppp/ip-up.d/dert /etc/ppp/ip-up.d/ 2>/dev/null || true
    install -m 755 /usr/local/lib/dert/network/ppp/ip-down.d/dert /etc/ppp/ip-down.d/ 2>/dev/null || true
    install -m 644 /usr/local/lib/dert/network/sysctl/70-dert.conf /etc/sysctl.d/ 2>/dev/null || true
    install -m 644 /usr/local/lib/dert/network/modules/dert.conf /etc/modules-load.d/ 2>/dev/null || true
    install -m 644 /usr/local/lib/dert/network/logrotate/dert /etc/logrotate.d/ 2>/dev/null || true
    # P3-02：PPPoE 拨号单元在 network/systemd/ 下，不在 systemd/ 的 glob 里——
    # 升级通道此前永远不同步它（install.sh 只管全新安装；与 A-04/R-01 同族第三处）
    install -m 644 /usr/local/lib/dert/network/systemd/dert-pppoe.service /etc/systemd/system/ 2>/dev/null || true
    # v0.1.57：DNS 分流 drop-in（启动前生成 00-dert-dns.json、启动后派生 nft 表、
    # 停止时删表回落 dnsmasq）。与 A-04/R-01/P3-02/P3-18 同族——升级通道漏装时
    # 面板版本号已是最新，排查极误导，所以这里用覆盖写而不是"不存在才创建"
    if systemctl list-unit-files sing-box.service >/dev/null 2>&1; then
      install -d -m 755 /etc/systemd/system/sing-box.service.d 2>/dev/null || true
      cat > /etc/systemd/system/sing-box.service.d/20-dert-dns-split.conf <<'DPEOF'
# 由 DebRT 安装/收敛自动维护：DNS 按 MAC 分流（见 COEXISTENCE.md §DNS 分流）
# 启动前生成 00-dert-dns.json；启动后派生 nft 表；停止时删表回落 dnsmasq
[Service]
ExecStartPre=/usr/local/lib/dert/dns-split-prepare
ExecStartPost=+/usr/local/lib/dert/dns-split-sync
ExecStopPost=+/usr/local/lib/dert/dns-split-teardown
DPEOF
      systemctl daemon-reload 2>/dev/null || true
    fi
    if [ -f /usr/local/lib/dert/sudoers/dert ]; then
      install -m 440 /usr/local/lib/dert/sudoers/dert /etc/sudoers.d/dert.upgrade-tmp 2>/dev/null || true
      if visudo -c -f /etc/sudoers.d/dert.upgrade-tmp >/dev/null 2>&1; then
        mv -f /etc/sudoers.d/dert.upgrade-tmp /etc/sudoers.d/dert
      else
        rm -f /etc/sudoers.d/dert.upgrade-tmp
      fi
    fi
    sysctl --system >/dev/null 2>&1 || true
  fi
  # PPPoE 看门狗：pppd 对"接口被外部删除"不敏感，服务 active 但 ppp0 消失时不自愈
  # （2026-11-05 真机实录）。脚本随包进 LIB_DIR，unit 需单独落 /etc 并启用。
  if [ -f /usr/local/lib/dert/systemd/dert-pppoe-watchdog.timer ]; then
    install -m 644 /usr/local/lib/dert/systemd/dert-pppoe-watchdog.service /etc/systemd/system/ 2>/dev/null || true
    install -m 644 /usr/local/lib/dert/systemd/dert-pppoe-watchdog.timer /etc/systemd/system/ 2>/dev/null || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now dert-pppoe-watchdog.timer >/dev/null 2>&1 || true
    # 周期改过（1min → 15min）必须重启才生效：enable --now 对已在运行的 timer
    # 是空操作，不重启的话新周期要等到下次开机才应用
    systemctl restart dert-pppoe-watchdog.timer >/dev/null 2>&1 || true
  fi
  # 网络事件分发（v0.1.67）：订阅 rtnetlink，替代 ip-up 里延迟调钩子的做法。
  # 与 A-04/R-01/P3-02/P3-18 同族——升级通道漏装时面板版本号已是最新，排查极误导，
  # 所以这里用覆盖写 + enable --now，不判断"是否已存在"。
  if [ -f /usr/local/lib/dert/systemd/dert-netwatch.service ]; then
    install -m 644 /usr/local/lib/dert/systemd/dert-netwatch.service /etc/systemd/system/ 2>/dev/null || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable dert-netwatch.service >/dev/null 2>&1 || true
    systemctl restart dert-netwatch.service >/dev/null 2>&1 || true
  fi
  for pyf in /usr/local/lib/dert/*.py /usr/local/lib/dert/lib.sh; do
    [ -f "$pyf" ] && chmod 644 "$pyf"
  done
  find /usr/local/lib/dert -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true
  rm -rf /usr/local/lib/dert/priv    # 扁平化后 priv/ 子目录是冗余副本，删掉避免"哪份生效"的歧义
  chown -R root:root /usr/local/lib/dert
  # 单元同步（复审 v0.1.12 2.2）：升级包的新 systemd 能力落到 /etc/systemd，
  # 否则只有全新安装才生效、升级用户拿不到 dns-sync/cleanup/重启策略
  if [ -d /usr/local/lib/dert/systemd ]; then
    mkdir -p /etc/systemd/system/dnsmasq.service.d /etc/systemd/system/sing-box.service.d
    local uf
    for uf in /usr/local/lib/dert/systemd/*.service \
              /usr/local/lib/dert/systemd/*.timer; do
      [ -f "$uf" ] && install -m 644 "$uf" /etc/systemd/system/
    done
    for uf in /usr/local/lib/dert/systemd/dnsmasq.service.d/* \
              /usr/local/lib/dert/systemd/sing-box.service.d/*; do
      [ -f "$uf" ] && install -m 644 "$uf" "/etc/systemd/system/$(echo "$uf" | sed 's|.*systemd/||')"
    done
    systemctl enable dert-panel.service dert-dns-sync.service dert-converge.timer >/dev/null 2>&1 || true
  fi
  systemctl daemon-reload
  rm -rf "$old"
  # VERSION 同时落包根与 share/（审计 B-02：目录整体替换后 share/ 会消失，必须重建再拷贝）
  mkdir -p "$DERT_SHARE"
  cp /usr/local/lib/dert/VERSION "$DERT_SHARE/VERSION" 2>/dev/null || true
  # 升级后自检并落日志（七审建议：升级目前只验证面板能起）
  /usr/local/lib/dert/dert-priv selftest >> /var/log/dert-upgrade-selftest.log 2>&1 || \
    logger -t dert-upgrade "selftest 有失败项，详见 /var/log/dert-upgrade-selftest.log"
  # 升级后立即收敛一次：/etc/systemd/network/*.network 是生成物，升级换了 netgen
  # 却要等最长 6h 的收敛 timer 才重新生成——期间旧键/旧语法还在跑（真机实录：
  # v0.1.44 升级后用户机器仍跑旧键配置，IPv6 因此"升级了也没修好"）
  # P3-01：本进程持有 apply.lock（fd9），子进程 acquire_lock 会重开 fd9 再 flock -n
  # 必然 BUSY——此前的内联收敛 100% 失败（死代码+误导日志），实际全靠下方 3s 后的
  # converge.service 重启兜底。传 _DERT_LOCK_HELD=1 让子进程复用父进程持有的锁，
  # 收敛真正内联执行（锁由父进程持有到退出，窗口内无并发风险）。
  # CI 冒烟网关（install.sh --smoke 写 /run/dert/smoke-mode）：收敛会重启
  # networkd/dnsmasq/nft——runner 的网络不能动（CI 实测：步骤全绿但 agent 收尾
  # 信号传不回，job 被超时标 cancelled，run#101）；跳过内联收敛与延迟收敛重启。
  local _smoke=0; [ -f ${DERT_RUN}/smoke-mode ] && _smoke=1
  if [ "$_smoke" != "1" ]; then
    _DERT_LOCK_HELD=1 /usr/local/lib/dert/dert-priv apply-all --convergent >> /var/log/dert-upgrade-selftest.log 2>&1 || \
      logger -t dert-upgrade "升级后收敛有报错，详见 /var/log/dert-upgrade-selftest.log"
  fi

  # 5) 延迟重启面板（先让本次响应送达客户端）；一并重启收敛单元以加载新逻辑
  #（冒烟模式只重启面板，不碰收敛——见上）
  systemctl daemon-reload
  if [ "$_smoke" = "1" ]; then
    systemd-run --on-active=3 --quiet systemctl restart "$PANEL_UNIT" 2>/dev/null \
      || setsid bash -c "sleep 3; systemctl restart $PANEL_UNIT" >/dev/null 2>&1 &
  else
    systemd-run --on-active=3 --quiet systemctl restart "$PANEL_UNIT" dert-converge.service 2>/dev/null \
      || setsid bash -c "sleep 3; systemctl restart $PANEL_UNIT dert-converge.service" >/dev/null 2>&1 &
  fi
  ok_out "message" "已升级到 V${newver}，面板即将重启"
}

# ---------------------------------------------------------------------------
# 状态（/api/status 的特权部分）
# ---------------------------------------------------------------------------
do_status() {
  # v0.1.80：实现搬到 priv/status.py（纯 Python，可行为测试）
  exec python3 "${PRIV_DIR}/status.py"
}

# ---------------------------------------------------------------------------
# 自检（安装后验证，不改系统）
# ---------------------------------------------------------------------------
do_selftest() {
  # v0.1.80：实现搬到 priv/selftest.py（纯 Python，可行为测试）
  exec python3 "${PRIV_DIR}/selftest.py"
}

# ---------------------------------------------------------------------------
# 分发
# ---------------------------------------------------------------------------
case "$CMD" in
  auth-verify)     do_auth_verify ;;
  session-secret)  do_session_secret ;;
  config-get)      do_config_get ;;
  config-set)      do_config_set "$@" ;;
  apply-all)       do_apply_all "$@" ;;
  service-ctl)     do_service_ctl "$@" ;;
  podman-ops)      do_podman_ops "$@" ;;
  singbox-ops)     do_singbox_ops "$@" ;;
  passwd-set)      do_passwd_set ;;
  backup-create)   do_backup_create "$@" ;;
  backup-restore)  do_backup_restore "$@" ;;
  factory-reset)   do_factory_reset ;;
  upgrade-check)   do_upgrade_check ;;
  upgrade-download) do_upgrade_download "$@" ;;
  upgrade-apply)   do_upgrade_apply "$@" ;;
  status)          do_status ;;
  selftest)        do_selftest ;;
  # v0.1.81（P4）：结构化健康检查，退出码 0/1，供监控直接消费
  health)          exec python3 "${PRIV_DIR}/health.py" "$@" ;;
  *)               die "USAGE" "未知子命令：${CMD:-（空）}" "合法子命令见安装文档" ;;
esac
