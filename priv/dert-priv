#!/usr/bin/env bash
# ============================================================================
# DebRT 特权入口 —— 面板经 sudo 白名单唯一直达的 root 脚本。
#
# 安全设计：
#   * 子命令白名单分发，绝不 eval 用户输入；
#   * 敏感数据（密码）只经 stdin 传递，不出现在参数/日志/回显；
#   * 所有配置变更：校验 → lastgood 快照 → 原子写 → 语法预检 → 应用 → 验证 →
#     失败自动回滚，并以可操作的 JSON 错误返回；
#   * 与 sing-box / podman 的共存契约见 COEXISTENCE.md（tailscale 自 0.1.32 起
#     以 sing-box endpoint 托管，本层不再管理 tailscaled）：
#     本脚本只操作自己的 nft 表 inet dert_base，永不 flush ruleset，
#     永不 restart sing-box。
# ============================================================================
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
PRIV_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=lib.sh
source "${PRIV_DIR}/lib.sh"

CMD="${1:-}"; [ $# -gt 0 ] && shift

# 管理密码哈希记录解析：兼容 "pbkdf2$iters$salt$hash"（旧4段）与
# "pbkdf2$sha256$iters$salt$hash"（新5段，算法显式）。历史缺陷：4 段格式的
# 首段"pbkdf2"曾被当成摘要算法名传给 pbkdf2_hmac → 必抛异常 → 永远登录失败（五审 P-02）。
# 密码记录解析/校验见 priv/pwhash.py（Python 模块，auth-verify / passwd-set / install.sh 共用；
# 此前曾误写成 Bash 函数并在 Python heredoc 里调用 → NameError → 登录必失败，六审 P-02）

# ---------------------------------------------------------------------------
# 认证
# ---------------------------------------------------------------------------
do_auth_verify() {
  local pw lock_state out
  pw="$(head -c 4096)"   # stdin 只读一次
  [ -n "$pw" ] || die "AUTH_EMPTY" "请输入管理密码"
  # 暴力破解兜底限速：按来源 IP 的限速在面板层做；本层是全局兜底（20 次失败锁 300 秒），
  # 阈值放宽以免全局单计数器被用来把管理员锁在门外（审计 B-18）。
  lock_state='{"fails":0,"lock_until":0}'
  [ -f "${DERT_VAR}/auth-state.json" ] && lock_state="$(cat "${DERT_VAR}/auth-state.json" 2>/dev/null || echo "$lock_state")"
  # 密码经环境变量传入（/proc/<pid>/environ 为 0400 root，ps 不可见），不走 argv（审计 B-15）
  out="$(DERT_SECRET="$pw" python3 - "$lock_state" <<'PYEOF'
import json, os, sys, time
sys.path.insert(0, "/usr/local/lib/dert")
import pwhash
try:
    state = json.loads(sys.argv[1])
except Exception:
    state = {"fails": 0, "lock_until": 0}  # P3-1：状态损坏兜底——限速计数可丢，登录不能丢
pw = os.environ.get("DERT_SECRET", "")
now = int(time.time())
if state.get("lock_until", 0) > now:
    print(json.dumps({"ok": False, "code": "AUTH_LOCKED",
                      "message": f"尝试次数过多，请 {state['lock_until'] - now + 1} 秒后重试",
                      "hint": "密码不会因此失效；稍等即可再次尝试"}))
    sys.exit(0)
elif state.get("lock_until", 0):
    state["fails"] = 0        # P2-5：锁已过期即归零——否则 fails 跨天累积，演变成"错一次立刻锁 5 分钟"
    state["lock_until"] = 0   # 过期时间戳一并清零（复审顺手项）
try:
    rec = json.load(open("/etc/dert/secrets.json"))["admin_pbkdf2"]
    ok = pwhash.verify(pw, rec)
except ValueError:
    # 记录格式坏：与"密码不正确"区分开，CI/排查一眼定位（六审建议）
    print(json.dumps({"ok": False, "code": "AUTH_RECORD_BAD",
                      "message": "密码记录无法解析（secrets.json 可能损坏或来自旧版本）",
                      "hint": "在系统上执行：rm /etc/dert/secrets.json && sudo bash install.sh 重新生成密码"}))
    sys.exit(1)
except Exception:
    ok = False
if ok:
    state = {"fails": 0, "lock_until": 0}
    # 成功也必须输出 JSON：bash 包装层靠 stdout 判定，空输出会被当作失败（六审复现 A 揭出）
    print(json.dumps({"ok": True}))
else:
    state["fails"] = int(state.get("fails", 0)) + 1
    if state["fails"] >= 20:
        state["lock_until"] = now + 300
        print(json.dumps({"ok": False, "code": "AUTH_LOCKED",
                          "message": "连续多次密码错误，已临时锁定 5 分钟",
                          "hint": "若忘记密码：长按机身 Reset 键 8 秒恢复出厂，或在控制台执行 dert-priv factory-reset"}))
    else:
        print(json.dumps({"ok": False, "code": "AUTH_BAD",
                          "message": "管理密码不正确", "hint": "请检查密码后重试"}))
# P3-1：全项目 /etc 写入都是 tmp+os.replace，唯独这里曾直写——断电写一半会
# 打碎 auth-state.json，下次 json.loads 抛异常 → 无输出 → 登录不可用（须 root 手删）
state_path = "/var/lib/dert/auth-state.json"
with open(state_path + ".tmp", "w") as f:
    json.dump(state, f)
os.replace(state_path + ".tmp", state_path)
sys.exit(0 if ok else 1)
PYEOF
)"
  printf '%s\n' "$out"
  case "$out" in *'"ok": true'*) exit 0 ;; *) exit 1 ;; esac
}

do_session_secret() {
  python3 - <<'PYEOF'
import json
try:
    s = json.load(open("/etc/dert/secrets.json")).get("session_secret", "")
    print(json.dumps({"ok": True, "secret": s}))
except Exception:
    print(json.dumps({"ok": False, "code": "NO_SECRET", "message": "secrets.json 缺失或损坏", "hint": "请重新运行 install.sh"}))
PYEOF
}

# ---------------------------------------------------------------------------
# 配置读取（不含任何明文密码）
# ---------------------------------------------------------------------------
do_config_get() {
  python3 - <<'PYEOF'
import json
cfg = json.load(open("/etc/dert/config.json"))
try:
    has_pw = bool(json.load(open("/etc/dert/secrets.json")).get("pppoe_password"))
except Exception:
    has_pw = False
cfg.setdefault("wan", {})["has_password"] = has_pw
cfg.pop("notes", None)
print(json.dumps({"ok": True, "config": cfg}, ensure_ascii=False))
PYEOF
}

# ---------------------------------------------------------------------------
# 配置写入 + 应用（核心流水线）
# ---------------------------------------------------------------------------
do_config_set() {
  local section="${1:-}"
  [ -n "$section" ] || die "USAGE" "缺少配置段名称"
  require_root
  acquire_lock

  local in_json norm tag stage man_json pre_wan acts failed
  in_json="$(mktemp /run/dert/in.XXXXXX)"
  cat > "$in_json"

  # 1) 校验与规范化（失败时 validate.py 直接输出可操作的 JSON 错误）
  if ! norm="$(python3 "${PRIV_DIR}/validate.py" "$section" < "$in_json")"; then
    printf '%s\n' "$norm"; rm -f "$in_json"; exit 1
  fi

  # 1.5) 仅保存升级源：不涉及网络应用（norm 写临时文件再传，与主路径一致——
  # 此前把 norm JSON 字符串当文件路径 open()，保存静默失败，真机实测）
  if [ "$section" = "upgrade" ]; then
    local norm_file
    norm_file="$(mktemp /run/dert/norm.XXXXXX)"
    chmod 600 "$norm_file"
    printf '%s' "$norm" > "$norm_file"
    if ! python3 - "$in_json" "$norm_file" <<'PYEOF'
import json, sys, os
in_file, norm_file = sys.argv[1], sys.argv[2]
norm = json.load(open(norm_file))["data"]
cfg = json.load(open("/etc/dert/config.json"))
cfg["upgrade"] = norm
tmp = "/etc/dert/.config.tmp"
json.dump(cfg, open(tmp, "w"), ensure_ascii=False, indent=1)
os.chmod(tmp, 0o644)
os.replace(tmp, "/etc/dert/config.json")
PYEOF
    then
      rm -f "$in_json" "$norm_file"
      die "MERGE" "升级源保存失败" "请重试；若持续出现请截图反馈"
    fi
    rm -f "$in_json" "$norm_file"
    ok_out "message" "升级源已保存"
    exit 0
  fi

  # 2) 快照 + 合并（密码只进 secrets；规范化结果写临时文件再传入，不进 argv —— 审计 B-15，
  #    同时修复审计遗漏的缺陷：norm 此前被当文件路径 open()，真实模式 config-set 必失败）
  local old_mode
  old_mode="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("mode",""))' 2>/dev/null || echo "")"
  local old_user
  old_user="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("username","") or "")' 2>/dev/null || echo "")"
  tag="s$(date +%s%N | tail -c 9)"
  snapshot_lastgood "$tag"
  local new_cfg new_sec norm_file
  new_cfg="$(mktemp /run/dert/cfg.XXXXXX)"
  new_sec="$(mktemp /run/dert/sec.XXXXXX)"
  norm_file="$(mktemp /run/dert/norm.XXXXXX)"
  chmod 600 "$new_sec" "$norm_file"
  printf '%s' "$norm" > "$norm_file"
  if ! python3 - "$section" "$in_json" "$norm_file" "$new_cfg" "$new_sec" <<'PYEOF'
import json, sys
section, in_file, norm_file, out_cfg, out_sec = sys.argv[1:6]
cfg = json.load(open("/etc/dert/config.json"))
sec_in = json.load(open(in_file))
norm = json.load(open(norm_file))["data"]
try:
    secrets = json.load(open("/etc/dert/secrets.json"))
except Exception:
    secrets = {}
if section == "bind":
    cfg["ports"] = norm
elif section == "wan":
    pwd = norm.pop("password", None)
    for k in ("mode", "username", "dns_mode", "dns", "ip", "mask", "gw"):
        cfg.setdefault("wan", {})[k] = norm[k]
    if pwd:
        secrets["pppoe_password"] = pwd
        cfg["wan"]["has_password"] = True
elif section == "ipv6":
    cfg["ipv6"] = norm
elif section == "lan":
    cfg["lan"] = norm
elif section == "dhcp":
    cfg["dhcp"] = norm
elif section == "static":
    cfg["static"] = norm
elif section == "qos":
    cfg["qos"] = norm
elif section == "firewall":
    if "wan_input_drop" in sec_in:
        cfg.setdefault("firewall", {})["wan_input_drop"] = norm["wan_input_drop"]
    if "portfw" in sec_in:
        cfg["firewall"]["portfw"] = norm["portfw"]
elif section == "upgrade":
    cfg["upgrade"] = norm
else:
    sys.exit(9)
json.dump(cfg, open(out_cfg, "w"), ensure_ascii=False, indent=1)
if secrets:
    json.dump(secrets, open(out_sec, "w"), ensure_ascii=False, indent=1)
PYEOF
  then
    restore_lastgood "$tag"; rm -f "$in_json" "$new_cfg" "$new_sec" "$norm_file"
    die "MERGE" "配置合并失败" "本次修改未生效；请刷新页面重试"
  fi

  # 3) 先采样 + 落盘：netgen 读固定路径 /etc/dert/config.json，必须让它在
  #    生成前看到"新配置"，否则每次保存生效的都是上一版（复审 v0.1.2 P-01）
  #    pre_wan 语义仍是"改动前 WAN 是否可用"（审计 B-03），在写盘前采样
  pre_wan="$(wan_route_ok)"
  write_atomic "$CONFIG_JSON" 644 < "$new_cfg"
  [ -s "$new_sec" ] && write_atomic "$SECRETS_JSON" 600 < "$new_sec"

  # 4) 用新配置生成 + 预检。此时原生文件尚未部署，失败回滚后系统与旧配置完全一致（安全）
  stage="$(mktemp -d /run/dert/stage.XXXXXX)"
  man_json="$stage/manifest.json"
  if ! python3 "${PRIV_DIR}/netgen.py" --stage "$stage" > "$man_json"; then
    cat "$man_json"
    restore_lastgood "$tag"; rm -rf "$stage" "$in_json" "$new_cfg" "$new_sec" "$norm_file"
    exit 1
  fi
  if ! pf_out="$(preflight_stage "$stage")"; then
    printf '%s\n' "$pf_out"
    restore_lastgood "$tag"; rm -rf "$stage" "$in_json" "$new_cfg" "$new_sec" "$norm_file"
    exit 1
  fi

  # 5) 部署生成文件 + 重启受影响服务
  rm -f "$in_json" "$new_cfg" "$new_sec" "$norm_file"
  apply_stage_files "$stage" "$man_json"
  cleanup_stale_port_networks
  rm -rf "$stage"
  acts="$(plan_for_section "$section")"
  # 仅在模式/账号变化或网口重绑定时才重拨 PPPoE（避免改个 DNS 就断线重连）
  local new_mode new_user pppoe_needed="no"
  new_mode="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("mode",""))')"
  new_user="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("username","") or "")')"
  [ "$old_mode" != "$new_mode" ] && pppoe_needed="yes"
  [ "$old_user" != "$new_user" ] && pppoe_needed="yes"  # P2-2：改账号此前不重拨，pppd 仍持旧凭据会话
  [ "$section" = "bind" ] && [ "$new_mode" = "pppoe" ] && pppoe_needed="yes"
  # PPPoE 下 IPv6 设置变更需要重拨：+ipv6/IPv6CP 与 ppp0 上的 DHCPv6 客户端随重拨生效
  [ "$section" = "ipv6" ] && [ "$new_mode" = "pppoe" ] && pppoe_needed="yes"
  if [ "$section" = "wan" ] && printf '%s' "$norm" | python3 -c 'import json,sys;sys.exit(0 if json.load(sys.stdin).get("data",{}).get("password") else 1)' 2>/dev/null; then
    pppoe_needed="yes"
  fi
  if [ "$pppoe_needed" != "yes" ]; then
    acts="$(printf '%s\n' $acts | grep -v '^pppoe$' | tr '\n' ' ')"
  fi
  failed="$(run_actions "$acts")"

  # 6) 验证
  local mode wan_to tmo err_hint=""
  mode="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("mode",""))')"
  if ! wait_dnsmasq 10; then
    err_hint="dnsmasq 未能启动：journalctl -u dnsmasq -n 30"
    failed="$failed dnsmasq"
  elif [ "$section" = "wan" ] || [ "$pre_wan" = "yes" ]; then
    # 上网设置无条件验证：首次配置 PPPoE 时 pre_wan=no，恰恰是最需要报错的场景（审计 B-03）
    if [ "$section" = "wan" ] && [ "$mode" = "pppoe" ]; then tmo=45; else tmo=25; fi
    if ! wait_wan "$tmo"; then
      if [ "$mode" = "pppoe" ]; then
        if journalctl -u dert-pppoe.service -n 40 --no-pager 2>/dev/null | grep -qiE "PAP authentication failed|CHAP authentication failed|authentication failed"; then
          err_hint="PPPoE 拨号被服务器拒绝（认证失败）：请检查宽带账号/密码是否正确；若账号正在其他设备上拨号，请先断开再试"
        elif journalctl -u dert-pppoe.service -n 40 --no-pager 2>/dev/null | grep -qiE "timeout|LCP: timeout|No response"; then
          err_hint="PPPoE 服务器无响应：请确认光猫已改为桥接模式、WAN 线已插在绑定的 WAN 口上"
        else
          err_hint="PPPoE 未能在预期时间内建立连接：journalctl -u dert-pppoe -n 40 查看详情"
        fi
      else
        err_hint="应用后 WAN 未能恢复连接：请检查上级网络/网线；可尝试在「网络设置」重新保存上网设置"
      fi
      failed="$failed wan"
    fi
  fi

  if [ -n "$failed" ] || [ -n "$err_hint" ]; then
    # 回滚到修改前配置并重放
    restore_lastgood "$tag"
    local stage2 man2
    stage2="$(mktemp -d /run/dert/stage.XXXXXX)"
    man2="$stage2/manifest.json"
    if python3 "${PRIV_DIR}/netgen.py" --stage "$stage2" > "$man2" 2>/dev/null; then
      apply_stage_files "$stage2" "$man2"
      cleanup_stale_port_networks
      run_actions "$(plan_for_section "$section")" >/dev/null 2>&1 || true
    fi
    rm -rf "$stage2"
    [ -z "$err_hint" ] && err_hint="已自动恢复到修改前的可用配置，未生效的修改请检查后重试"
    die "APPLY_ROLLED_BACK" "配置未能安全生效，已自动回滚" "$err_hint"
  fi

  # 7) 回应（WAN 方式切换给 sing-box 用户一句提示）
  local msg="配置已保存并生效" hint_sb=""
  if [ "$section" = "wan" ] && systemctl is-enabled --quiet sing-box.service 2>/dev/null; then
    hint_sb="若已启用 sing-box，建议执行 sb restart 重新绑定出口接口"
  fi
  if [ "$section" = "lan" ]; then
    msg="LAN 设置已生效；若管理地址已变化，请使用新 IP 重新登录"
  fi
  ok_out "message" "$msg" "hint_singbox" "$hint_sb"
}

# ---------------------------------------------------------------------------
# 幂等收敛（开机 / 定时）
# ---------------------------------------------------------------------------
do_apply_all() {
  require_root
  local convergent=""; [ "${1:-}" = "--convergent" ] && convergent="1"
  mkdir -p /run/dert-dns /run/dert
  acquire_lock
  local stage man_json migrated=""
  stage="$(mktemp -d /run/dert/stage.XXXXXX)"
  man_json="$stage/manifest.json"
  if ! python3 "${PRIV_DIR}/netgen.py" --stage "$stage" > "$man_json" 2>"$stage/netgen.err"; then
    # P3-12：生成器的 stderr 不再丢弃——结构损坏（KeyError / AddressValueError）时
    # man_json 是空的，此前只剩"配置生成失败"+"请按上方错误信息修正"，而上方什么都没有
    local gen_err=""
    [ -s "$stage/netgen.err" ] && gen_err="$(tail -n 2 "$stage/netgen.err" | tr '\n' ' ' | cut -c1-240)"
    # 存量不兼容配置的自动纠正（四审 M-01/M-02/M-03）：
    #   LAN_MASK_TOO_WIDE → 掩码迁回 /24（保留 IP 与地址池）
    # 注：原先还有一条 "V6_NATIVE_PPPPOE_UNSUPPORTED → 改 NAT6" 的迁移，v0.1.41 起
    # PPPoE 已真支持 IPv6（ppp0 上跑 DHCPv6 客户端），该错误码不再产生，迁移已删除
    # ——留着会让后来者误以为"PPPoE 只能用 NAT6"，与现行规则相反。
    # 迁移成功则重试一次生成；任何其他失败原样透传错误并中止（保证不部署半套配置）。
    if grep -qE 'LAN_MASK_TOO_WIDE' "$man_json" 2>/dev/null; then
      snapshot_lastgood "m$(date +%s)"
      MIGFIX="$(python3 - <<'INNERPYEOF'
import json, os
cfg = json.load(open("/etc/dert/config.json"))
fixes = []
if cfg.get("lan", {}).get("mask") != "255.255.255.0":
    cfg["lan"]["mask"] = "255.255.255.0"
    fixes.append("LAN 掩码迁移为 /24")
json.dump(cfg, open("/etc/dert/.config.tmp", "w"), ensure_ascii=False, indent=1)
os.replace("/etc/dert/.config.tmp", "/etc/dert/config.json")
print("；".join(fixes))
INNERPYEOF
)"
      if [ -n "$MIGFIX" ]; then
        migrated="已自动修正不兼容的存量配置（$MIGFIX）"
        rm -rf "$stage"
        stage="$(mktemp -d /run/dert/stage.XXXXXX)"
        man_json="$stage/manifest.json"
        if python3 "${PRIV_DIR}/netgen.py" --stage "$stage" > "$man_json" 2>"$stage/netgen.err"; then
          # 迁移成功：继续正常流程（跳过下方 die）
          :
        else
          cat "$man_json" 2>/dev/null
          local gen_err2=""
          [ -s "$stage/netgen.err" ] && gen_err2="$(tail -n 2 "$stage/netgen.err" | tr '\n' ' ' | cut -c1-240)"
          mark_converge_failed
          rm -rf "$stage"
          die "CONFIG_CORRUPT" "自动迁移后仍无法生成配置" "请按上方错误信息在管理页面修正${gen_err2:+。生成器输出：$gen_err2}"
        fi
      fi
    fi
    if [ -z "$migrated" ]; then
      cat "$man_json" 2>/dev/null   # 透传 netgen 的可操作错误（复审 R-03）
      mark_converge_failed
      rm -rf "$stage"
      die "CONFIG_CORRUPT" "配置生成失败" "请按上方错误信息在管理页面修正；或从 /var/lib/dert/lastgood 恢复上一份可用配置${gen_err:+。生成器输出：$gen_err}"
    fi
  fi

  if [ -n "$convergent" ]; then
    # 收敛模式：无漂移则只保证运行时状态（nft 表 / cake / 服务存活）
    local drift=0 line rel mode
    while IFS=$'\t' read -r rel mode; do
      [ -f "/${rel}" ] || { drift=1; break; }
      cmp -s "/${rel}" "${stage}/${rel}" || { drift=1; break; }
    done < <(python3 - "$man_json" <<'PYEOF'
import json, sys
for f in json.load(open(sys.argv[1]))["files"]:
    print(f"{f['path']}\t{f['mode']:04o}")
PYEOF
)
    if [ "$drift" = "0" ]; then
      # 无漂移：nft 规则不跨重启，缺表则只重建防火墙+QoS；绝不重启 networkd/dnsmasq
      # （开机全量重启会让 LAN 客户端闪断——真机实测），dnsmasq 稍后带着有效配置自行启动
      nft list table $NFT_TABLE >/dev/null 2>&1 || svc_nft
      svc_cake
      cleanup_ifupdown_for_ports
      sync_dns_upstream
      # 注意：收敛单元 Before=dnsmasq，此处同步 start dnsmasq 会与排序中的启动任务
      # 互相等待形成死锁（真机实测）——崩溃恢复由 dnsmasq 的 Restart=on-failure 负责
      maintain_singbox_dropin
      clear_converge_failed
      # 暂存目录必须清：这里是"无漂移"的提前返回，早于下方全量路径的清理语句。
      # 漏了它 = 每次开机/6h 收敛/每次升级都在 /run/dert 留一份完整生成物，
      # 其中 etc/ppp/chap-secrets 是明文宽带密码（真机 2026-11-09 实测：开机后
      # /run/dert/stage.XXXXXX 里躺着 chap-secrets/pap-secrets，重启才清）
      rm -rf "$stage"
      ok_out "message" "无漂移，运行时已确认" "converged" "true"
      exit 0
    fi
  fi

  if ! pf_out="$(preflight_stage "$stage")"; then
      mark_converge_failed
      rm -rf "$stage"
      # 透传预检的具体原因（nft -c / dnsmasq --test 的报错行）——此前 pf_out 被直接丢弃，
      # 用户只看到"现有配置无法生成合法的系统配置"，无从下手（与 P3-12 同一类：错误详情被吞）
      if [ -n "$pf_out" ]; then printf '%s\n' "$pf_out"; exit 1; fi
      die "STAGE_BROKEN" "现有配置无法生成合法的系统配置" "请在管理页面检查网络设置；或恢复出厂设置"
  fi
  apply_stage_files "$stage" "$man_json"
  cleanup_stale_port_networks
  cleanup_ifupdown_for_ports
  rm -rf "$stage"
  run_actions "networkd pppoe dnsmasq nft cake" >/dev/null 2>&1 || true
  wait_dnsmasq 15 || true
  sync_dns_upstream
  maintain_singbox_dropin
  clear_converge_failed
  ok_out "message" "已按配置完成系统收敛${migrated:+。}$migrated"
}

# ---------------------------------------------------------------------------
# 服务控制（podman / tailscale）
# ---------------------------------------------------------------------------
do_service_ctl() {
  require_root
  local name="${1:-}" action="${2:-}"
  case "$name" in
    podman)
      case "$action" in
        start)   systemctl start podman.socket podman.service 2>/dev/null; podman start --all >/dev/null 2>&1 || true ;;
        stop)    podman stop --all >/dev/null 2>&1 || true; systemctl stop podman.service podman.socket 2>/dev/null || true ;;
        enable)  systemctl enable --quiet podman.socket podman.service podman-restart.service 2>/dev/null || die "SVC" "设置开机自启失败" "请确认已安装 podman：apt install podman" ;;
        disable) systemctl disable --quiet podman.socket podman.service podman-restart.service 2>/dev/null || true ;;
        *) die "USAGE" "service-ctl podman 需要 start|stop|enable|disable" ;;
      esac ;;
    tailscale)
      command -v tailscale >/dev/null 2>&1 || die "TS_NOT_INSTALLED" "Tailscale 尚未安装" "请在「其他工具」中先一键安装"
      case "$action" in
        start)   systemctl start tailscaled.service ;;
        stop)    systemctl stop tailscaled.service ;;
        enable)  systemctl enable --quiet tailscaled.service ;;
        disable) systemctl disable --quiet tailscaled.service ;;
        *) die "USAGE" "service-ctl tailscale 需要 start|stop|enable|disable" ;;
      esac ;;
    *) die "USAGE" "不支持的服务：${name}" ;;
  esac
  ok_out "message" "已完成 ${name} ${action}"
}

# ---------------------------------------------------------------------------
# podman-ops
# ---------------------------------------------------------------------------
POD_LOCK=0
pod_lock() { exec 8>/run/dert/podman.lock; flock -w 600 8 || die "BUSY" "另一个容器操作正在进行中，请稍后重试"; }

podman_json() { python3 -c "$1"; }

do_podman_ops() {
  require_root
  local action="${1:-}"; [ $# -gt 0 ] && shift
  if ! command -v podman >/dev/null 2>&1; then
    if [ "$action" = "status" ]; then
      ok_out "installed" "false" "running" "false" "autostart" "false"   # 未安装也给前端结构化结果
      exit 0    # 不能再落到 die：ok_out 不退出，双 JSON 会让面板解析失败（六审 P-06）
    fi
    die "PODMAN_MISSING" "Podman 未安装" "请在系统上执行 apt install podman podman-compose"
  fi
  # B-08：只读操作不进排他区——pull 超时 660s，拉大镜像期间开容器页曾把 status 卡到 504
  case "$action" in
    status|list-containers|list-images|compose-get) ;;
    *) pod_lock ;;
  esac
  case "$action" in
    status)
      local ver running autostart
      ver="$(podman --version 2>/dev/null | awk '{print $3}')"
      # "运行中" = podman 服务或 socket active，或确有容器在跑；
      # 不能只看容器数——零容器的机器启动服务后仍会显示"已停止"（用户实测）
      if [ -n "$(podman ps -q 2>/dev/null | head -n 1)" ] \
         || systemctl is-active --quiet podman.service \
         || systemctl is-active --quiet podman.socket; then
        running="true"
      else
        running="false"
      fi
      systemctl is-enabled --quiet podman-restart.service 2>/dev/null && autostart="true" || autostart="false"
      ok_out "installed" "true" "version" "${ver:-}" "running" "$running" "autostart" "$autostart" ;;
    list-containers)
      podman ps -a --format '{{.Names}}\t{{.Image}}\t{{.State}}\t{{.Ports}}' | podman_json '
import sys, json
out = []
for line in sys.stdin:
    parts = line.rstrip("\n").split("\t")
    parts += [""] * (4 - len(parts))
    out.append({"name": parts[0], "image": parts[1], "state": parts[2],
                "ports": [p for p in parts[3].split(",") if p]})
print(json.dumps({"ok": True, "containers": out}))' ;;
    container)
      local cname="${1:-}" cact="${2:-}" label
      [ -n "$cname" ] && [ -n "$cact" ] || die "USAGE" "缺少容器名或操作"
      case "$cact" in
        start)  label="已启动" ;;
        stop)   label="已停止" ;;
        restart) label="已重启" ;;
        remove) label="已删除" ;;
        update) label="已更新" ;;
        *) die "USAGE" "容器操作需为 start|stop|restart|update|remove" ;;
      esac
      case "$cact" in
        start|restart)
          if ! podman "$cact" "$cname" >/dev/null 2>&1; then
            # OCI/cgroup 阶段的失败 logs 是空的，真实原因在 State.Error（真机实测）
            local serr; serr="$(podman inspect -f '{{.State.Error}}' "$cname" 2>/dev/null | cut -c1-200)"
            die "CT_FAIL" "容器 $cname ${cact} 失败" "原因：${serr:-无（可执行 podman logs --tail 20 $cname 查看）}"
          fi ;;
        stop) podman stop -t 10 "$cname" >/dev/null 2>&1 || die "CT_FAIL" "容器 $cname 停止失败" "" ;;
        remove) podman rm -f "$cname" >/dev/null 2>&1 || die "CT_FAIL" "删除容器失败" "请确认容器名正确" ;;
        update) do_podman_update "$cname" ;;
      esac
      ok_out "message" "容器 $cname ${label}" ;;
    list-images)
      # 按镜像 ID 匹配使用状态：容器 .Image 的拼写与 images .Names 首个 tag 经常
      # 不一致，按名称匹配会误报"未使用"（真机实测 sub-store 在用却显示未使用）
      podman images --format '{{.ID}}\t{{.Names}}\t{{.Size}}' | podman_json '
import sys, json, subprocess
def short(i): return (i or "")[:12]
used = {}
for line in subprocess.run(["podman","ps","-a","--format","{{.ImageID}}"],capture_output=True,text=True).stdout.splitlines():
    k = short(line.strip())
    if k: used[k] = used.get(k, 0) + 1
imgs, order = {}, []
for line in sys.stdin:
    iid, names, size = (line.rstrip("\n").split("\t") + [""] * 3)[:3]
    k = short(iid)
    if not k or k in imgs: continue
    first_tag = (names.split(",")[0] if names else "") or "<none>"
    imgs[k] = {"name": first_tag, "id": k, "size_text": size, "used_by": used.get(k, 0)}
    order.append(k)
print(json.dumps({"ok": True, "images": [imgs[k] for k in order]}))' ;;
    pull)
      local img="${1:-}"
      [ -n "$img" ] || die "USAGE" "缺少镜像名"
      if ! podman pull --timeout 300s "$img" >/dev/null 2>&1; then
        die "PULL_FAIL" "镜像 $img 拉取失败" "请检查镜像名与标签；若服务器在墙外，请确认网络可直连镜像仓库，或先配置镜像加速"
      fi
      ok_out "message" "镜像 $img 已拉取" ;;
    image-rm)
      local img="${1:-}"
      [ -n "$img" ] || die "USAGE" "缺少镜像名"
      podman rmi "$img" >/dev/null 2>&1 || die "IMG_FAIL" "删除镜像失败" "该镜像可能正被容器使用，或名称不完整（需含 tag）"
      ok_out "message" "镜像已删除" ;;
    compose-get)
      ok_out "content" "$(python3 -c '
import json, os
p = "/etc/dert/compose.yaml"
print(json.dumps(open(p).read() if os.path.exists(p) else ""))' 2>/dev/null || echo '""')" ;;
    compose-set)
      write_atomic "${DERT_ETC}/compose.yaml" 644
      ok_out "message" "Compose 文件已保存" ;;
    compose-deploy)
      [ -f "${DERT_ETC}/compose.yaml" ] || die "COMPOSE_EMPTY" "尚未保存 Compose 内容" "请先在文本框中填写并部署"
      command -v podman-compose >/dev/null 2>&1 || die "COMPOSE_MISSING" "未安装 podman-compose" "在系统上执行 apt install podman-compose 后重试"
      local logf logtail
      logf="$(mktemp /run/dert/compose.XXXXXX)"
      if ! podman-compose -f "${DERT_ETC}/compose.yaml" -p dert up -d >"$logf" 2>&1; then
        # pod 建立时 cgroup slice 竞态：报 OCI "No such file or directory" 且容器
        # State=created——重试一次即好（真机实测一次）
        if grep -qiE "no such file or directory|OCI runtime" "$logf" && \
           grep -qE "State=created|created" "$(podman ps -a --filter label=com.docker.compose.project=dert --format '{{.Names}}' 2>/dev/null | head -1 | xargs -r podman inspect -f '{{.State.Status}} {{.State.Error}}' 2>/dev/null)" 2>/dev/null; then
          sleep 2
          podman-compose -f "${DERT_ETC}/compose.yaml" -p dert up -d >>"$logf" 2>&1 || true
        fi
      fi
      if ! podman ps -a --filter label=com.docker.compose.project=dert --format '{{.Names}}' | head -1 | xargs -r test -n; then
        logtail="$(tail -n 4 "$logf" | tr '\n' ' ' | cut -c1-260)"
        rm -f "$logf"
        die "COMPOSE_FAIL" "Compose 部署失败" "常见原因：语法错误、镜像名/标签不存在、端口被占用。日志：${logtail}"
      fi
      logtail="$(tail -n 3 "$logf" | tr '\n' ' ' | cut -c1-200)"
      rm -f "$logf"
      ok_out "message" "Compose 已部署" "log_tail" "$logtail" ;;
    compose-stop)
      podman-compose -f "${DERT_ETC}/compose.yaml" -p dert down >/dev/null 2>&1 || true
      ok_out "message" "Compose 已停止（数据卷保留）" ;;
    *) die "USAGE" "podman-ops 未知操作：${action}" ;;
  esac
}

# 容器"更新"：拉最新镜像并按原端口/卷/环境重建
do_podman_update() {
  local cname="$1" img ports binds envs restart
  # 观察③：更新只回放端口/卷/环境变量/重启策略——自定义网络与 privileged 会静默丢失，
  # 而重建成功就返回"已更新"，用户要到连不上才发现。前置拒绝并指路 Compose。
  local _nm _pv
  _nm="$(podman inspect -f '{{.HostConfig.NetworkMode}}' "$cname" 2>/dev/null)"
  case "$_nm" in
    ""|default|bridge) ;;
    *) die "CT_UPDATE_SKIP" "容器 $cname 使用自定义网络（$_nm），面板更新会丢失该配置" "此类容器请改用 Compose 管理，或用 podman CLI 手工重建" ;;
  esac
  _pv="$(podman inspect -f '{{.HostConfig.Privileged}}' "$cname" 2>/dev/null)"
  [ "$_pv" = "true" ] && die "CT_UPDATE_SKIP" "容器 $cname 以 privileged 运行，面板更新会丢失该配置" "此类容器请改用 Compose 管理，或用 podman CLI 手工重建"
  img="$(podman inspect -f '{{.ImageName}}' "$cname" 2>/dev/null)"
  [ -n "$img" ] || die "CT_FAIL" "无法读取容器 $cname 的镜像信息"
  restart="$(podman inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$cname" 2>/dev/null)"
  [ -n "$restart" ] && [ "$restart" != "no" ] || restart="unless-stopped"
  if ! podman pull --timeout 300s "$img" >/dev/null 2>&1; then
    die "PULL_FAIL" "拉取 $img 最新版本失败" "请检查网络与镜像仓库可达性"
  fi
  local args=()
  while IFS= read -r p; do [ -n "$p" ] && args+=(-p "$p"); done < <(podman inspect -f '{{range $k,$v := .HostConfig.PortBindings}}{{range $v}}-p {{.HostIp}}:{{.HostPort}}:{{$k}}{{"\n"}}{{end}}{{end}}' "$cname" 2>/dev/null | sed 's/-p //')
  while IFS= read -r b; do [ -n "$b" ] && args+=(-v "$b"); done < <(podman inspect -f '{{range .HostConfig.Binds}}{{.}}{{"\n"}}{{end}}' "$cname" 2>/dev/null)
  while IFS= read -r e; do [ -n "$e" ] && args+=(-e "$e"); done < <(podman inspect -f '{{range .Config.Env}}{{.}}{{"\n"}}{{end}}' "$cname" 2>/dev/null | grep -vE '^(PATH|TERM|container|HOSTNAME|HOME)=')
  # 先建后删（审计 B-19）：新容器创建成功才动旧容器；失败保留旧容器原地运行
  local tmp_name="${cname}.new.$$"
  if ! podman create --name "$tmp_name" --restart "$restart" "${args[@]}" "$img" >/dev/null 2>&1; then
    podman rm -f "$tmp_name" >/dev/null 2>&1 || true
    die "CT_REBUILD_FAIL" "容器 $cname 重建失败（旧容器未受影响）" "更新只保留端口/卷/环境变量/重启策略；使用特殊参数（--network/--privileged 等）的容器请改用 Compose 管理"
  fi
  podman stop -t 30 "$cname" >/dev/null 2>&1 || true
  podman rm "$cname" >/dev/null 2>&1 || true
  if ! podman rename "$tmp_name" "$cname" >/dev/null 2>&1; then
    die "CT_REBUILD_FAIL" "新容器已就绪但改名失败" "可在系统上执行 podman start ${tmp_name} 手工接管"
  fi
  podman start "$cname" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# singbox-ops（sing-box 服务 / 配置更新 / Tailscale endpoint 只读信息）
# 事实源仍是 sb.sh（/usr/local/bin/sb）：内核安装/升级、配置拉取、cron 都由它管；
# 本层只做白名单封装、状态读取与 cron 时间设定，永不直接改写 sing-box 配置。
# Tailscale 自 v0.1.32 起以 sing-box endpoint 托管：Debian 直装方案已移除。
# ---------------------------------------------------------------------------
do_singbox_ops() {
  require_root
  local action="${1:-}"
  case "$action" in
    status)
      python3 - <<'SBJ'
import json, os, re, subprocess

def _run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except Exception:
        return None

r = _run(["sh", "-c", "command -v sing-box"])
installed = bool(r and r.stdout.strip())
sb_present = os.access("/usr/local/bin/sb", os.X_OK)
active = enabled = False
version = ""
cfg = {}
try:
    cfg = json.load(open("/etc/sing-box/config.json"))
except Exception:
    cfg = {}
if installed:
    a = _run(["systemctl", "is-active", "--quiet", "sing-box.service"])
    active = bool(a and a.returncode == 0)
    e = _run(["systemctl", "is-enabled", "--quiet", "sing-box.service"])
    enabled = bool(e and e.returncode == 0)
    v = (_run(["sing-box", "version"]).stdout or "").split("\n")[0] if _run(["sing-box", "version"]) else ""
    m = re.search(r"([0-9]+\.[0-9]+\.[0-9]+)", v or "")
    version = m.group(1) if m else ""
url_set = False
url_masked = ""
try:
    u = open("/etc/sing-box/config.url").read().strip().splitlines()[0].strip()
except Exception:
    u = ""
if u:
    url_set = True
    from urllib.parse import urlparse
    p = urlparse(u)
    path = p.path or ""
    if len(path) > 14:
        path = path[:8] + "…" + path[-4:]
    url_masked = p.scheme + "://" + p.netloc + path
auto_on = False
auto_time = ""
try:
    for line in open("/etc/cron.d/sing-box"):
        if "/usr/local/bin/sb update" in line:
            f = line.split()
            if len(f) >= 2:
                auto_time = f[1].zfill(2) + ":" + f[0].zfill(2)
                auto_on = True
            break
except Exception:
    pass
upd = {"ok": None, "ts": None, "error": "", "trigger": ""}
try:
    d = json.load(open("/var/lib/sing-box/update-state.json"))
    upd = {"ok": bool(d.get("ok")), "ts": int(d.get("ts") or 0),
           "error": str(d.get("error") or ""), "trigger": str(d.get("trigger") or "")}
except Exception:
    pass
ep_present = False
ep_host = ""
for e2 in (cfg.get("endpoints") or []):
    if e2.get("type") == "tailscale":
        ep_present = True
        ep_host = str(e2.get("hostname") or "")
        break
clash = (cfg.get("experimental") or {}).get("clash_api") or {}
controller = str(clash.get("external_controller") or "")
if not controller:
    # A-06：新版官方形态把 API 放在 services[type=api]（无 experimental.clash_api）——
    # 此前只认 clash_api，services 用户按钮永远隐藏
    for _svc in (cfg.get("services") or []):
        if _svc.get("type") == "api":
            # N-01：listen 与 listen_port 是两个字段，只取 listen 曾拼出 host:0.0.0.0 死链
            _host = str(_svc.get("listen") or "127.0.0.1")
            _port = _svc.get("listen_port")
            controller = f"{_host}:{_port}" if _port else _host
            break
ui = False
ui_dir = str(clash.get("external_ui") or "")
if ui_dir:
    full = ui_dir if ui_dir.startswith("/") else os.path.join("/etc/sing-box", ui_dir)
    ui = os.path.isdir(full)
custom = ""
try:
    custom = open("/var/lib/dert/singbox-dash-url").read().strip()
except Exception:
    custom = ""
up_s = None
if active:
    pid = (_run(["systemctl", "show", "sing-box.service", "--property=MainPID", "--value"]).stdout or "").strip()
    if pid and pid != "0":
        pe = _run(["ps", "-o", "etimes=", "-p", pid])
        try:
            up_s = int((pe.stdout or "0").strip() or 0)
        except ValueError:
            up_s = None
print(json.dumps({"ok": True, "installed": installed, "sb": sb_present,
                  "active": active, "enabled": enabled, "version": version,
                  "uptime_s": up_s,
                  "url_set": url_set, "url_masked": url_masked,
                  "autoupdate": {"on": auto_on, "time": auto_time},
                  "update": upd, "endpoint": {"present": ep_present, "hostname": ep_host},
                  "dashboard": {"controller": controller, "ui": ui, "custom": custom}}, ensure_ascii=False))
SBJ
      ;;
    ctl)
      local act="${2:-}"
      systemctl list-unit-files sing-box.service >/dev/null 2>&1 || die "SB_NOT_INSTALLED" "sing-box 未安装" "请在「其他工具」页一键安装"
      case "$act" in
        start)   systemctl start sing-box.service ;;
        stop)    systemctl stop sing-box.service ;;
        restart) systemctl restart sing-box.service ;;
        *) die "USAGE" "singbox-ops ctl 需要 start|stop|restart" ;;
      esac
      ok_out "message" "sing-box ${act} 完成" ;;
    autostart)
      local on="${2:-}"
      systemctl list-unit-files sing-box.service >/dev/null 2>&1 || die "SB_NOT_INSTALLED" "sing-box 未安装" "请在「其他工具」页一键安装"
      case "$on" in
        on)  systemctl enable sing-box.service ;;
        off) systemctl disable sing-box.service 2>/dev/null || true ;;
        *) die "USAGE" "singbox-ops autostart 需要 on|off" ;;
      esac
      ok_out "message" "开机自启已$([ "$on" = on ] && echo 开启 || echo 关闭)" ;;
    install)
      [ -x /usr/local/bin/sb ] || die "SB_NO_SB" "未找到 sb 命令" "sb.sh 由 DebRT 安装包下发（/usr/local/bin/sb）；请重装 DebRT"
      local out rc
      out="$(/usr/local/bin/sb install 2>&1)" && rc=0 || rc=$?
      if [ "$rc" -ne 0 ]; then
        printf '%s\n' "$out" | tail -n 5 >&2
        die "SB_INSTALL_FAIL" "sing-box 安装/升级失败" "以上为 sb 输出尾部；GitHub 被墙时可稍后重试（sb 走 gh-proxy 回退）"
      fi
      ok_out "message" "sing-box 内核已就绪" "tail" "$(printf '%s\n' "$out" | tail -n 3)" ;;
    sub-set)
      local url
      url="$(python3 -c 'import json,sys;print(str(json.load(sys.stdin).get("url","")).strip().replace(" ",""))' 2>/dev/null)" \
        || die "SB_SUB_BAD" "请求格式错误"
      [ -n "$url" ] || die "SB_SUB_BAD" "配置地址为空" "请填写配置来源链接后保存"
      case "$url" in
        https://*|http://*) ;;
        *) die "SB_URL_BAD" "配置地址需以 http(s):// 开头" "示例：https://sub.example.com/link/xxx" ;;
      esac
      python3 - "$url" <<'SBURL' || die "SB_URL_BAD" "配置地址不能指向内网或主机名无效" "请使用公网可访问的配置地址"
import sys
sys.path.insert(0, "/usr/local/lib/dert")
import validate
from urllib.parse import urlparse
host = (urlparse(sys.argv[1]).hostname or "").lower()
raise SystemExit(1 if (not host or validate.url_host_blacklisted(host)) else 0)
SBURL
      mkdir -p /etc/sing-box
      write_atomic "/etc/sing-box/config.url" 600 <<SBURLF
$url
SBURLF
      ok_out "message" "配置地址已保存（页面上显示脱敏值）" ;;
    sub-update)
      [ -x /usr/local/bin/sb ] || die "SB_NO_SB" "未找到 sb 命令" "sb.sh 由 DebRT 安装包下发；请重装 DebRT"
      local out rc st_ok st_err
      out="$(SB_UPDATE_TRIGGER=manual /usr/local/bin/sb update 2>&1)" && rc=0 || rc=$?
      st_ok="$(python3 -c 'import json;print("1" if json.load(open("/var/lib/sing-box/update-state.json")).get("ok") else "0")' 2>/dev/null || echo "$([ "$rc" -eq 0 ] && echo 1 || echo 0)")"
      if [ "$st_ok" != "1" ]; then
        st_err="$(python3 -c 'import json;print(str(json.load(open("/var/lib/sing-box/update-state.json")).get("error") or ""))' 2>/dev/null || printf '%s' "$(printf '%s\n' "$out" | tail -n 2 | tr '\n' ' ' | cut -c1-200)")"
        die "SB_UPDATE_FAIL" "配置更新失败：${st_err:-原因未记录}" "失败原因会持续显示在本页；旧配置仍在运行，可稍后重试"
      fi
      ok_out "message" "配置已更新，sing-box 已重启加载新配置" ;;
    schedule)
      local tm
      tm="$(python3 -c 'import json,sys;print(str(json.load(sys.stdin).get("time","")).strip())' 2>/dev/null)" || die "SB_SCHED_BAD" "请求格式错误"
      if [ "$tm" = "off" ] || [ -z "$tm" ]; then
        if [ -f /etc/cron.d/sing-box ]; then
          grep -v '/usr/local/bin/sb update' /etc/cron.d/sing-box > /etc/cron.d/sing-box.tmp 2>/dev/null || true
          if grep -q . /etc/cron.d/sing-box.tmp 2>/dev/null; then
            mv -f /etc/cron.d/sing-box.tmp /etc/cron.d/sing-box
          else
            rm -f /etc/cron.d/sing-box.tmp /etc/cron.d/sing-box
          fi
        fi
        ok_out "message" "自动更新已关闭"
        exit 0
      fi
      printf '%s' "$tm" | grep -qE '^([0-9]|0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$' \
        || die "SB_SCHED_BAD" "时间格式应为 HH:MM（24 小时制）" "示例：04:00、06:30"
      local hh mm
      hh="$(printf '%s' "$tm" | cut -d: -f1 | sed 's/^0//')"; hh=$([ -n "$hh" ] && echo "$hh" || echo 0)
      mm="$(printf '%s' "$tm" | cut -d: -f2 | sed 's/^0//')"; mm=$([ -n "$mm" ] && echo "$mm" || echo 0)
      command -v crontab >/dev/null 2>&1 || true
      systemctl enable --now cron.service 2>/dev/null || systemctl enable --now cron 2>/dev/null || true
      {
        printf 'SHELL=/bin/sh\n'
        printf 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n'
        printf '%d %d * * * root /usr/local/bin/sb update\n' "$mm" "$hh"
      } > /etc/cron.d/sing-box.tmp
      chmod 644 /etc/cron.d/sing-box.tmp
      mv -f /etc/cron.d/sing-box.tmp /etc/cron.d/sing-box
      ok_out "time" "$tm" "message" "配置自动更新已设为每天 $tm" ;;
    uninstall)
      [ -x /usr/local/bin/sb ] || die "SB_NOT_INSTALLED" "sing-box 未安装"
      local out rc
      out="$(/usr/local/bin/sb uninstall --yes 2>&1)" && rc=0 || rc=$?
      [ "$rc" -eq 0 ] || { printf '%s\n' "$out" | tail -n 5 >&2; die "SB_UNINSTALL_FAIL" "卸载失败" "以上为 sb 输出尾部；可稍后重试或在控制台执行 sb uninstall"; }
      ok_out "message" "sing-box 已卸载（原配置备份在 /var/lib/dert/）" ;;
    dash-set)
      local url
      url="$(python3 -c 'import json,sys;print(str(json.load(sys.stdin).get("url","")).strip())' 2>/dev/null)" || die "SB_DASH_BAD" "请求格式错误"
      mkdir -p /var/lib/dert
      if [ -z "$url" ]; then
        rm -f /var/lib/dert/singbox-dash-url
        ok_out "message" "Dashboard 地址已清除（回到按配置自动推导）"
        exit 0
      fi
      case "$url" in
        https://*|http://*) ;;
        *) die "SB_DASH_BAD" "Dashboard 地址需以 http(s):// 开头" "示例：https://metacubexd.pages.dev" ;;
      esac
      write_atomic "/var/lib/dert/singbox-dash-url" 644 <<SBDASH
$url
SBDASH
      ok_out "message" "Dashboard 地址已保存" ;;
    check)
      local cur latest
      cur="$(sing-box version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
      [ -n "$cur" ] || die "SB_NOT_INSTALLED" "sing-box 未安装" "请在「其他工具」页一键安装"
      latest="$(github_latest_ver "SagerNet/sing-box")" || die "SB_NET" "无法获取 sing-box 最新版本" "GitHub 可能限流，可稍后重试"
      if [ "$latest" = "$cur" ]; then
        ok_out "up_to_date" "true" "current" "$cur" "latest" "$latest" "message" "已是最新版本 v$cur"
      else
        ok_out "up_to_date" "false" "current" "$cur" "latest" "$latest" "message" "发现新版本 v$latest（当前 v$cur）"
      fi ;;
    *) die "USAGE" "singbox-ops 需要 status|ctl|autostart|install|check|dash-set|sub-set|sub-update|schedule|uninstall" ;;
  esac
}

# ---------------------------------------------------------------------------
# 管理密码
# ---------------------------------------------------------------------------
do_passwd_set() {
  require_root
  acquire_lock
  local body
  body="$(cat)"
  local out rc
  # body（含新旧密码）经环境变量传入，不进 argv（审计 B-15）
  out="$(DERT_SECRET="$body" python3 - <<'PYEOF'
import json, os, sys, time
sys.path.insert(0, "/usr/local/lib/dert")
import pwhash
body = json.loads(os.environ["DERT_SECRET"])
old, new = body.get("old", ""), body.get("new", "")
secrets = json.load(open("/etc/dert/secrets.json"))
# C-2：原密码暴破限速（持有会话的攻击者此前可无限尝试）——5 次锁 5 分钟
FAILS = "/var/lib/dert/passwd-fails.json"
def pf_load():
    try:
        return json.load(open(FAILS))
    except Exception:
        return {"fails": 0, "lock_until": 0}
def pf_save(st):
    tmp = FAILS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.replace(tmp, FAILS)
now = int(time.time())
_st = pf_load()
if _st.get("lock_until", 0) > now:
    print(json.dumps({"ok": False, "code": "AUTH_LOCKED",
                      "message": f"尝试次数过多，请 {_st['lock_until'] - now + 1} 秒后重试",
                      "hint": "密码不会因此失效"})); sys.exit(1)
def check(pw, rec):
    try:
        return pwhash.verify(pw, rec)
    except Exception:
        return False
if not check(old, secrets.get("admin_pbkdf2", "")):
    _st["fails"] = _st.get("fails", 0) + 1
    if _st["fails"] >= 5:
        _st["lock_until"] = now + 300
        _st["fails"] = 0
        pf_save(_st)
        print(json.dumps({"ok": False, "code": "AUTH_LOCKED",
                          "message": "原密码连续错误次数过多，已临时锁定 5 分钟",
                          "hint": "密码不会因此失效"})); sys.exit(1)
    pf_save(_st)
    print(json.dumps({"ok": False, "code": "AUTH_BAD", "message": "原密码不正确", "hint": "请输入当前使用的管理密码"})); sys.exit(1)
# C-2 收尾：原密码验证通过即清零暴破计数——否则陈旧计数无限期累积，
# 零散输错累计 5 次（哪怕中间成功改过密）也会误触锁（与 auth-verify 成功路径同语义）
pf_save({"fails": 0, "lock_until": 0})
if not (8 <= len(new) <= 32):
    print(json.dumps({"ok": False, "code": "PW_LEN", "message": "新密码需为 8–32 位"})); sys.exit(1)
secrets["admin_pbkdf2"] = pwhash.hash_new(new)
# 轮换会话密钥：改密后所有旧会话（含可能被盗的 cookie）立即失效（审计 B-17）
secrets["session_secret"] = os.urandom(32).hex()
tmp = "/etc/dert/.secrets.tmp"
with open(tmp, "w") as f:
    json.dump(secrets, f, ensure_ascii=False, indent=1)
    f.flush(); os.fsync(f.fileno())
os.chmod(tmp, 0o600)
os.replace(tmp, "/etc/dert/secrets.json")
print(json.dumps({"ok": True, "message": "管理密码已更新"}))
PYEOF
)"
  rc=$?
  printf '%s\n' "$out"
  exit $rc
}

# ---------------------------------------------------------------------------
# 备份 / 恢复 / 恢复出厂
# ---------------------------------------------------------------------------
do_backup_create() {
  require_root
  local out_path="${1:?缺少输出路径}"
  tar -C / -czf "$out_path" \
    --exclude='var/lib/dert/backups' --exclude='var/lib/dert/lastgood' \
    --exclude='etc/dert/secrets.json' \
    etc/dert var/lib/dert/notes.json 2>/dev/null || true
  [ -s "$out_path" ] || die "BACKUP_FAIL" "备份打包失败" "请检查磁盘空间（df -h）"
  # 备份不含 secrets（已剔除）：640 归面板用户，仅供下载
  chown dert:dert "$out_path" 2>/dev/null || true
  chmod 640 "$out_path"
  ok_out "path" "$out_path"
}

do_backup_restore() {
  require_root
  acquire_lock
  local src="${1:?缺少备份文件路径}"
  [ -f "$src" ] || die "NO_FILE" "备份文件不存在"
  # 成员白名单校验——先 posixpath.normpath 归一再判断（复审 N-01：
  # `etc/dert/./secrets.json`、`etc/dert//secrets.json` 曾同时绕过
  # secrets 精确匹配与前缀白名单，而 tar 解压会自动规范化，端到端可写穿）
  verdict="$(tar -tzf "$src" 2>/dev/null | python3 -c '
import sys, posixpath
reason = "OK"
for line in sys.stdin:
    p = line.rstrip("\n")
    if not p: continue
    np = posixpath.normpath(p)
    if p.startswith("/") or ".." in p.split("/"):
        reason = "BAD"; break
    if np == "etc/dert/secrets.json":
        reason = "SECRETS"; break
    if not (np == "etc/dert" or np.startswith("etc/dert/") or np == "var/lib/dert/notes.json"):
        reason = "BAD"; break
print(reason)
')"
  case "$verdict" in
    OK) ;;
    SECRETS) die "BACKUP_SECRETS" "备份包含 secrets.json，已拒绝恢复" "secrets（密码哈希/会话密钥）不随备份流转；如需重置密码请在控制台执行 dert-priv" ;;
    *) die "BACKUP_BAD" "备份文件内容不符合 DebRT 备份格式" "请确认上传的是本系统生成的备份包（.tar.gz）" ;;
  esac
  # 拒绝符号/硬链接条目：防止"备份内软链指向 /etc"穿越写盘（审计 5.3）
  if tar -tvzf "$src" 2>/dev/null | awk '{print substr($1,1,1)}' | grep -qE '^[lh]'; then
    die "BACKUP_BAD" "备份包内含链接条目，已拒绝" "为防路径穿越，备份包只允许普通文件与目录"
  fi
  if ! tar -tzf "$src" 2>/dev/null | grep -q .; then
    die "BACKUP_BAD" "备份文件内容不符合 DebRT 备份格式" "请确认上传的是本系统生成的备份包（.tar.gz）"
  fi
  snapshot_lastgood "r$(date +%s)"
  local stage; stage="$(mktemp -d /run/dert/restore.XXXXXX)"
  # --no-same-owner：root 解压不保留包内属主；防软链/目录覆盖类穿越（审计 5.3）
  tar -C "$stage" --no-same-owner --no-overwrite-dir -xzf "$src" 2>/dev/null \
    || { rm -rf "$stage"; die "BACKUP_BAD" "备份文件解压失败（文件可能损坏）"; }
  python3 -c 'import json;json.load(open("'"$stage"'/etc/dert/config.json"))' 2>/dev/null \
    || { rm -rf "$stage"; die "BACKUP_BAD" "备份中的配置无法解析"; }
  # P3-12：结构预检——"能 json.load" 不等于"能用"：残缺/裁剪过的配置落盘后会让收敛
  # 在 netgen 里 traceback（stderr 曾被丢弃，用户只看到"配置生成失败"），或静默生成
  # 空转配置（wan.mode 为空 → WAN 口无任何地址）。落盘前用生成器的 schema 检查拦住。
  # 只查结构不查语义：存量 /25 掩码等由收敛期迁移负责，不能因噎废食拒绝恢复。
  if ! _schema_out="$(python3 "${PRIV_DIR}/netgen.py" --schema --config "$stage/etc/dert/config.json")"; then
    printf '%s\n' "$_schema_out"
    rm -rf "$stage"
    exit 1
  fi
  # 原子落盘
  if [ -d "$stage/etc/dert" ]; then
    while IFS= read -r -d '' f; do
      rel="${f#$stage/}"
      write_atomic "/${rel}" "$(stat -c %a "/$rel" 2>/dev/null || echo 600)" < "$f"
    done < <(find "$stage/etc/dert" -type f -print0)
  fi
  [ -f "$stage/var/lib/dert/notes.json" ] && write_atomic "${DERT_VAR}/notes.json" 644 < "$stage/var/lib/dert/notes.json"
  rm -rf "$stage"
  chmod 600 "$SECRETS_JSON" 2>/dev/null || true
  # 备份不含 secrets：按 secrets.json 实际内容重算 has_password（复审 N-04）
  local pw_warn=""
  python3 - <<'PYEOF'
import json
try:
    cfg = json.load(open("/etc/dert/config.json"))
    sec = json.load(open("/etc/dert/secrets.json"))
except Exception:
    raise SystemExit
has = bool(sec.get("pppoe_password"))
cfg.setdefault("wan", {})["has_password"] = has
json.dump(cfg, open("/etc/dert/config.json.new", "w"), ensure_ascii=False, indent=1)
import os
os.replace("/etc/dert/config.json.new", "/etc/dert/config.json")
PYEOF
  if [ "$(python3 -c 'import json;c=json.load(open("'"$CONFIG_JSON"'"));print(c["wan"]["mode"]=="pppoe" and not c["wan"].get("has_password"))' 2>/dev/null)" = "True" ]; then
    pw_warn="注意：备份不含宽带密码，PPPoE 拨号尚未可用——请在「网络设置 → 上网设置」重新填写宽带密码并保存"
  fi
  # 重新生成 + 应用（失败必须如实上报，审计 B-08）
  local ap; ap="$(do_apply_all 2>&1)" || { printf '%s\n' "$ap"; exit 1; }
  ok_out "message" "配置已从备份恢复并生效${pw_warn:+。}$pw_warn"
}

