# 本层只做白名单封装、状态读取与 cron 时间设定，永不直接改写 sing-box 配置。
# Tailscale 自 v0.1.32 起以 sing-box endpoint 托管：Debian 直装方案已移除。
# ---------------------------------------------------------------------------
do_singbox_ops() {
  # v0.1.85：实现搬到 priv/singbox.py（10 个子动作，可行为测试）
  exec python3 "${PRIV_DIR}/singbox.py" "$@"
}

# ---------------------------------------------------------------------------
# 管理密码
# ---------------------------------------------------------------------------
do_passwd_set() {
  require_root
  acquire_lock
  # v0.1.83：实现搬到 priv/authops.py（body 仍只经 stdin）
  exec python3 "${PRIV_DIR}/authops.py" passwd-set
}

# ---------------------------------------------------------------------------
# 备份 / 恢复 / 恢复出厂
# ---------------------------------------------------------------------------
do_backup_create() {
  # v0.1.86（P2-6）：实现搬到 priv/backupops.py（tar 仍走 CLI，不重造解包）
  require_root
  exec python3 "${PRIV_DIR}/backupops.py" create "${1:-}"
}

do_backup_restore() {
  # v0.1.86（P2-6）：实现搬到 priv/backupops.py
  require_root
  acquire_lock
  exec python3 "${PRIV_DIR}/backupops.py" restore "${1:-}"
}

do_factory_reset() {
  # v0.1.86（P2-6）：实现搬到 priv/backupops.py
  require_root
  acquire_lock
  exec python3 "${PRIV_DIR}/backupops.py" factory
}

# ---------------------------------------------------------------------------
# 升级（GitHub releases / 清单 URL）
# ---------------------------------------------------------------------------
do_upgrade_check() {
  # v0.1.89（P2-9）：实现搬到 priv/upgradeops.py
  exec python3 "${PRIV_DIR}/upgradeops.py" check
}

do_upgrade_download() {
  # v0.1.89（P2-9）：实现搬到 priv/upgradeops.py
  exec python3 "${PRIV_DIR}/upgradeops.py" download "${1:-}"
}

do_upgrade_apply() {
  # v0.1.89（P2-9）：实现搬到 priv/upgradeops.py
  # 锁与 root 检查留在 bash 侧（同 config-set / backup-restore）：
  # exec 后子进程继承 fd 9，嵌套的 apply-all 靠 _DERT_LOCK_HELD 跳过重取。
  require_root
  acquire_lock
  exec python3 "${PRIV_DIR}/upgradeops.py" apply "${1:-}"
}

# ---------------------------------------------------------------------------
# 状态（/api/status 的特权部分）
# ---------------------------------------------------------------------------
do_status() {
  # v0.1.80：实现搬到 priv/status.py（纯 Python，可行为测试）
  exec python3 "${PRIV_DIR}/status.py"
}

# ---------------------------------------------------------------------------
# 自检（安装后验证，不改系统）
# ---------------------------------------------------------------------------
do_selftest() {
  # v0.1.80：实现搬到 priv/selftest.py（纯 Python，可行为测试）
  exec python3 "${PRIV_DIR}/selftest.py"
}

# ---------------------------------------------------------------------------
# 分发
# ---------------------------------------------------------------------------
case "$CMD" in
  auth-verify)     do_auth_verify ;;
  session-secret)  do_session_secret ;;
  config-get)      do_config_get ;;
  config-set)      do_config_set "$@" ;;
  apply-all)       do_apply_all "$@" ;;
  service-ctl)     do_service_ctl "$@" ;;
  podman-ops)      do_podman_ops "$@" ;;
  singbox-ops)     do_singbox_ops "$@" ;;
  passwd-set)      do_passwd_set ;;
  backup-create)   do_backup_create "$@" ;;
  backup-restore)  do_backup_restore "$@" ;;
  factory-reset)   do_factory_reset ;;
  upgrade-check)   do_upgrade_check ;;
  upgrade-download) do_upgrade_download "$@" ;;
  upgrade-apply)   do_upgrade_apply "$@" ;;
  status)          do_status ;;
  selftest)        do_selftest ;;
  # v0.1.81（P4）：结构化健康检查，退出码 0/1，供监控直接消费
  health)          exec python3 "${PRIV_DIR}/health.py" "$@" ;;
  *)               die "USAGE" "未知子命令：${CMD:-（空）}" "合法子命令见安装文档" ;;
esac
