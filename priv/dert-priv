#!/usr/bin/env bash
# ============================================================================
# DebRT 特权入口 —— 面板经 sudo 白名单唯一直达的 root 脚本。
#
# v0.1.91 起这里只剩**分发 + 权限 + 锁**：所有域的实现都在 priv/*.py
# （configops / applyops / upgradeops / backupops / container / singbox /
#   authops / miscops / status / selftest / health）。
# 为什么不把这一层也换成 Python：sudoers 白名单、升级通道的自我替换、
# 真机已部署的路径都指向这个文件——**入口本身不能成为重构的风险点**。
#
# 安全设计：
#   * 子命令白名单分发，绝不 eval 用户输入；
#   * 敏感数据（密码）只经 stdin 传递，不出现在参数/日志/回显；
#   * 配置变更一律「校验 → 快照 → 原子写 → 预检 → 应用 → 验证 → 失败回滚」，
#     并以可操作的 JSON 错误返回（协议见 priv/lib.sh）；
#   * 与 sing-box / podman 的共存契约见 COEXISTENCE.md（tailscale 自 0.1.32 起
#     以 sing-box endpoint 托管，本层不再管理 tailscaled）：本脚本只操作自己的
#     nft 表 inet dert_base，永不 flush ruleset，永不 restart sing-box。
#
# 锁为什么留在这层：exec 之后子进程继承 fd 9，嵌套调用（备份恢复内部再跑
# apply-all、升级后内联收敛）靠 _DERT_LOCK_HELD 跳过重取——语义与拆分前逐字一致。
# ============================================================================
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
PRIV_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=lib.sh
source "${PRIV_DIR}/lib.sh"

CMD="${1:-}"; [ $# -gt 0 ] && shift

case "$CMD" in
  # ---- 认证 / 密码（密码只经 stdin）----
  auth-verify)      exec python3 "${PRIV_DIR}/authops.py" verify ;;
  passwd-set)       require_root; acquire_lock
                    exec python3 "${PRIV_DIR}/authops.py" passwd-set ;;
  session-secret)   exec python3 "${PRIV_DIR}/miscops.py" session-secret ;;

  # ---- 配置 ----
  config-get)       exec python3 "${PRIV_DIR}/miscops.py" config-get ;;
  config-set)       [ -n "${1:-}" ] || die "USAGE" "缺少配置段名称"
                    require_root; acquire_lock
                    exec python3 "${PRIV_DIR}/configops.py" set "$1" ;;

  # ---- 收敛（开机 / 定时 / 保存后）----
  apply-all)        require_root
                    mkdir -p "${FSROOT}/run/dert-dns" "${DERT_RUN}"
                    acquire_lock
                    exec python3 "${PRIV_DIR}/applyops.py" "${1:-}" ;;

  # ---- 外部件的服务开关 ----
  service-ctl)      exec python3 "${PRIV_DIR}/miscops.py" service-ctl "${1:-}" "${2:-}" ;;
  podman-ops)       exec python3 "${PRIV_DIR}/container.py" "$@" ;;
  podman-update)    exec python3 "${PRIV_DIR}/container.py" container "${1:-}" update ;;
  singbox-ops)      exec python3 "${PRIV_DIR}/singbox.py" "$@" ;;

  # ---- 备份 / 恢复 / 出厂 ----
  backup-create)    require_root
                    exec python3 "${PRIV_DIR}/backupops.py" create "${1:-}" ;;
  backup-restore)   require_root; acquire_lock
                    exec python3 "${PRIV_DIR}/backupops.py" restore "${1:-}" ;;
  factory-reset)    require_root; acquire_lock
                    exec python3 "${PRIV_DIR}/backupops.py" factory ;;

  # ---- 升级（唯一会替换自身的路径）----
  upgrade-check)    exec python3 "${PRIV_DIR}/upgradeops.py" check ;;
  upgrade-download) exec python3 "${PRIV_DIR}/upgradeops.py" download "${1:-}" ;;
  upgrade-apply)    require_root; acquire_lock
                    exec python3 "${PRIV_DIR}/upgradeops.py" apply "${1:-}" ;;

  # ---- 只读 ----
  status)           exec python3 "${PRIV_DIR}/status.py" ;;
  selftest)         exec python3 "${PRIV_DIR}/selftest.py" ;;
  health)           exec python3 "${PRIV_DIR}/health.py" "$@" ;;

  *)                die "USAGE" "未知子命令：${CMD:-（空）}" "合法子命令见安装文档" ;;
esac
