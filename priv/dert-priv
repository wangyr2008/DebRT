#!/usr/bin/env bash
# ============================================================================
# DebRT 特权入口 —— 面板经 sudo 白名单唯一直达的 root 脚本。
#
# 安全设计：
#   * 子命令白名单分发，绝不 eval 用户输入；
#   * 敏感数据（密码）只经 stdin 传递，不出现在参数/日志/回显；
#   * 所有配置变更：校验 → lastgood 快照 → 原子写 → 语法预检 → 应用 → 验证 →
#     失败自动回滚，并以可操作的 JSON 错误返回；
#   * 与 sing-box / podman 的共存契约见 COEXISTENCE.md（tailscale 自 0.1.32 起
#     以 sing-box endpoint 托管，本层不再管理 tailscaled）：
#     本脚本只操作自己的 nft 表 inet dert_base，永不 flush ruleset，
#     永不 restart sing-box。
# ============================================================================
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
PRIV_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=lib.sh
source "${PRIV_DIR}/lib.sh"

CMD="${1:-}"; [ $# -gt 0 ] && shift

# 管理密码哈希记录解析：兼容 "pbkdf2$iters$salt$hash"（旧4段）与
# "pbkdf2$sha256$iters$salt$hash"（新5段，算法显式）。历史缺陷：4 段格式的
# 首段"pbkdf2"曾被当成摘要算法名传给 pbkdf2_hmac → 必抛异常 → 永远登录失败（五审 P-02）。
# 密码记录解析/校验见 priv/pwhash.py（Python 模块，auth-verify / passwd-set / install.sh 共用；
# 此前曾误写成 Bash 函数并在 Python heredoc 里调用 → NameError → 登录必失败，六审 P-02）

