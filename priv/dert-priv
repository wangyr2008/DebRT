# ---------------------------------------------------------------------------
# 配置写入 + 应用（核心流水线）
# ---------------------------------------------------------------------------
do_config_set() {
  local section="${1:-}"
  [ -n "$section" ] || die "USAGE" "缺少配置段名称"
  require_root
  acquire_lock

  local in_json norm tag stage man_json pre_wan acts failed
  in_json="$(mktemp ${DERT_RUN}/in.XXXXXX)"
  cat > "$in_json"

  # 1) 校验与规范化（失败时 validate.py 直接输出可操作的 JSON 错误）
  if ! norm="$(python3 "${PRIV_DIR}/validate.py" "$section" < "$in_json")"; then
    printf '%s\n' "$norm"; rm -f "$in_json"; exit 1
  fi

  # 1.5) 仅保存升级源：不涉及网络应用（norm 写临时文件再传，与主路径一致——
  # 此前把 norm JSON 字符串当文件路径 open()，保存静默失败，真机实测）
  if [ "$section" = "upgrade" ]; then
    local norm_file
    norm_file="$(mktemp ${DERT_RUN}/norm.XXXXXX)"
    chmod 600 "$norm_file"
    printf '%s' "$norm" > "$norm_file"
    if ! python3 - "$in_json" "$norm_file" <<'PYEOF'
import os as _o; E = _o.environ.get("DERT_ETC", "/etc/dert"); V = _o.environ.get("DERT_VAR", "/var/lib/dert"); R = _o.environ.get("DERT_RUN", "/run/dert")
import json, sys, os
in_file, norm_file = sys.argv[1], sys.argv[2]
norm = json.load(open(norm_file))["data"]
cfg = json.load(open(E + "/config.json"))
cfg["upgrade"] = norm
tmp = E + "/.config.tmp"
json.dump(cfg, open(tmp, "w"), ensure_ascii=False, indent=1)
os.chmod(tmp, 0o644)
os.replace(tmp, E + "/config.json")
PYEOF
    then
      rm -f "$in_json" "$norm_file"
      die "MERGE" "升级源保存失败" "请重试；若持续出现请截图反馈"
    fi
    rm -f "$in_json" "$norm_file"
    ok_out "message" "升级源已保存"
    exit 0
  fi

  # 2) 快照 + 合并（密码只进 secrets；规范化结果写临时文件再传入，不进 argv —— 审计 B-15，
  #    同时修复审计遗漏的缺陷：norm 此前被当文件路径 open()，真实模式 config-set 必失败）
  local old_mode
  old_mode="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("mode",""))' 2>/dev/null || echo "")"
  local old_user
  old_user="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("username","") or "")' 2>/dev/null || echo "")"
  tag="s$(date +%s%N | tail -c 9)"
  snapshot_lastgood "$tag"
  local new_cfg new_sec norm_file
  new_cfg="$(mktemp ${DERT_RUN}/cfg.XXXXXX)"
  new_sec="$(mktemp ${DERT_RUN}/sec.XXXXXX)"
  norm_file="$(mktemp ${DERT_RUN}/norm.XXXXXX)"
  chmod 600 "$new_sec" "$norm_file"
  printf '%s' "$norm" > "$norm_file"
  if ! python3 - "$section" "$in_json" "$norm_file" "$new_cfg" "$new_sec" <<'PYEOF'
import os as _o; E = _o.environ.get("DERT_ETC", "/etc/dert"); V = _o.environ.get("DERT_VAR", "/var/lib/dert"); R = _o.environ.get("DERT_RUN", "/run/dert")
import json, sys
section, in_file, norm_file, out_cfg, out_sec = sys.argv[1:6]
cfg = json.load(open(E + "/config.json"))
sec_in = json.load(open(in_file))
norm = json.load(open(norm_file))["data"]
try:
    secrets = json.load(open(E + "/secrets.json"))
except Exception:
    secrets = {}
if section == "bind":
    cfg["ports"] = norm
elif section == "wan":
    pwd = norm.pop("password", None)
    for k in ("mode", "username", "dns_mode", "dns", "ip", "mask", "gw"):
        cfg.setdefault("wan", {})[k] = norm[k]
    if pwd:
        secrets["pppoe_password"] = pwd
        cfg["wan"]["has_password"] = True
elif section == "ipv6":
    cfg["ipv6"] = norm
elif section == "lan":
    cfg["lan"] = norm
elif section == "dhcp":
    cfg["dhcp"] = norm
elif section == "static":
    cfg["static"] = norm
elif section == "qos":
    cfg["qos"] = norm
elif section == "firewall":
    if "wan_input_drop" in sec_in:
        cfg.setdefault("firewall", {})["wan_input_drop"] = norm["wan_input_drop"]
    if "portfw" in sec_in:
        cfg["firewall"]["portfw"] = norm["portfw"]
elif section == "upgrade":
    cfg["upgrade"] = norm
else:
    sys.exit(9)
json.dump(cfg, open(out_cfg, "w"), ensure_ascii=False, indent=1)
if secrets:
    json.dump(secrets, open(out_sec, "w"), ensure_ascii=False, indent=1)
PYEOF
  then
    restore_lastgood "$tag"; rm -f "$in_json" "$new_cfg" "$new_sec" "$norm_file"
    die "MERGE" "配置合并失败" "本次修改未生效；请刷新页面重试"
  fi

  # 3) 先采样 + 落盘：netgen 读固定路径 /etc/dert/config.json，必须让它在
  #    生成前看到"新配置"，否则每次保存生效的都是上一版（复审 v0.1.2 P-01）
  #    pre_wan 语义仍是"改动前 WAN 是否可用"（审计 B-03），在写盘前采样
  pre_wan="$(wan_route_ok)"
  write_atomic "$CONFIG_JSON" 644 < "$new_cfg"
  [ -s "$new_sec" ] && write_atomic "$SECRETS_JSON" 600 < "$new_sec"

  # 4) 用新配置生成 + 预检。此时原生文件尚未部署，失败回滚后系统与旧配置完全一致（安全）
  stage="$(mktemp -d ${DERT_RUN}/stage.XXXXXX)"
  man_json="$stage/manifest.json"
  if ! python3 "${PRIV_DIR}/netgen.py" --stage "$stage" > "$man_json"; then
    cat "$man_json"
    restore_lastgood "$tag"; rm -rf "$stage" "$in_json" "$new_cfg" "$new_sec" "$norm_file"
    exit 1
  fi
  if ! pf_out="$(preflight_stage "$stage")"; then
    printf '%s\n' "$pf_out"
    restore_lastgood "$tag"; rm -rf "$stage" "$in_json" "$new_cfg" "$new_sec" "$norm_file"
    exit 1
  fi

  # 5) 部署生成文件 + 重启受影响服务
  rm -f "$in_json" "$new_cfg" "$new_sec" "$norm_file"
  apply_stage_files "$stage" "$man_json"
  cleanup_stale_generated "$man_json"
  rm -rf "$stage"
  acts="$(plan_for_section "$section")"
  # 仅在模式/账号变化或网口重绑定时才重拨 PPPoE（避免改个 DNS 就断线重连）
  local new_mode new_user pppoe_needed="no"
  new_mode="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("mode",""))')"
  new_user="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("username","") or "")')"
  [ "$old_mode" != "$new_mode" ] && pppoe_needed="yes"
  [ "$old_user" != "$new_user" ] && pppoe_needed="yes"  # P2-2：改账号此前不重拨，pppd 仍持旧凭据会话
  [ "$section" = "bind" ] && [ "$new_mode" = "pppoe" ] && pppoe_needed="yes"
  # PPPoE 下 IPv6 设置变更需要重拨：+ipv6/IPv6CP 与 ppp0 上的 DHCPv6 客户端随重拨生效
  [ "$section" = "ipv6" ] && [ "$new_mode" = "pppoe" ] && pppoe_needed="yes"
  if [ "$section" = "wan" ] && printf '%s' "$norm" | python3 -c 'import json,sys;sys.exit(0 if json.load(sys.stdin).get("data",{}).get("password") else 1)' 2>/dev/null; then
    pppoe_needed="yes"
  fi
  if [ "$pppoe_needed" != "yes" ]; then
    acts="$(printf '%s\n' $acts | grep -v '^pppoe$' | tr '\n' ' ')"
  fi
  failed="$(run_actions "$acts")"

  # 6) 验证
  local mode wan_to tmo err_hint=""
  mode="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("mode",""))')"
  if ! wait_dnsmasq 10; then
    err_hint="dnsmasq 未能启动：journalctl -u dnsmasq -n 30"
    failed="$failed dnsmasq"
  elif [ "$section" = "wan" ] || [ "$pre_wan" = "yes" ]; then
    # 上网设置无条件验证：首次配置 PPPoE 时 pre_wan=no，恰恰是最需要报错的场景（审计 B-03）
    if [ "$section" = "wan" ] && [ "$mode" = "pppoe" ]; then tmo=45; else tmo=25; fi
    if ! wait_wan "$tmo"; then
      if [ "$mode" = "pppoe" ]; then
        if journalctl -u dert-pppoe.service -n 40 --no-pager 2>/dev/null | grep -qiE "PAP authentication failed|CHAP authentication failed|authentication failed"; then
          err_hint="PPPoE 拨号被服务器拒绝（认证失败）：请检查宽带账号/密码是否正确；若账号正在其他设备上拨号，请先断开再试"
        elif journalctl -u dert-pppoe.service -n 40 --no-pager 2>/dev/null | grep -qiE "timeout|LCP: timeout|No response"; then
          err_hint="PPPoE 服务器无响应：请确认光猫已改为桥接模式、WAN 线已插在绑定的 WAN 口上"
        else
          err_hint="PPPoE 未能在预期时间内建立连接：journalctl -u dert-pppoe -n 40 查看详情"
        fi
      else
        err_hint="应用后 WAN 未能恢复连接：请检查上级网络/网线；可尝试在「网络设置」重新保存上网设置"
      fi
      failed="$failed wan"
    fi
  fi

  if [ -n "$failed" ] || [ -n "$err_hint" ]; then
    # 回滚到修改前配置并重放
    restore_lastgood "$tag"
    local stage2 man2
    stage2="$(mktemp -d ${DERT_RUN}/stage.XXXXXX)"
    man2="$stage2/manifest.json"
    if python3 "${PRIV_DIR}/netgen.py" --stage "$stage2" > "$man2" 2>/dev/null; then
      apply_stage_files "$stage2" "$man2"
      cleanup_stale_generated "$man2"
      run_actions "$(plan_for_section "$section")" >/dev/null 2>&1 || true
    fi
    rm -rf "$stage2"
    [ -z "$err_hint" ] && err_hint="已自动恢复到修改前的可用配置，未生效的修改请检查后重试"
    die "APPLY_ROLLED_BACK" "配置未能安全生效，已自动回滚" "$err_hint"
  fi

  # 7) 回应（WAN 方式切换给 sing-box 用户一句提示）
  local msg="配置已保存并生效" hint_sb=""
  if [ "$section" = "wan" ] && systemctl is-enabled --quiet sing-box.service 2>/dev/null; then
    hint_sb="若已启用 sing-box，建议执行 sb restart 重新绑定出口接口"
  fi
  if [ "$section" = "lan" ]; then
    msg="LAN 设置已生效；若管理地址已变化，请使用新 IP 重新登录"
  fi
  ok_out "message" "$msg" "hint_singbox" "$hint_sb"
}

