#!/usr/bin/env bash
# dns-split-sync —— 把 include_mac_address 派生为 nft 的 DNS 分流表
#
# 由 sing-box.service 的 ExecStartPost 调用（root，因为要写 nft）。
#
# 为什么需要它：sing-box 的 DNS 规则拿不到源 MAC（实测：即使包经 tun 进来、
# 日志里已有 found neighbor，source_mac_address 在 DNS 规则里依然不匹配），
# 所以「哪台设备的 DNS 走哪条路」只能在 nft 层用 ether saddr 判断。
#
# 数据源只有一个：/etc/sing-box/config.json 里 tun.include_mac_address
# （由 sub-store 模板维护）。本脚本只读不写，加设备只改那一处。
#
# 行为矩阵（v0.1.64 起方向与旧版相反，勿按旧记忆理解）：
#   include_mac_address 为空/缺失 → 不建表：所有 DNS 都到 dnsmasq:53 拿真实 IP，
#     但 tun 的 include_mac_address 为空又意味着「不限 MAC」= 全部流量仍进 tun。
#     这是个退化组合（没有 fakeip 就反查不出域名，只能靠 IP 规则路由），实际不会这么配。
#   include_mac_address 有值      → 建表：
#       白名单   → DNAT 到 br-lan:5353（sing-box direct inbound → hijack-dns → fakeip）
#       非白名单 → DNAT 到 br-lan:53  （dnsmasq → 运营商 → 真实 IP，完全不进 sing-box）
#     写 ["00:00:00:00:00:00"] 这种哨兵 = 所有真实设备都落在「非白名单」= 全部直连。
set -u

# 测试缝（v0.1.75）：DERT_FSROOT 未设时是空串，${FSROOT}/etc/... 与原绝对路径
# 完全等价，生产行为一字不变；设了就指向临时根，能在无 root 环境跑完整逻辑。
# 这是 P1-2 的前提——把"源码里有没有某个字符串"换成"实际生成了什么规则"。
FSROOT="${DERT_FSROOT:-}"
CONF="${FSROOT}/etc/sing-box/config.json"
[ -f "$CONF" ] || exit 0

# 只在 sing-box 真的活着时建表——否则表指向没人监听的地址，全网断 DNS。
# 注意：ExecStartPost 执行的那一刻 unit 还是 activating（不是 active），
# 只判 active 会直接退出、表永远建不起来（真机首测踩到）。
STATE=$(systemctl is-active sing-box.service 2>/dev/null)
case "$STATE" in
    active|activating|reloading) ;;
    *) exit 0 ;;
esac

# 等 5353 真正在监听——这才是「白名单 DNS 能解析」的前提。
#
# 旧代码等的是 tun 接口出现，那只是个代理指标：tun 建好不等于 5353 已 bind，
# 反过来 5353 也可能先于 tun 就绪。而且本表的目标地址全在 br-lan 上，
# 根本不引用 tun 接口。改成检查真实前提，语义更准，超时也能短很多。
#
# 这里没法做成事件驱动：监听套接字不产生 netlink 事件，sing-box 也不支持
# sd_notify。业界对此的通行做法就是有界等待（等自己的服务 bind 端口）。
i=0
while [ "$i" -lt 10 ]; do
    ss -lnu 2>/dev/null | grep -q ':5353' && break
    sleep 1; i=$((i + 1))
done
ss -lnu 2>/dev/null | grep -q ':5353' || exit 0

# 从 config.json 读白名单列表（sub-store 维护的唯一数据源）
#
# v0.1.65 起不再读 tun 的 DNS 地址：白名单的 DNS 目标是 br-lan 的 53 端口 + :5353，
# 与非白名单的 dnsmasq:53 同在一台机器上，跟 tun 的内部地址无关。
# MAC 统一成小写冒号格式再拼进 nft 规则。
# include_mac_address 来自 sub-store 下发的配置，写法不受控：sing-box 用 Go 的
# net.ParseMAC，AA-BB-CC-DD-EE-FF / aabb.ccdd.eeff 都收；nft 只认冒号分隔。
# 不规范化的话整张表建不起来（报错被吞掉），静默回落到 dnsmasq——白名单设备
# 拿不到 fakeip，分流悄悄失效，日志里只有一条 table_build_failed（审计 RT-09）。
WLS=$(python3 - "$CONF" <<'PYEOF'
import json, re, sys

try:
    c = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)

for ib in c.get("inbounds", []):
    if ib.get("type") == "tun":
        out, bad = [], []
        for m in ib.get("include_mac_address") or []:
            s = re.sub(r"[^0-9a-fA-F]", "", str(m)).lower()
            if len(s) == 12:
                mac = ":".join(s[i:i + 2] for i in range(0, 12, 2))
                if mac not in out:
                    out.append(mac)
            else:
                bad.append(str(m))
        if bad:
            # 走 stderr 进 journal：丢掉一台白名单设备必须能查到
            sys.stderr.write("dert-dns-split: 无法识别的 MAC 已忽略: %s\n"
                             % ", ".join(bad[:5]))
        print(",".join(out))
        break
PYEOF
)

# 白名单为空 / br-lan 没有 IPv4：这两个条件只影响 pre 链（局域网设备的 DNS），
# **不影响 out 链**（本机 DNS）。早期版本在这里直接 exit，结果是白名单一清空、
# 或 br-lan 短暂没有 v4，本机 DNS 就悄悄退回运营商——而 v0.1.135 的本机 DNS
# 并不依赖这两者，属于行为回退（审计 §C2）。现在改成「只决定生成哪条链」。
WLS_EMPTY=0
[ -z "$WLS" ] && WLS_EMPTY=1

# 白名单的 DNS 转到本机 5353（sing-box），非白名单转到 53（dnsmasq）。
# 两者同机不同端口，靠 MAC 决定去向。
#
# LAN4 只用来判断「br-lan 是否已经有 IPv4」——没地址时建表没有意义（客户端
# 也连不上来）。它**不再**是 DNAT 的目标地址：改用 redirect 之后，目标由内核
# 按入接口选（见下方建表注释），v6 的 ::1 兜底问题从根上没有了。
LAN4=$(ip -4 addr show dev br-lan 2>/dev/null \
       | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }
              $3 == "inet" { split($4, a, "/"); print a[1]; exit }')
LAN4_EMPTY=0
[ -z "$LAN4" ] && LAN4_EMPTY=1

# 记录前缀基线 /run/dert/lan-prefix，供 90-dert-lan-prefix 判断"前缀是否变了"。
#
# 为什么必须在这里写（ExecStartPost，root），而不是等 dispatcher 钩子写：
#   开机时 routable 事件常早于 PD 委派——钩子的 lan_prefix() 只取 scope global，
#   此刻为空，15 秒等待超时后静默 exit 0，基线从此缺失。下次换前缀时 OLD 为空，
#   被误判成"首次记录"→ 只写记录就退出 → 既不 prepare 也不重启 sing-box →
#   00-dert-dns.json 停在旧前缀（真机 2026-11-11 重启复现：cidr 只剩 v4，
#   非白名单设备的 AAAA 落到 fakeip → v6 黑洞）。
#   基线取「br-lan 当前全部全局前缀」的集合，与钩子的 lan_prefix() **逐字同构**。
#   以前两边各算一套（这里从 LAN6 单个地址推、那边 awk 取前 4 段），结果是：
#     · 压缩写法的地址在钩子那边变成 fda1:9e3a:8b7f:::/64（非法值），永远对不上；
#     · br-lan 同时有两个全局前缀时，两边集合大小不同，也会互相判成"变了"。
#   两种都会导致「前缀变了」→ 废弃正在用的前缀 + 反复重启 sing-box（审计 RT-01）。
PREFIX6=$(ip -6 addr show dev br-lan scope global 2>/dev/null | python3 -c '
import sys, ipaddress
out = set()
for line in sys.stdin:
    p = line.split()
    if len(p) > 1 and p[0] == "inet6":
        try:
            out.add(str(ipaddress.ip_interface(p[1].split("/")[0] + "/64").network))
        except ValueError:
            pass
print(" ".join(sorted(out)))
' 2>/dev/null)
if [ -n "$PREFIX6" ]; then
    mkdir -p "${FSROOT}/run/dert" 2>/dev/null
    # 原子写：钩子可能并发读，不能让它读到半个前缀
    if printf '%s\n' "$PREFIX6" > "${FSROOT}/run/dert/lan-prefix.tmp" 2>/dev/null; then
        mv -f "${FSROOT}/run/dert/lan-prefix.tmp" "${FSROOT}/run/dert/lan-prefix" 2>/dev/null
    fi
fi

# 拼 MAC 集合：0c:19:...,44:59:...
SET="{ $(printf '%s' "$WLS" | tr ',' ' ' | tr ' ' '\n' | sed '/^$/d' | paste -sd, -) }"

# pre 链：白名单与 br-lan 的 v4 都就绪才生成（缺一个，局域网设备的 DNS 就没法分流）
PRE_CHAIN=""
if [ "$WLS_EMPTY" = 0 ] && [ "$LAN4_EMPTY" = 0 ]; then
    PRE_CHAIN=$(cat <<PRE
    chain pre {
        type nat hook prerouting priority dstnat - 2; policy accept;

        # 用 redirect 而不是 dnat to <LAN 地址>：目标地址由内核按**入接口**选，
        # 不再需要在 shell 里算 LAN4/LAN6。旧写法有两个坑：
        #   · br-lan 没有全局 v6 时（PD 未下发 / 只有 /64 委派），LAN6 兜底成 ::1，
        #     而 IPv6 不允许把外部进来的包转发到回环，DNAT 后的包被内核丢掉 →
        #     局域网的 v6 DNS 全部超时，解析要等回落到 v4（审计 RT-08）；
        #   · 地址一变就要重建表（netwatch 的对账逻辑）。
        # redirect 只改端口、不动地址：客户端发给路由器的链路本地地址也照样成立。
        iifname "br-lan" ether saddr $SET meta l4proto { tcp, udp } th dport 53 counter redirect to :5353
        iifname "br-lan" ether saddr != $SET meta l4proto { tcp, udp } th dport 53 counter redirect to :53
    }
PRE
)
fi

# 本机 DNS 入口（v0.1.136）：把本机发往 127.0.0.1:53 / [::1]:53 的查询也 redirect
# 到 5353，和局域网白名单设备走同一条路。这样 resolv.conf 只剩一行 127.0.0.1，
# 不再需要 127.0.0.2 和「两个 nameserver + glibc 换下一个」那套回落。
#
# **只管 resolv.conf 路径**：本链只匹配目标 127.0.0.1 / ::1，所以只接管读
# resolv.conf 的程序。显式 `dig @8.8.8.8` 这类指定外部服务器的查询不会被改写
# （它走 dns_bypass 的直连豁免，拿到运营商结果）。白名单设备不同——它们的查询
# 目标就是路由器，被 pre 链统一转到 5353。这个差异是设计，不是 bug：用户明确
# 指定了服务器，路由器不该偷偷改写。**别把它当 bug「修」。**
#
# **优先级依赖（隐式，改之前务必看）**：本链是 `dstnat - 2`（−102），而 sing-box
# 自己的 `output_udp_icmp` 是 `mangle + 2`（−148）。−148 更小、**先执行**，它把
# 目标为本地地址（`127.0.0.0/8`，来自 `inet4_local_address_set`）的包 return 掉，
# 本机 DNS 才会落到这里。如果哪天那个集合丢了 127.0.0.0/8，或者有人把本链的
# 优先级调到 −148 之前，本机 DNS 会被 sing-box 抢先 redirect 到 :42493（代理
# 入口），表现为「DNS 解析全挂」。建表后下面的检查会把这个前提记进日志。
#
# 必须排除 sing-box 自己：config.json 模板里有 type: local 的 DNS server，它会读
# resolv.conf 再查 127.0.0.1——不排除就是「查询 → redirect 5353 → 再查 127.0.0.1」
# 的死循环（真机验证时用 setpriv 复现过）。
#
# uid 查不到（用户被删/改名）时不建 out 链：本机继续走 dnsmasq，退化成「没有
# sing-box」的状态。这比把本机 DNS 指到一个没人监听的端口安全。
SB_UID=$(id -u sing-box 2>/dev/null || true)
OUT_CHAIN=""
if [ -n "$SB_UID" ]; then
    OUT_CHAIN=$(cat <<CHAIN
    chain out {
        type nat hook output priority dstnat - 2; policy accept;

        # 排除 sing-box 自身（它的 local DNS server 会查 127.0.0.1，不排除会死循环）
        meta skuid $SB_UID return

        # 本机查询统一进 5353；v6 的 ::1 也一起，补上 dns-self 时代缺的 v6 通道
        ip  daddr 127.0.0.1 meta l4proto { tcp, udp } th dport 53 counter redirect to :5353
        ip6 daddr ::1       meta l4proto { tcp, udp } th dport 53 counter redirect to :5353
    }
CHAIN
)
else
    logger -t dert-dns-split "event=local_entry_skipped reason=no_singbox_uid"
fi

# 两条链都生成不了（白名单空或无 LAN4，且查不到 sing-box uid）：不建表，
# 全部 DNS 回到 dnsmasq。这是唯一应该「删表退出」的情形。
if [ -z "$PRE_CHAIN" ] && [ -z "$OUT_CHAIN" ]; then
    nft delete table inet dert_dns 2>/dev/null
    logger -t dert-dns-split "event=table_skipped reason=no_pre_no_out fallback=dnsmasq"
    exit 0
fi

# 一次性加载整张表：nft 的批量加载是原子的，中途失败不会留下半张表。
#
# 开头的 add + delete 是「原子替换」的固定写法，不能省：
# 直接写 `table inet dert_dns { ... }` 对**已存在**的表是**追加规则**，
# 不是替换 —— 每跑一次就多 4 条（真机 2026-11-12 实测：netwatch 在运行期
# 触发几次后表里堆到 20 条，最后几条还指向已删除的临时地址）。
# add 是幂等的（表在不在都成功），delete 清空，随后的定义重建，
# 三步在同一个事务里提交，对外仍是原子的。
if ! nft -f - <<EOF 2>/dev/null
add table inet dert_dns
delete table inet dert_dns
table inet dert_dns {
$PRE_CHAIN
$OUT_CHAIN
}
EOF
then
    # 建表失败：删掉可能的残留，让所有 DNS 回落到 dnsmasq（安全方向）
    nft delete table inet dert_dns 2>/dev/null
    logger -t dert-dns-split "event=table_build_failed fallback=dnsmasq"
    exit 0
fi

# 建表后确认「优先级依赖」的前提成立：sing-box 的本地地址集合必须包含
# 127.0.0.1 / ::1，否则它的 output_udp_icmp 不会把本机 DNS 放行到我们这条链
# （会抢先 redirect 到 :42493）。只写日志、不阻断——集合缺失是 sing-box 侧的
# 问题，表本身没有错，而且下次 sing-box 重启会重建集合。
if [ -n "$OUT_CHAIN" ]; then
    for probe in "inet4_local_address_set 127.0.0.1" "inet6_local_address_set ::1"; do
        set_name=${probe% *}; addr=${probe#* }
        nft get element inet sing-box "$set_name" "{ $addr }" >/dev/null 2>&1 \
            || logger -t dert-dns-split "event=local_set_missing set=$set_name addr=$addr"
    done
fi

# 用 awk 数字段：tr | wc -l 数的是换行符，最后一项没有换行会少算一台（真机首测踩到）
# 白名单为空时 awk 对空串会返回 1，这里显式给 0。
COUNT=0
[ -n "$WLS" ] && COUNT=$(printf '%s' "$WLS" | awk -F, '{print NF}')
PRE_FLAG=0; [ -n "$PRE_CHAIN" ] && PRE_FLAG=1
OUT_FLAG=0; [ -n "$OUT_CHAIN" ] && OUT_FLAG=1
logger -t dert-dns-split "event=table_rebuilt whitelist=$COUNT pre=$PRE_FLAG out=$OUT_FLAG"
exit 0
