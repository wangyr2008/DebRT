#!/usr/bin/env bash
# dns-split-sync —— 把 include_mac_address 派生为 nft 的 DNS 分流表
#
# 由 sing-box.service 的 ExecStartPost 调用（root，因为要写 nft）。
#
# 为什么需要它：sing-box 的 DNS 规则拿不到源 MAC（实测：即使包经 tun 进来、
# 日志里已有 found neighbor，source_mac_address 在 DNS 规则里依然不匹配），
# 所以「哪台设备的 DNS 走哪条路」只能在 nft 层用 ether saddr 判断。
#
# 数据源只有一个：/etc/sing-box/config.json 里 tun.include_mac_address
# （由 sub-store 模板维护）。本脚本只读不写，加设备只改那一处。
#
# 行为矩阵（v0.1.64 起方向与旧版相反，勿按旧记忆理解）：
#   include_mac_address 为空/缺失 → 不建表：所有 DNS 都到 dnsmasq:53 拿真实 IP，
#     但 tun 的 include_mac_address 为空又意味着「不限 MAC」= 全部流量仍进 tun。
#     这是个退化组合（没有 fakeip 就反查不出域名，只能靠 IP 规则路由），实际不会这么配。
#   include_mac_address 有值      → 建表：
#       白名单   → DNAT 到 br-lan:5353（sing-box direct inbound → hijack-dns → fakeip）
#       非白名单 → DNAT 到 br-lan:53  （dnsmasq → 运营商 → 真实 IP，完全不进 sing-box）
#     写 ["00:00:00:00:00:00"] 这种哨兵 = 所有真实设备都落在「非白名单」= 全部直连。
set -u

CONF=/etc/sing-box/config.json
[ -f "$CONF" ] || exit 0

# 只在 sing-box 真的活着时建表——否则表指向没人监听的地址，全网断 DNS。
# 注意：ExecStartPost 执行的那一刻 unit 还是 activating（不是 active），
# 只判 active 会直接退出、表永远建不起来（真机首测踩到）。
STATE=$(systemctl is-active sing-box.service 2>/dev/null)
case "$STATE" in
    active|activating|reloading) ;;
    *) exit 0 ;;
esac

# tun 可能还在初始化（ExecStartPost 紧跟启动），最多等 20 秒
i=0
while [ "$i" -lt 20 ]; do
    ip link show tun0 >/dev/null 2>&1 && break
    sleep 1; i=$((i + 1))
done
ip link show tun0 >/dev/null 2>&1 || exit 0

# 从 config.json 读白名单列表（sub-store 维护的唯一数据源）
#
# v0.1.65 起不再读 tun 的 DNS 地址：白名单的 DNS 目标是 br-lan 的 53 端口 + :5353，
# 与非白名单的 dnsmasq:53 同在一台机器上，跟 tun 的内部地址无关。
WLS=$(python3 - "$CONF" <<'PYEOF'
import json, sys

try:
    c = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)

for ib in c.get("inbounds", []):
    if ib.get("type") == "tun":
        print(",".join(ib.get("include_mac_address") or []))
        break
PYEOF
)

# 白名单为空：不建表。所有 DNS 走 dnsmasq:53（真实 IP）。
# 注意此时 tun 的 include_mac_address 也为空 = 不限 MAC = 流量仍全部进 tun，
# 但没有 fakeip 就反查不出域名，只能靠 IP 规则——属退化组合，保持现状不特殊处理。
if [ -z "$WLS" ]; then
    nft delete table inet dert_dns 2>/dev/null
    logger -t dert-dns-split "include_mac_address 为空，不建分流表（DNS 全部走 dnsmasq）"
    exit 0
fi

# DNAT 的目标地址都在 br-lan 上：白名单用 LAN4/LAN6 的 5353（sing-box），
# 非白名单用 LAN4/LAN6 的 53（dnsmasq）。两者同机不同端口，靠 MAC 决定去向。
# 同时兼容多行与 ip -o 单行输出：单行格式下 inet 在第 3 列
LAN4=$(ip -4 addr show dev br-lan 2>/dev/null \
       | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }
              $3 == "inet" { split($4, a, "/"); print a[1]; exit }')
[ -n "$LAN4" ] || exit 0
LAN6=$(ip -6 addr show dev br-lan scope global 2>/dev/null \
       | awk '$1 == "inet6" { split($2, a, "/"); print a[1]; exit }
              $3 == "inet6" { split($4, a, "/"); print a[1]; exit }')
[ -n "$LAN6" ] || LAN6="::1"

# 记录前缀基线 /run/dert/lan-prefix，供 90-dert-lan-prefix 判断"前缀是否变了"。
#
# 为什么必须在这里写（ExecStartPost，root），而不是等 dispatcher 钩子写：
#   开机时 routable 事件常早于 PD 委派——钩子的 lan_prefix() 只取 scope global，
#   此刻为空，15 秒等待超时后静默 exit 0，基线从此缺失。下次换前缀时 OLD 为空，
#   被误判成"首次记录"→ 只写记录就退出 → 既不 prepare 也不重启 sing-box →
#   00-dert-dns.json 停在旧前缀（真机 2026-11-11 重启复现：cidr 只剩 v4，
#   非白名单设备的 AAAA 落到 fakeip → v6 黑洞）。
#   此处 br-lan 的前缀正是 dns-split-prepare 生成 00-dert-dns.json 时用的那个前缀，
#   语义上就是"本次 sing-box 启动所用的前缀"，作为基线最准确。
if [ -n "$LAN6" ] && [ "$LAN6" != "::1" ]; then
    PREFIX6=$(printf '%s' "$LAN6" | python3 -c '
import sys, ipaddress
s = sys.stdin.read().strip()
if s:
    try:
        net = ipaddress.ip_interface(s + "/64").network
        if net.prefixlen == 64:
            print(net)      # 必须带 /64：裸地址不能与钩子的 lan_prefix() 输出比对
    except Exception:
        pass
' 2>/dev/null)
    if [ -n "$PREFIX6" ]; then
        mkdir -p /run/dert 2>/dev/null
        # 原子写：钩子可能并发读，不能让它读到半个前缀
        if printf '%s\n' "$PREFIX6" > /run/dert/lan-prefix.tmp 2>/dev/null; then
            mv -f /run/dert/lan-prefix.tmp /run/dert/lan-prefix 2>/dev/null
        fi
    fi
fi

# 拼 MAC 集合：0c:19:...,44:59:...
SET="{ $(printf '%s' "$WLS" | tr ',' ' ' | tr ' ' '\n' | sed '/^$/d' | paste -sd, -) }"

# 一次性加载整张表：nft 的批量加载是原子的，中途失败不会留下半张表
if ! nft -f - <<EOF 2>/dev/null
table inet dert_dns {
    chain pre {
        type nat hook prerouting priority dstnat - 2; policy accept;

        iifname "br-lan" ether saddr $SET meta nfproto ipv4 meta l4proto { tcp, udp } th dport 53 counter dnat ip to $LAN4:5353
        iifname "br-lan" ether saddr $SET meta nfproto ipv6 meta l4proto { tcp, udp } th dport 53 counter dnat ip6 to [$LAN6]:5353
        iifname "br-lan" ether saddr != $SET meta nfproto ipv4 meta l4proto { tcp, udp } th dport 53 counter dnat ip to $LAN4
        iifname "br-lan" ether saddr != $SET meta nfproto ipv6 meta l4proto { tcp, udp } th dport 53 counter dnat ip6 to $LAN6
    }
}
EOF
then
    # 建表失败：删掉可能的残留，让所有 DNS 回落到 dnsmasq（安全方向）
    nft delete table inet dert_dns 2>/dev/null
    logger -t dert-dns-split "建表失败，已回落 dnsmasq"
    exit 0
fi

# 用 awk 数字段：tr | wc -l 数的是换行符，最后一项没有换行会少算一台（真机首测踩到）
COUNT=$(printf '%s' "$WLS" | awk -F, '{print NF}')
logger -t dert-dns-split "DNS 分流表已重建：白名单 $COUNT 台"
exit 0
