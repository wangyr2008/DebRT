# ---------------------------------------------------------------------------
# 升级（GitHub releases / 清单 URL）
# ---------------------------------------------------------------------------
fetch_body() { # fetch_body URL -> body
  local url="$1" prefix
  for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
    curl -fsSL --connect-timeout 8 --max-time 30 "${prefix}${url}" 2>/dev/null && return 0
  done
  return 1
}
github_latest_ver() { # github_latest_ver owner/repo
  local repo="$1" prefix out ver
  for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
    out="$(curl -sIL --connect-timeout 8 --max-time 30 -o /dev/null -w '%{url_effective}' "${prefix}https://github.com/${repo}/releases/latest" 2>/dev/null || true)"
    ver="$(printf '%s' "$out" | sed -n 's#.*/tag/v\{0,1\}\([0-9][0-9.]*\).*#\1#p')"
    [ -n "$ver" ] && { printf '%s' "$ver"; return 0; }
  done
  return 1
}
cur_version() { cat "$VERSION_FILE" 2>/dev/null || cat "${SEEDROU_ROOT}/VERSION" 2>/dev/null || echo "0.0.0"; }
ver_ge() { python3 -c '
import re, sys
def parse(v):
    m = re.match(r"v?([0-9]+(?:\.[0-9]+)*)", v.strip())
    return [int(x) for x in m.group(1).split(".")] if m else [0]
a, b = parse(sys.argv[1]), parse(sys.argv[2])
n = max(len(a), len(b))
a += [0] * (n - len(a)); b += [0] * (n - len(b))
print("yes" if a >= b else "no")' "$1" "$2"; }

do_upgrade_check() {
  local src; src="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("upgrade",{}).get("source",""))' 2>/dev/null || echo "")"
  [ -n "$src" ] || die "UPG_NO_SOURCE" "尚未配置升级源" "请在「备份与升级」页填写 GitHub 仓库（如 yourname/seedrou）并保存"
  local cur latest
  cur="$(cur_version)"
  if [[ "$src" == *"://"* ]]; then
    local body
    body="$(fetch_body "$src")" || die "UPG_NET" "无法访问升级源清单" "请检查升级源 URL 与网络连通性；也可稍后重试"
    latest="$(printf '%s' "$body" | python3 -c 'import json,sys;d=json.load(sys.stdin);print(d.get("version") or d.get("tag_name") or "")' 2>/dev/null || echo "")"
    [ -n "$latest" ] || die "UPG_MANIFEST" "升级源清单格式不正确" "清单需为 JSON 且含 version 字段"
  else
    latest="$(github_latest_ver "$src")" || die "UPG_NET" "无法获取 GitHub 最新版本" "请检查仓库名（yourname/seedrou）与网络；GitHub 可能限流，可稍后重试"
  fi
  latest="${latest#v}"
  if [ "$(ver_ge "$latest" "$cur")" = "no" ] || [ "$latest" = "$cur" ]; then
    ok_out "up_to_date" "true" "current" "$cur" "latest" "$latest" "message" "已是最新版本 V${cur}"
  else
    ok_out "up_to_date" "false" "current" "$cur" "latest" "$latest" "message" "发现新版本"
  fi
}

do_upgrade_download() {
  local ver="${1:-}"
  [ -n "$ver" ] || die "USAGE" "缺少版本号"
  local src repo asset
  src="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("upgrade",{}).get("source",""))')"
  ver="${ver#v}"
  mkdir -p "${SEEDROU_VAR}/staging"
  local out="${SEEDROU_VAR}/staging/pkg.tar.gz"
  rm -f "$out" "${out}.sha256"
  local prefix base="https://github.com" rc=1
  if [[ "$src" == *"://"* ]]; then
    local body sha256=""
    body="$(fetch_body "$src")" || die "UPG_NET" "无法访问升级源"
    eval "$(printf '%s' "$body" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print("asset=" + __import__("shlex").quote(str(d.get("url", ""))))
print("sha256=" + __import__("shlex").quote(str(d.get("sha256", ""))))' 2>/dev/null)"
    [ -n "$asset" ] || die "UPG_MANIFEST" "清单缺少 url 字段"
    for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
      curl -fsSL --connect-timeout 10 --max-time 300 "${prefix}${asset}" -o "$out" 2>/dev/null && { rc=0; break; }
    done
    if [ "$rc" -eq 0 ]; then
      # sha256 强制校验（审计 B-13）：优先用清单内 sha256 字段，否则尝试 url+".sha256"
      if [ -n "$sha256" ]; then
        printf '%s  %s\n' "$sha256" "$(basename "$out")" > "${out}.sha256"
      else
        for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
          curl -fsSL --connect-timeout 10 --max-time 30 "${prefix}${asset}.sha256" -o "${out}.sha256" 2>/dev/null && [ -s "${out}.sha256" ] && break
        done
      fi
      [ -s "${out}.sha256" ] || { rm -f "$out"; die "UPG_MANIFEST" "清单式升级源未提供 sha256，拒绝安装" "请在清单 JSON 中加入 sha256 字段，或提供 <url>.sha256 文件"; }
    fi
  else
    repo="$src"
    for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
      curl -fsSL --connect-timeout 10 --max-time 300 "${prefix}${base}/${repo}/releases/download/v${ver}/seedrou-${ver}.tar.gz" -o "$out" 2>/dev/null && { rc=0; break; }
    done
    if [ "$rc" -eq 0 ]; then
      for prefix in "" "https://gh-proxy.org/" "https://gh-proxy.com/"; do
        curl -fsSL --connect-timeout 10 --max-time 30 "${prefix}${base}/${repo}/releases/download/v${ver}/seedrou-${ver}.tar.gz.sha256" -o "${out}.sha256" 2>/dev/null && break
      done
    fi
  fi
  [ "$rc" -eq 0 ] && [ -s "$out" ] || die "UPG_NET" "下载升级包失败" "请检查升级源与网络；也可在页面手动上传升级包"
  if [ -s "${out}.sha256" ]; then
    # .sha256 内容记录的是原始资产名（seedrou-x.y.z.tar.gz），不能直接 -c；
    # 提取期望哈希与实际文件比对
    local want got
    want="$(awk 'NR==1{print $1}' "${out}.sha256" 2>/dev/null)"
    got="$(sha256sum "$out" 2>/dev/null | awk '{print $1}')"
    if [ -z "$want" ] || [ "$want" != "$got" ]; then
      die "UPG_SHA" "升级包校验失败（sha256 不匹配）" "下载可能被篡改或损坏，请重试；连续失败请检查升级源"
    fi
  fi
  ok_out "path" "$out"
}

do_upgrade_apply() {
  require_root
  acquire_lock
  local pkg="${1:?缺少升级包路径}"
  [ -f "$pkg" ] || die "NO_FILE" "升级包不存在"
  # 1) 包结构校验 + 成员白名单（审计 B-12）：以 root 解压前必须防路径穿越
  if ! tar -tzf "$pkg" 2>/dev/null | python3 -c '
import sys
ALLOW_PREFIX = ("panel/", "priv/", "config/", "systemd/", "network/", "singbox/", "sudoers/", ".github/")
ALLOW_FILE = {"VERSION", "install.sh", "uninstall.sh", "README.md"}
ok = True
for line in sys.stdin:
    p = line.rstrip("\n")
    if not p: continue
    if p.startswith("/") or ".." in p.split("/"): ok = False; break
    if p in ALLOW_FILE: continue
    if p.endswith("/"): continue
    if p.startswith(ALLOW_PREFIX): continue
    ok = False; break
sys.exit(0 if ok else 1)
'; then
    die "UPG_BAD" "升级包含不认识的条目" "请确认上传的是 SeedRou 官方发布的 .tar.gz 升级包"
  fi
  tar -tvzf "$pkg" 2>/dev/null | awk '{print substr($1,1,1)}' | grep -qE '^[lh]' \
    && die "UPG_BAD" "升级包含链接条目，已拒绝" "为防路径穿越，升级包只允许普通文件与目录"
  tar -tzf "$pkg" 2>/dev/null | grep -qE '^VERSION$' || die "UPG_BAD" "升级包缺少 VERSION 文件" "请确认上传的是 SeedRou 官方发布的 .tar.gz 升级包"
  tar -tzf "$pkg" 2>/dev/null | grep -qE '^panel/' || die "UPG_BAD" "升级包缺少 panel/ 目录" "请确认上传的是 SeedRou 官方发布的 .tar.gz 升级包"
  tar -tzf "$pkg" 2>/dev/null | grep -qE '^priv/' || die "UPG_BAD" "升级包缺少 priv/ 目录" "请确认上传的是 SeedRou 官方发布的 .tar.gz 升级包"
  # 2) 版本校验（允许同版本重装，拒绝降级）
  local newver cur
  newver="$(tar -xOzf "$pkg" VERSION 2>/dev/null | tr -d '[:space:]')"
  [ -n "$newver" ] || die "UPG_BAD" "升级包缺少 VERSION 文件"
  cur="$(cur_version)"
  [ "$(ver_ge "$newver" "$cur")" = "yes" ] || die "UPG_DOWNGRADE" "不能从 V${cur} 降级到 V${newver}" "如需回退旧版本，请先恢复出厂前的备份并手动放置旧版包"
  # 3) 解压到暂存区 + 自检
  local stg="/usr/local/lib/seedrou/.upgrade.$$"
  rm -rf "$stg"; mkdir -p "$stg"
  tar -C "$stg" --no-same-owner --no-overwrite-dir -xzf "$pkg" 2>/dev/null || { rm -rf "$stg"; die "UPG_BAD" "升级包解压失败（文件损坏）"; }
  find "$stg" -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true
  find "$stg" -name '*.pyc' -delete 2>/dev/null || true
  # 自检按文件类型分流：.py 走 py_compile，其余走 bash -n（审计 B-01：不能对 Python 跑 bash -n）
  local f
  for f in "$stg"/priv/*; do
    [ -f "$f" ] || continue
    case "$f" in
      *.py) python3 -m py_compile "$f" >/dev/null 2>&1 || { rm -rf "$stg"; die "UPG_BAD" "升级包内 Python 脚本异常：$(basename "$f")"; } ;;
      *)    bash -n "$f" 2>/dev/null || { rm -rf "$stg"; die "UPG_BAD" "升级包内脚本语法异常：$(basename "$f")"; } ;;
    esac
  done
  python3 -m py_compile "$stg"/panel/*.py >/dev/null 2>&1 || { rm -rf "$stg"; die "UPG_BAD" "升级包内面板程序异常（py_compile 失败）"; }
  for need in panel/static/index.html panel/static/app.js panel/static/app.css panel/static/icons.js; do
    [ -f "$stg/$need" ] || { rm -rf "$stg"; die "UPG_BAD" "升级包缺少 $need"; }
  done
  # 4) 备份当前版本 → 原子换目录 → 修正属主
  cp -a "/usr/local/lib/seedrou" "${SEEDROU_VAR}/lastgood/app-$(cat "$VERSION_FILE" 2>/dev/null || echo old)" 2>/dev/null || true
  local old="/usr/local/lib/seedrou.prev.$$"
  mv "/usr/local/lib/seedrou" "$old" && mv "$stg" "/usr/local/lib/seedrou" || { mv "$old" "/usr/local/lib/seedrou" 2>/dev/null; rm -rf "$stg"; die "UPG_SWAP" "升级替换失败，已保留原版本"; }
  chmod 755 /usr/local/lib/seedrou/seedrou-priv 2>/dev/null || true
  chmod 600 /usr/local/lib/seedrou/priv/lib.sh 2>/dev/null || true
  chown -R root:root /usr/local/lib/seedrou
  rm -rf "$old"
  # VERSION 同时落包根与 share/（审计 B-02：目录整体替换后 share/ 会消失，必须重建再拷贝）
  mkdir -p "$SEEDROU_SHARE"
  cp /usr/local/lib/seedrou/VERSION "$SEEDROU_SHARE/VERSION" 2>/dev/null || true
  # 5) 延迟重启面板（先让本次响应送达客户端）
  systemd-run --on-active=3 --quiet systemctl restart "$PANEL_UNIT" 2>/dev/null \
    || setsid bash -c "sleep 3; systemctl restart $PANEL_UNIT" >/dev/null 2>&1 &
  ok_out "message" "已升级到 V${newver}，面板即将重启"
}

# ---------------------------------------------------------------------------
# 状态（/api/status 的特权部分）
# ---------------------------------------------------------------------------
do_status() {
  python3 - <<'PYEOF'
import json, os, subprocess, time

cfg = json.load(open("/etc/seedrou/config.json"))
wans = [p["name"] for p in cfg.get("ports", []) if p.get("wan")]
wans_set = set(wans) | {"ppp0"}

def run(args, timeout=5):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""

# WAN
mode = cfg.get("wan", {}).get("mode", "")
wan = {"mode": mode, "state": "down", "ip": "", "mask": "", "gw": "", "session_s": None, "connecting": False}
try:
    routes = json.loads(run(["ip", "-j", "route", "show", "default"]) or "[]")
except Exception:
    routes = []
wan_dev = next((r.get("dev") for r in routes if r.get("dev") in wans_set), "")
if wan_dev:
    wan["state"] = "up"
    addrs = json.loads(run(["ip", "-j", "-4", "addr", "show", "dev", wan_dev]) or "[]")
    for a in addrs:
        info = (a.get("addr_info") or [{}])[0]
        wan["ip"] = info.get("local", "")
        wan["mask"] = {"8": "255.0.0.0", "16": "255.255.0.0", "24": "255.255.255.0", "25": "255.255.255.128",
                       "28": "255.255.255.240", "29": "255.255.255.248", "30": "255.255.255.252", "32": "255.255.255.255"}.get(str(info.get("prefixlen")), "")
    wan["gw"] = next((r.get("gateway", "") for r in routes if r.get("dev") == wan_dev), "")
    if mode == "pppoe":
        # 会话起点由 pppd ip-up.d 钩子写入（掉线重拨即归零），不再用服务启动时间（persist 下不准，审计 B-22）
        try:
            st = os.stat("/run/seedrou/ppp-session-start")
            wan["session_s"] = max(0, int(time.time() - st.st_mtime))
        except OSError:
            wan["session_s"] = None
else:
    wan["connecting"] = mode == "pppoe"

# IPv6 概览
v6cfg = cfg.get("ipv6", {})
v6 = {"enabled": v6cfg.get("enabled", False), "mode": v6cfg.get("mode", "native"), "addr": "", "dns": []}
if v6["enabled"]:
    dev = wan_dev or "br-lan"
    out = run(["ip", "-j", "-6", "addr", "show", "dev", dev, "scope", "global"])
    try:
        for a in json.loads(out or "[]"):
            for ai in a.get("addr_info", []):
                if not ai.get("local", "").startswith("fe80") and not ai.get("local", "").startswith("fda1:9e3a"):
                    v6["addr"] = ai.get("local", ""); break
            if v6["addr"]: break
    except Exception:
        pass
    if v6["mode"] == "nat6":
        v6["addr"] = v6["addr"] or "fda1:9e3a:8b7f::1（ULA）"

# 网口
ports = []
for p in cfg.get("ports", []):
    n = p["name"]
    base = f"/sys/class/net/{n}"
    oper = ""
    try:
        oper = open(base + "/operstate").read().strip()
    except Exception:
        pass
    speed = ""
    try:
        speed = open(base + "/speed").read().strip()
        speed = f"{speed} Mbps" if speed and speed != "-1" else ""
    except Exception:
        speed = ""
    ports.append({"name": n, "role": "wan" if p.get("wan") else ("lan" if p.get("lan") else "none"),
                  "link": oper == "up", "speed": speed})

# 系统
def rc(args, timeout=5):
    try:
        return subprocess.run(args, capture_output=True, timeout=timeout).returncode
    except Exception:
        return 1
dnsmasq_ok = rc(["systemctl", "is-active", "--quiet", "dnsmasq.service"]) == 0
networkd_ok = rc(["systemctl", "is-active", "--quiet", "systemd-networkd.service"]) == 0
nft_ok = rc(["nft", "list", "table", "inet", "seedrou_base"]) == 0
leases = 0
try:
    with open("/var/lib/misc/dnsmasq.leases") as f:
        leases = sum(1 for _ in f)
except Exception:
    pass

# 硬盘温度：smartctl 需要 root（复审 N-05），随 status 一并采集；
# 60 秒文件缓存——5 秒轮询下不至于持续唤醒机械盘（复审 R-05）
disk_temp = None
try:
    import os as _os
    cache = "/run/seedrou/disk-temp"
    now = time.time()
    cached = None
    try:
        if now - _os.stat(cache).st_mtime < 60:
            cached = open(cache).read().strip()
            disk_temp = int(cached) if cached.lstrip("-").isdigit() else None
    except (OSError, ValueError):
        pass
    if cached is None:
        import shutil as _sh
        if _sh.which("smartctl"):
            scan = subprocess.run(["smartctl", "--scan", "-j"], capture_output=True, text=True, timeout=8).stdout
            dev = (json.loads(scan or "{}").get("devices") or [{}])[0].get("name", "")
            if dev:
                info = subprocess.run(["smartctl", "-A", "-j", dev], capture_output=True, text=True, timeout=8).stdout
                temps = json.loads(info or "{}").get("temperature", {})
                for tv in temps.values():
                    if isinstance(tv, (int, float)) and 0 < tv < 120:
                        disk_temp = int(tv)
                        break
        _os.makedirs("/run/seedrou", exist_ok=True)
        with open(cache + ".tmp", "w") as f:
            f.write(str(disk_temp if disk_temp is not None else ""))
        _os.replace(cache + ".tmp", cache)
except Exception:
    disk_temp = None

ver = "0.0.0"
for vp in ("/usr/local/lib/seedrou/share/VERSION", "/usr/local/lib/seedrou/VERSION"):
    try:
        ver = open(vp).read().strip()
        break
    except OSError:
        continue
print(json.dumps({
    "wan": wan, "ipv6": v6, "ports": ports,
    "lan": cfg.get("lan", {}),
    "version": ver,
    "system_ok": bool(dnsmasq_ok and networkd_ok and nft_ok),
    "disk_temp": disk_temp,
    "leases_count": leases,
}, ensure_ascii=False))
PYEOF
}

# ---------------------------------------------------------------------------
# 自检（安装后验证，不改系统）
# ---------------------------------------------------------------------------
do_selftest() {
  python3 - <<'PYEOF'
import json, os, shutil, subprocess, sys
checks = []
def add(name, ok, hint=""):
    checks.append({"name": name, "ok": bool(ok), "hint": hint})
add("config.json 存在且可解析", os.path.exists("/etc/seedrou/config.json") and json.load(open("/etc/seedrou/config.json")))
add("secrets.json 存在", os.path.exists("/etc/seedrou/secrets.json"))
for c in ("nft", "dnsmasq", "pppd", "curl", "python3", "ip"):
    add(f"命令可用: {c}", bool(shutil.which(c)), f"apt install {c}" if c in ("nft", "dnsmasq", "pppd") else "")
add("netgen 校验", subprocess.run(["python3", "/usr/local/lib/seedrou/netgen.py", "--check"], capture_output=True).returncode == 0)
try:
    out = subprocess.run(["nft", "list", "table", "inet", "seedrou_base"], capture_output=True).returncode
    add("nft 表 seedrou_base 已加载", out == 0)
except Exception:
    add("nft 表 seedrou_base 已加载", False)
add("sing-box 不受本脚本管理（仅检测）", True)
bad = [c for c in checks if not c["ok"]]
print(json.dumps({"ok": not bad, "checks": checks, "summary": f"{len(checks) - len(bad)}/{len(checks)} 通过"}, ensure_ascii=False))
PYEOF
}

# ---------------------------------------------------------------------------
# 分发
# ---------------------------------------------------------------------------
case "$CMD" in
  auth-verify)     do_auth_verify ;;
  session-secret)  do_session_secret ;;
  config-get)      do_config_get ;;
  config-set)      do_config_set "$@" ;;
  apply-all)       do_apply_all "$@" ;;
  service-ctl)     do_service_ctl "$@" ;;
  podman-ops)      do_podman_ops "$@" ;;
  tailscale-ops)   do_tailscale_ops "$@" ;;
  passwd-set)      do_passwd_set ;;
  backup-create)   do_backup_create "$@" ;;
  backup-restore)  do_backup_restore "$@" ;;
  factory-reset)   do_factory_reset ;;
  upgrade-check)   do_upgrade_check ;;
  upgrade-download) do_upgrade_download "$@" ;;
  upgrade-apply)   do_upgrade_apply "$@" ;;
  status)          do_status ;;
  selftest)        do_selftest ;;
  *)               die "USAGE" "未知子命令：${CMD:-（空）}" "合法子命令见安装文档" ;;
esac
