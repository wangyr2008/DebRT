#!/usr/bin/env bash
# ============================================================================
# SeedRou 特权入口 —— 面板经 sudo 白名单唯一直达的 root 脚本。
#
# 安全设计：
#   * 子命令白名单分发，绝不 eval 用户输入；
#   * 敏感数据（密码）只经 stdin 传递，不出现在参数/日志/回显；
#   * 所有配置变更：校验 → lastgood 快照 → 原子写 → 语法预检 → 应用 → 验证 →
#     失败自动回滚，并以可操作的 JSON 错误返回；
#   * 与 sing-box / podman / tailscale 的共存契约见 COEXISTENCE.md：
#     本脚本只操作自己的 nft 表 inet seedrou_base，永不 flush ruleset，
#     永不 restart sing-box。
# ============================================================================
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
PRIV_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=lib.sh
source "${PRIV_DIR}/lib.sh"

CMD="${1:-}"; [ $# -gt 0 ] && shift

# ---------------------------------------------------------------------------
# 认证
# ---------------------------------------------------------------------------
do_auth_verify() {
  local pw lock_state out
  pw="$(head -c 4096)"   # stdin 只读一次
  [ -n "$pw" ] || die "AUTH_EMPTY" "请输入管理密码"
  # 暴力破解兜底限速：按来源 IP 的限速在面板层做；本层是全局兜底（20 次失败锁 300 秒），
  # 阈值放宽以免全局单计数器被用来把管理员锁在门外（审计 B-18）。
  lock_state='{"fails":0,"lock_until":0}'
  [ -f "${SEEDROU_VAR}/auth-state.json" ] && lock_state="$(cat "${SEEDROU_VAR}/auth-state.json" 2>/dev/null || echo "$lock_state")"
  # 密码经环境变量传入（/proc/<pid>/environ 为 0400 root，ps 不可见），不走 argv（审计 B-15）
  out="$(SEEDROU_SECRET="$pw" python3 - "$lock_state" <<'PYEOF'
import hashlib, hmac, json, os, sys, time
pw, state = os.environ.get("SEEDROU_SECRET", ""), json.loads(sys.argv[1])
now = int(time.time())
if state.get("lock_until", 0) > now:
    print(json.dumps({"ok": False, "code": "AUTH_LOCKED",
                      "message": f"尝试次数过多，请 {state['lock_until'] - now + 1} 秒后重试",
                      "hint": "密码不会因此失效；稍等即可再次尝试"}))
    sys.exit(0)
try:
    rec = json.load(open("/etc/seedrou/secrets.json"))["admin_pbkdf2"]
    algo, iters, salt, want = rec.split("$", 3)
    got = hashlib.pbkdf2_hmac(algo, pw.encode(), bytes.fromhex(salt), int(iters)).hex()
    ok = hmac.compare_digest(got, want)
except Exception:
    ok = False
if ok:
    state = {"fails": 0, "lock_until": 0}
else:
    state["fails"] = int(state.get("fails", 0)) + 1
    if state["fails"] >= 20:
        state["lock_until"] = now + 300
        print(json.dumps({"ok": False, "code": "AUTH_LOCKED",
                          "message": "连续多次密码错误，已临时锁定 5 分钟",
                          "hint": "若忘记密码：长按机身 Reset 键 8 秒恢复出厂，或在控制台执行 seedrou-priv factory-reset"}))
    else:
        print(json.dumps({"ok": False, "code": "AUTH_BAD",
                          "message": "管理密码不正确", "hint": "请检查密码后重试"}))
json.dump(state, open("/var/lib/seedrou/auth-state.json", "w"))
sys.exit(0 if ok else 1)
PYEOF
)"
  printf '%s\n' "$out"
  case "$out" in *'"ok": true'*) exit 0 ;; *) exit 1 ;; esac
}

do_session_secret() {
  python3 - <<'PYEOF'
import json
try:
    s = json.load(open("/etc/seedrou/secrets.json")).get("session_secret", "")
    print(json.dumps({"ok": True, "secret": s}))
except Exception:
    print(json.dumps({"ok": False, "code": "NO_SECRET", "message": "secrets.json 缺失或损坏", "hint": "请重新运行 install.sh"}))
PYEOF
}

# ---------------------------------------------------------------------------
# 配置读取（不含任何明文密码）
# ---------------------------------------------------------------------------
do_config_get() {
  python3 - <<'PYEOF'
import json
cfg = json.load(open("/etc/seedrou/config.json"))
try:
    has_pw = bool(json.load(open("/etc/seedrou/secrets.json")).get("pppoe_password"))
except Exception:
    has_pw = False
cfg.setdefault("wan", {})["has_password"] = has_pw
cfg.pop("notes", None)
print(json.dumps({"ok": True, "config": cfg}, ensure_ascii=False))
PYEOF
}

# ---------------------------------------------------------------------------
# 配置写入 + 应用（核心流水线）
# ---------------------------------------------------------------------------
do_config_set() {
  local section="${1:-}"
  [ -n "$section" ] || die "USAGE" "缺少配置段名称"
  require_root
  acquire_lock

  local in_json norm tag stage man_json pre_wan acts failed
  in_json="$(mktemp /run/seedrou/in.XXXXXX)"
  cat > "$in_json"

  # 1) 校验与规范化（失败时 validate.py 直接输出可操作的 JSON 错误）
  if ! norm="$(python3 "${PRIV_DIR}/validate.py" "$section" < "$in_json")"; then
    printf '%s\n' "$norm"; rm -f "$in_json"; exit 1
  fi

  # 1.5) 仅保存升级源：不涉及网络应用
  if [ "$section" = "upgrade" ]; then
    python3 - "$in_json" "$norm" <<'PYEOF'
import json, sys
norm = json.load(open(sys.argv[2]))["data"]
cfg = json.load(open("/etc/seedrou/config.json"))
cfg["upgrade"] = norm
tmp = "/etc/seedrou/.config.tmp"
json.dump(cfg, open(tmp, "w"), ensure_ascii=False, indent=1)
import os
os.chmod(tmp, 0o644)
os.replace(tmp, "/etc/seedrou/config.json")
PYEOF
    rm -f "$in_json"
    ok_out "message" "升级源已保存"
    exit 0
  fi

  # 2) 快照 + 合并（密码只进 secrets；规范化结果写临时文件再传入，不进 argv —— 审计 B-15，
  #    同时修复审计遗漏的缺陷：norm 此前被当文件路径 open()，真实模式 config-set 必失败）
  local old_mode
  old_mode="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("mode",""))' 2>/dev/null || echo "")"
  tag="s$(date +%s%N | tail -c 9)"
  snapshot_lastgood "$tag"
  local new_cfg new_sec norm_file
  new_cfg="$(mktemp /run/seedrou/cfg.XXXXXX)"
  new_sec="$(mktemp /run/seedrou/sec.XXXXXX)"
  norm_file="$(mktemp /run/seedrou/norm.XXXXXX)"
  chmod 600 "$new_sec" "$norm_file"
  printf '%s' "$norm" > "$norm_file"
  if ! python3 - "$section" "$in_json" "$norm_file" "$new_cfg" "$new_sec" <<'PYEOF'
import json, sys
section, in_file, norm_file, out_cfg, out_sec = sys.argv[1:6]
cfg = json.load(open("/etc/seedrou/config.json"))
sec_in = json.load(open(in_file))
norm = json.load(open(norm_file))["data"]
try:
    secrets = json.load(open("/etc/seedrou/secrets.json"))
except Exception:
    secrets = {}
if section == "bind":
    cfg["ports"] = norm
elif section == "wan":
    pwd = norm.pop("password", None)
    for k in ("mode", "username", "dns_mode", "dns", "ip", "mask", "gw"):
        cfg.setdefault("wan", {})[k] = norm[k]
    if pwd:
        secrets["pppoe_password"] = pwd
        cfg["wan"]["has_password"] = True
elif section == "ipv6":
    cfg["ipv6"] = norm
elif section == "lan":
    cfg["lan"] = norm
elif section == "dhcp":
    cfg["dhcp"] = norm
elif section == "static":
    cfg["static"] = norm
elif section == "qos":
    cfg["qos"] = norm
elif section == "firewall":
    if "wan_input_drop" in sec_in:
        cfg.setdefault("firewall", {})["wan_input_drop"] = norm["wan_input_drop"]
    if "portfw" in sec_in:
        cfg["firewall"]["portfw"] = norm["portfw"]
elif section == "upgrade":
    cfg["upgrade"] = norm
else:
    sys.exit(9)
json.dump(cfg, open(out_cfg, "w"), ensure_ascii=False, indent=1)
if secrets:
    json.dump(secrets, open(out_sec, "w"), ensure_ascii=False, indent=1)
PYEOF
  then
    restore_lastgood "$tag"; rm -f "$in_json" "$new_cfg" "$new_sec" "$norm_file"
    die "MERGE" "配置合并失败" "本次修改未生效；请刷新页面重试"
  fi

  # 3) 先采样 + 落盘：netgen 读固定路径 /etc/seedrou/config.json，必须让它在
  #    生成前看到"新配置"，否则每次保存生效的都是上一版（复审 v0.1.2 P-01）
  #    pre_wan 语义仍是"改动前 WAN 是否可用"（审计 B-03），在写盘前采样
  pre_wan="$(wan_route_ok)"
  write_atomic "$CONFIG_JSON" 644 < "$new_cfg"
  [ -s "$new_sec" ] && write_atomic "$SECRETS_JSON" 600 < "$new_sec"

  # 4) 用新配置生成 + 预检。此时原生文件尚未部署，失败回滚后系统与旧配置完全一致（安全）
  stage="$(mktemp -d /run/seedrou/stage.XXXXXX)"
  man_json="$stage/manifest.json"
  if ! python3 "${PRIV_DIR}/netgen.py" --stage "$stage" > "$man_json"; then
    cat "$man_json"
    restore_lastgood "$tag"; rm -rf "$stage" "$in_json" "$new_cfg" "$new_sec" "$norm_file"
    exit 1
  fi
  if ! pf_out="$(preflight_stage "$stage")"; then
    printf '%s\n' "$pf_out"
    restore_lastgood "$tag"; rm -rf "$stage" "$in_json" "$new_cfg" "$new_sec" "$norm_file"
    exit 1
  fi

  # 5) 部署生成文件 + 重启受影响服务
  rm -f "$in_json" "$new_cfg" "$new_sec" "$norm_file"
  apply_stage_files "$stage" "$man_json"
  cleanup_stale_port_networks
  rm -rf "$stage"
  acts="$(plan_for_section "$section")"
  # 仅在模式/账号变化或网口重绑定时才重拨 PPPoE（避免改个 DNS 就断线重连）
  local new_mode pppoe_needed="no"
  new_mode="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("mode",""))')"
  [ "$old_mode" != "$new_mode" ] && pppoe_needed="yes"
  [ "$section" = "bind" ] && [ "$new_mode" = "pppoe" ] && pppoe_needed="yes"
  if [ "$section" = "wan" ] && printf '%s' "$norm" | python3 -c 'import json,sys;sys.exit(0 if json.load(sys.stdin).get("data",{}).get("password") else 1)' 2>/dev/null; then
    pppoe_needed="yes"
  fi
  if [ "$pppoe_needed" != "yes" ]; then
    acts="$(printf '%s\n' $acts | grep -v '^pppoe$' | tr '\n' ' ')"
  fi
  failed="$(run_actions "$acts")"

  # 6) 验证
  local mode wan_to tmo err_hint=""
  mode="$(python3 -c 'import json;print(json.load(open("'"$CONFIG_JSON"'")).get("wan",{}).get("mode",""))')"
  if ! wait_dnsmasq 10; then
    err_hint="dnsmasq 未能启动：journalctl -u dnsmasq -n 30"
    failed="$failed dnsmasq"
  elif [ "$section" = "wan" ] || [ "$pre_wan" = "yes" ]; then
    # 上网设置无条件验证：首次配置 PPPoE 时 pre_wan=no，恰恰是最需要报错的场景（审计 B-03）
    if [ "$section" = "wan" ] && [ "$mode" = "pppoe" ]; then tmo=45; else tmo=25; fi
    if ! wait_wan "$tmo"; then
      if [ "$mode" = "pppoe" ]; then
        if journalctl -u seedrou-pppoe.service -n 40 --no-pager 2>/dev/null | grep -qiE "PAP authentication failed|CHAP authentication failed|authentication failed"; then
          err_hint="PPPoE 拨号被服务器拒绝（认证失败）：请检查宽带账号/密码是否正确；若账号正在其他设备上拨号，请先断开再试"
        elif journalctl -u seedrou-pppoe.service -n 40 --no-pager 2>/dev/null | grep -qiE "timeout|LCP: timeout|No response"; then
          err_hint="PPPoE 服务器无响应：请确认光猫已改为桥接模式、WAN 线已插在绑定的 WAN 口上"
        else
          err_hint="PPPoE 未能在预期时间内建立连接：journalctl -u seedrou-pppoe -n 40 查看详情"
        fi
      else
        err_hint="应用后 WAN 未能恢复连接：请检查上级网络/网线；可尝试在「网络设置」重新保存上网设置"
      fi
      failed="$failed wan"
    fi
  fi

  if [ -n "$failed" ] || [ -n "$err_hint" ]; then
    # 回滚到修改前配置并重放
    restore_lastgood "$tag"
    local stage2 man2
    stage2="$(mktemp -d /run/seedrou/stage.XXXXXX)"
    man2="$stage2/manifest.json"
    if python3 "${PRIV_DIR}/netgen.py" --stage "$stage2" > "$man2" 2>/dev/null; then
      apply_stage_files "$stage2" "$man2"
      cleanup_stale_port_networks
      run_actions "$(plan_for_section "$section")" >/dev/null 2>&1 || true
    fi
    rm -rf "$stage2"
    [ -z "$err_hint" ] && err_hint="已自动恢复到修改前的可用配置，未生效的修改请检查后重试"
    die "APPLY_ROLLED_BACK" "配置未能安全生效，已自动回滚" "$err_hint"
  fi

  # 7) 回应（WAN 方式切换给 sing-box 用户一句提示）
  local msg="配置已保存并生效" hint_sb=""
  if [ "$section" = "wan" ] && systemctl is-enabled --quiet sing-box.service 2>/dev/null; then
    hint_sb="若已启用 sing-box，建议执行 sb restart 重新绑定出口接口"
  fi
  if [ "$section" = "lan" ]; then
    msg="LAN 设置已生效；若管理地址已变化，请使用新 IP 重新登录"
  fi
  ok_out "message" "$msg" "hint_singbox" "$hint_sb"
}

# ---------------------------------------------------------------------------
# 幂等收敛（开机 / 定时）
# ---------------------------------------------------------------------------
do_apply_all() {
  require_root
  local convergent=""; [ "${1:-}" = "--convergent" ] && convergent="1"
  mkdir -p /run/seedrou-dns /run/seedrou
  acquire_lock
  local stage man_json migrated=""
  stage="$(mktemp -d /run/seedrou/stage.XXXXXX)"
  man_json="$stage/manifest.json"
  if ! python3 "${PRIV_DIR}/netgen.py" --stage "$stage" > "$man_json" 2>/dev/null; then
    # /16 历史配置：自动迁移为 /24（保留 IP 与地址池），避免"重启即无 NAT"（复审 R-04）
    if grep -q 'LAN_MASK_TOO_WIDE' "$man_json" 2>/dev/null; then
      snapshot_lastgood "m$(date +%s)"
      if python3 - <<'PYEOF'
import json, os
cfg = json.load(open("/etc/seedrou/config.json"))
cfg.setdefault("lan", {})["mask"] = "255.255.255.0"
json.dump(cfg, open("/etc/seedrou/.config.tmp", "w"), ensure_ascii=False, indent=1)
os.replace("/etc/seedrou/.config.tmp", "/etc/seedrou/config.json")
PYEOF
      then
        migrated="已自动把 LAN 子网掩码迁移为 255.255.255.0（历史 /16 配置不再受支持，地址池末段保持不变）"
        rm -rf "$stage"
        stage="$(mktemp -d /run/seedrou/stage.XXXXXX)"
        man_json="$stage/manifest.json"
      fi
    fi
    if [ ! -s "$man_json" ] || ! python3 "${PRIV_DIR}/netgen.py" --stage "$stage" > "$man_json" 2>/dev/null; then
      cat "$man_json" 2>/dev/null   # 透传 netgen 的可操作错误（复审 R-03）
      die "CONFIG_CORRUPT" "配置生成失败" "请按上方错误信息在管理页面修正；或从 /var/lib/seedrou/lastgood 恢复上一份可用配置"
    fi
  fi

  if [ -n "$convergent" ]; then
    # 收敛模式：无漂移则只保证运行时状态（nft 表 / cake / 服务存活）
    local drift=0 line rel mode
    while IFS=$'\t' read -r rel mode; do
      [ -f "/${rel}" ] || { drift=1; break; }
      cmp -s "/${rel}" "${stage}/${rel}" || { drift=1; break; }
    done < <(python3 - "$man_json" <<'PYEOF'
import json, sys
for f in json.load(open(sys.argv[1]))["files"]:
    print(f"{f['path']}\t{f['mode']:04o}")
PYEOF
)
    if [ "$drift" = "0" ] && wait_dnsmasq 1 && nft list table $NFT_TABLE >/dev/null 2>&1; then
      svc_cake
      systemctl is-enabled --quiet sing-box.service 2>/dev/null || true
      ok_out "message" "无漂移，运行时已确认" "converged" "true"
      exit 0
    fi
  fi

  if ! pf_out="$(preflight_stage "$stage")"; then
    die "STAGE_BROKEN" "现有配置无法生成合法的系统配置" "请在管理页面检查网络设置；或恢复出厂设置"
  fi
  apply_stage_files "$stage" "$man_json"
  cleanup_stale_port_networks
  rm -rf "$stage"
  run_actions "networkd pppoe dnsmasq nft cake" >/dev/null 2>&1 || true
  wait_dnsmasq 15 || true
  ok_out "message" "已按配置完成系统收敛${migrated:+。}$migrated"
}

# ---------------------------------------------------------------------------
# 服务控制（podman / tailscale）
# ---------------------------------------------------------------------------
do_service_ctl() {
  require_root
  local name="${1:-}" action="${2:-}"
  case "$name" in
    podman)
      case "$action" in
        start)   systemctl start podman.socket podman.service 2>/dev/null; podman start --all >/dev/null 2>&1 || true ;;
        stop)    podman stop --all >/dev/null 2>&1 || true; systemctl stop podman.service podman.socket 2>/dev/null || true ;;
        enable)  systemctl enable --quiet podman.socket podman.service podman-restart.service 2>/dev/null || die "SVC" "设置开机自启失败" "请确认已安装 podman：apt install podman" ;;
        disable) systemctl disable --quiet podman.socket podman.service podman-restart.service 2>/dev/null || true ;;
        *) die "USAGE" "service-ctl podman 需要 start|stop|enable|disable" ;;
      esac ;;
    tailscale)
      command -v tailscale >/dev/null 2>&1 || die "TS_NOT_INSTALLED" "Tailscale 尚未安装" "请在「其他工具」中先一键安装"
      case "$action" in
        start)   systemctl start tailscaled.service ;;
        stop)    systemctl stop tailscaled.service ;;
        enable)  systemctl enable --quiet tailscaled.service ;;
        disable) systemctl disable --quiet tailscaled.service ;;
        *) die "USAGE" "service-ctl tailscale 需要 start|stop|enable|disable" ;;
      esac ;;
    *) die "USAGE" "不支持的服务：${name}" ;;
  esac
  ok_out "message" "已完成 ${name} ${action}"
}

# ---------------------------------------------------------------------------
# podman-ops
# ---------------------------------------------------------------------------
POD_LOCK=0
pod_lock() { exec 8>/run/seedrou/podman.lock; flock -w 600 8 || die "BUSY" "另一个容器操作正在进行中，请稍后重试"; }

podman_json() { python3 -c "$1"; }

do_podman_ops() {
  require_root
  local action="${1:-}"; [ $# -gt 0 ] && shift
  command -v podman >/dev/null 2>&1 || die "PODMAN_MISSING" "Podman 未安装" "请在系统上执行 apt install podman podman-compose"
  pod_lock
  case "$action" in
    status)
      local ver running autostart
      ver="$(podman --version 2>/dev/null | awk '{print $3}')"
      [ -n "$(podman ps -q 2>/dev/null | head -n 1)" ] && running="true" || running="false"
      systemctl is-active --quiet podman.service && running="true"
      systemctl is-enabled --quiet podman-restart.service 2>/dev/null && autostart="true" || autostart="false"
      ok_out "installed" "true" "version" "${ver:-}" "running" "$running" "autostart" "$autostart" ;;
    list-containers)
      podman ps -a --format '{{.Names}}\t{{.Image}}\t{{.State}}\t{{.Ports}}' | podman_json '
import sys, json
out = []
for line in sys.stdin:
    parts = line.rstrip("\n").split("\t")
    parts += [""] * (4 - len(parts))
    out.append({"name": parts[0], "image": parts[1], "state": parts[2],
                "ports": [p for p in parts[3].split(",") if p]})
print(json.dumps({"ok": True, "containers": out}))' ;;
    container)
      local cname="${1:-}" cact="${2:-}" label
      [ -n "$cname" ] && [ -n "$cact" ] || die "USAGE" "缺少容器名或操作"
      case "$cact" in
        start)  label="已启动" ;;
        stop)   label="已停止" ;;
        restart) label="已重启" ;;
        remove) label="已删除" ;;
        update) label="已更新" ;;
        *) die "USAGE" "容器操作需为 start|stop|restart|update|remove" ;;
      esac
      case "$cact" in
        start|stop|restart) podman "$cact" "$cname" >/dev/null 2>&1 || die "CT_FAIL" "容器 $cname ${cact} 失败" "可在系统上执行 podman logs --tail 20 $cname 查看原因" ;;
        remove) podman rm -f "$cname" >/dev/null 2>&1 || die "CT_FAIL" "删除容器失败" "请确认容器名正确" ;;
        update) do_podman_update "$cname" ;;
      esac
      ok_out "message" "容器 $cname ${label}" ;;
    list-images)
      podman images --format '{{.Names}}\t{{.Size}}' | podman_json '
import sys, json
imgs = {}
order = []
for line in sys.stdin:
    name, size = (line.rstrip("\n").split("\t") + [""] * 2)[:2]
    if not name: continue
    tag = name.split(",")[0]
    if tag not in imgs:
        imgs[tag] = {"name": tag, "size": size, "used_by": 0}
        order.append(tag)
used = {}
for line in __import__("subprocess").run(["podman","ps","-a","--format","{{.Image}}"],capture_output=True,text=True).stdout.splitlines():
    used[line.strip()] = used.get(line.strip(), 0) + 1
for it in imgs.values():
    it["used_by"] = used.get(it["name"], 0)
    it["size_text"] = it.pop("size")
print(json.dumps({"ok": True, "images": list(imgs.values())}))' ;;
    pull)
      local img="${1:-}"
      [ -n "$img" ] || die "USAGE" "缺少镜像名"
      if ! podman pull --timeout 300s "$img" >/dev/null 2>&1; then
        die "PULL_FAIL" "镜像 $img 拉取失败" "请检查镜像名与标签；若服务器在墙外，请确认网络可直连镜像仓库，或先配置镜像加速"
      fi
      ok_out "message" "镜像 $img 已拉取" ;;
    image-rm)
      local img="${1:-}"
      [ -n "$img" ] || die "USAGE" "缺少镜像名"
      podman rmi "$img" >/dev/null 2>&1 || die "IMG_FAIL" "删除镜像失败" "该镜像可能正被容器使用，或名称不完整（需含 tag）"
      ok_out "message" "镜像已删除" ;;
    compose-get)
      ok_out "content" "$(python3 -c '
import json, os
p = "/etc/seedrou/compose.yaml"
print(json.dumps(open(p).read() if os.path.exists(p) else ""))' 2>/dev/null || echo '""')" ;;
    compose-set)
      write_atomic "${SEEDROU_ETC}/compose.yaml" 644
      ok_out "message" "Compose 文件已保存" ;;
    compose-deploy)
      [ -f "${SEEDROU_ETC}/compose.yaml" ] || die "COMPOSE_EMPTY" "尚未保存 Compose 内容" "请先在文本框中填写并部署"
      command -v podman-compose >/dev/null 2>&1 || die "COMPOSE_MISSING" "未安装 podman-compose" "在系统上执行 apt install podman-compose 后重试"
      local logf logtail
      logf="$(mktemp /run/seedrou/compose.XXXXXX)"
      if ! podman-compose -f "${SEEDROU_ETC}/compose.yaml" -p seedrou up -d >"$logf" 2>&1; then
        logtail="$(tail -n 4 "$logf" | tr '\n' ' ' | cut -c1-260)"
        rm -f "$logf"
        die "COMPOSE_FAIL" "Compose 部署失败" "常见原因：语法错误、镜像名/标签不存在、端口被占用。日志：${logtail}"
      fi
      logtail="$(tail -n 3 "$logf" | tr '\n' ' ' | cut -c1-200)"
      rm -f "$logf"
      ok_out "message" "Compose 已部署" "log_tail" "$logtail" ;;
    compose-stop)
      podman-compose -f "${SEEDROU_ETC}/compose.yaml" -p seedrou down >/dev/null 2>&1 || true
      ok_out "message" "Compose 已停止（数据卷保留）" ;;
    *) die "USAGE" "podman-ops 未知操作：${action}" ;;
  esac
}

# 容器"更新"：拉最新镜像并按原端口/卷/环境重建
do_podman_update() {
  local cname="$1" img ports binds envs restart
  img="$(podman inspect -f '{{.ImageName}}' "$cname" 2>/dev/null)"
  [ -n "$img" ] || die "CT_FAIL" "无法读取容器 $cname 的镜像信息"
  restart="$(podman inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$cname" 2>/dev/null)"
  [ -n "$restart" ] && [ "$restart" != "no" ] || restart="unless-stopped"
  if ! podman pull --timeout 300s "$img" >/dev/null 2>&1; then
    die "PULL_FAIL" "拉取 $img 最新版本失败" "请检查网络与镜像仓库可达性"
  fi
  local args=()
  while IFS= read -r p; do [ -n "$p" ] && args+=(-p "$p"); done < <(podman inspect -f '{{range $k,$v := .HostConfig.PortBindings}}{{range $v}}-p {{.HostIp}}:{{.HostPort}}:{{$k}}{{"\n"}}{{end}}{{end}}' "$cname" 2>/dev/null | sed 's/-p //')
  while IFS= read -r b; do [ -n "$b" ] && args+=(-v "$b"); done < <(podman inspect -f '{{range .HostConfig.Binds}}{{.}}{{"\n"}}{{end}}' "$cname" 2>/dev/null)
  while IFS= read -r e; do [ -n "$e" ] && args+=(-e "$e"); done < <(podman inspect -f '{{range .Config.Env}}{{.}}{{"\n"}}{{end}}' "$cname" 2>/dev/null | grep -vE '^(PATH|TERM|container|HOSTNAME|HOME)=')
  # 先建后删（审计 B-19）：新容器创建成功才动旧容器；失败保留旧容器原地运行
  local tmp_name="${cname}.new.$$"
  if ! podman create --name "$tmp_name" --restart "$restart" "${args[@]}" "$img" >/dev/null 2>&1; then
    podman rm -f "$tmp_name" >/dev/null 2>&1 || true
    die "CT_REBUILD_FAIL" "容器 $cname 重建失败（旧容器未受影响）" "更新只保留端口/卷/环境变量/重启策略；使用特殊参数（--network/--privileged 等）的容器请改用 Compose 管理"
  fi
  podman stop -t 30 "$cname" >/dev/null 2>&1 || true
  podman rm "$cname" >/dev/null 2>&1 || true
  if ! podman rename "$tmp_name" "$cname" >/dev/null 2>&1; then
    die "CT_REBUILD_FAIL" "新容器已就绪但改名失败" "可在系统上执行 podman start ${tmp_name} 手工接管"
  fi
  podman start "$cname" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# tailscale-ops
# ---------------------------------------------------------------------------
do_tailscale_ops() {
  require_root
  local action="${1:-}"
  case "$action" in
    status)
      if ! command -v tailscale >/dev/null 2>&1; then ok_out "installed" "false"; exit 0; fi
      local ver running state acc ip host auth_url=""
      ver="$(tailscale version 2>/dev/null | head -n 1 | cut -d: -f1)"
      systemctl is-active --quiet tailscaled.service && running="true" || running="false"
      acc=""; ip=""; host=""; state="NeedsLogin"
      if [ "$running" = "true" ]; then
        eval "$(tailscale status --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("TS_STATE=NeedsLogin"); raise SystemExit
print("TS_STATE=" + str(d.get("BackendState", "NeedsLogin")))
self_ = d.get("Self") or {}
ips = self_.get("TailscaleIPs") or []
print("TS_IP=" + (ips[0] if ips else ""))
print("TS_ACC=" + str((d.get("CurrentTailnet") or {}).get("Name") or ""))
print("TS_HOST=" + str(self_.get("DNSName") or "").rstrip(".").split(".")[0])
' )" || true
        [ "$TS_STATE" = "Running" ] && acc="$TS_ACC" && ip="$TS_IP" && host="$TS_HOST"
      fi
      if [ -f /run/seedrou/ts-login.log ] && [ -z "$acc" ]; then
        auth_url="$(grep -oE 'https://login\.tailscale\.com[^ ]*' /run/seedrou/ts-login.log 2>/dev/null | tail -n 1)"
      fi
      ok_out "installed" "true" "running" "$running" "logged_in" "$([ -n "$acc" ] && echo true || echo false)" \
             "account" "$acc" "ip" "$ip" "hostname" "${host:-seedrou}" "version" "$ver" "auth_url" "$auth_url" ;;
    install)
      command -v tailscale >/dev/null 2>&1 && die "TS_INSTALLED" "Tailscale 已安装" "刷新页面即可使用"
      export DEBIAN_FRONTEND=noninteractive
      curl -fsSL --max-time 20 "https://pkgs.tailscale.com/stable/debian/trixie.noarmor.gpg" -o /usr/share/keyrings/tailscale-archive-keyring.gpg \
        && curl -fsSL --max-time 20 "https://pkgs.tailscale.com/stable/debian/trixie.tailscale-keyring.list" -o /etc/apt/sources.list.d/tailscale.list \
        || die "TS_REPO_FAIL" "无法添加 Tailscale 官方软件源" "请确认路由器可访问 pkgs.tailscale.com；若被墙可手动下载 .deb 后 dpkg -i 安装"
      apt-get update -qq 2>/dev/null || true
      apt-get install -y -qq tailscale >/dev/null 2>&1 || die "TS_INSTALL_FAIL" "Tailscale 安装失败" "请检查软件源与网络后重试；也可手动安装后刷新本页"
      systemctl enable --quiet tailscaled.service
      systemctl start tailscaled.service
      ok_out "message" "Tailscale 安装完成" ;;
    login)
      systemctl is-active --quiet tailscaled.service || systemctl start tailscaled.service
      if tailscale status --json 2>/dev/null | grep -q '"BackendState": "Running"'; then
        ok_out "message" "已经登录，无需重复登录"; exit 0
      fi
      mkdir -p /run/seedrou
      # 已有登录流程在跑则复用其链接，避免重复 tailscale up 互相干扰
      if pgrep -f "tailscale up --accept-dns" >/dev/null 2>&1 && [ -f /run/seedrou/ts-login.log ]; then
        local u0; u0="$(grep -oE 'https://login\.tailscale\.com[^ ]*' /run/seedrou/ts-login.log 2>/dev/null | tail -n 1)"
        ok_out "auth_url" "${u0:-}" "message" "授权进行中，请打开链接完成登录"
        exit 0
      fi
      rm -f /run/seedrou/ts-login.log
      setsid bash -c 'tailscale up --accept-dns=false --hostname=seedrou > /run/seedrou/ts-login.log 2>&1' >/dev/null 2>&1 &
      sleep 3
      local url
      url="$(grep -oE 'https://login\.tailscale\.com[^ ]*' /run/seedrou/ts-login.log 2>/dev/null | tail -n 1)"
      ok_out "auth_url" "${url:-}" "message" "$([ -n "$url" ] && echo "请在浏览器打开授权链接" || echo "授权链接生成中，请稍后刷新页面")" ;;
    logout)
      rm -f /run/seedrou/ts-login.log
      tailscale logout >/dev/null 2>&1 || die "TS_LOGOUT_FAIL" "登出失败" "请确认 tailscaled 正在运行"
      ok_out "message" "已登出 Tailscale" ;;
    *) die "USAGE" "tailscale-ops 需要 status|install|login|logout" ;;
  esac
}

# ---------------------------------------------------------------------------
# 管理密码
# ---------------------------------------------------------------------------
do_passwd_set() {
  require_root
  acquire_lock
  local body
  body="$(cat)"
  local out rc
  # body（含新旧密码）经环境变量传入，不进 argv（审计 B-15）
  out="$(SEEDROU_SECRET="$body" python3 - <<'PYEOF'
import hashlib, hmac, json, sys, time, os
body = json.loads(os.environ["SEEDROU_SECRET"])
old, new = body.get("old", ""), body.get("new", "")
secrets = json.load(open("/etc/seedrou/secrets.json"))
def check(pw, rec):
    try:
        algo, iters, salt, want = rec.split("$", 3)
        return hmac.compare_digest(hashlib.pbkdf2_hmac(algo, pw.encode(), bytes.fromhex(salt), int(iters)).hex(), want)
    except Exception:
        return False
if not check(old, secrets.get("admin_pbkdf2", "")):
    print(json.dumps({"ok": False, "code": "AUTH_BAD", "message": "原密码不正确", "hint": "请输入当前使用的管理密码"})); sys.exit(1)
if not (8 <= len(new) <= 32):
    print(json.dumps({"ok": False, "code": "PW_LEN", "message": "新密码需为 8–32 位"})); sys.exit(1)
salt = os.urandom(16)
h = hashlib.pbkdf2_hmac("sha256", new.encode(), salt, 600000).hex()
secrets["admin_pbkdf2"] = f"pbkdf2$600000${salt.hex()}${h}"
# 轮换会话密钥：改密后所有旧会话（含可能被盗的 cookie）立即失效（审计 B-17）
secrets["session_secret"] = os.urandom(32).hex()
tmp = "/etc/seedrou/.secrets.tmp"
with open(tmp, "w") as f:
    json.dump(secrets, f, ensure_ascii=False, indent=1)
    f.flush(); os.fsync(f.fileno())
os.chmod(tmp, 0o600)
os.replace(tmp, "/etc/seedrou/secrets.json")
print(json.dumps({"ok": True, "message": "管理密码已更新"}))
PYEOF
)"
  rc=$?
  printf '%s\n' "$out"
  exit $rc
}

# ---------------------------------------------------------------------------
# 备份 / 恢复 / 恢复出厂
# ---------------------------------------------------------------------------
do_backup_create() {
  require_root
  local out_path="${1:?缺少输出路径}"
  tar -C / -czf "$out_path" \
    --exclude='var/lib/seedrou/backups' --exclude='var/lib/seedrou/lastgood' \
    --exclude='etc/seedrou/secrets.json' \
    etc/seedrou var/lib/seedrou/notes.json 2>/dev/null || true
  [ -s "$out_path" ] || die "BACKUP_FAIL" "备份打包失败" "请检查磁盘空间（df -h）"
  # 备份不含 secrets（已剔除）：640 归面板用户，仅供下载
  chown seedrou:seedrou "$out_path" 2>/dev/null || true
  chmod 640 "$out_path"
  ok_out "path" "$out_path"
}

do_backup_restore() {
  require_root
  acquire_lock
  local src="${1:?缺少备份文件路径}"
  [ -f "$src" ] || die "NO_FILE" "备份文件不存在"
  # 成员白名单校验
  if ! tar -tzf "$src" 2>/dev/null | python3 -c '
import sys
ok = True
for line in sys.stdin:
    p = line.rstrip("\n")
    if not p: continue
    if p.startswith("/"): ok = False; break
    if ".." in p.split("/"): ok = False; break
    if not (p.startswith("etc/seedrou") or p == "var/lib/seedrou/notes.json"): ok = False; break
sys.exit(0 if ok else 1)
'; then
    die "BACKUP_BAD" "备份文件内容不符合 SeedRou 备份格式" "请确认上传的是本系统生成的备份包（.tar.gz）"
  fi
  # 拒绝符号/硬链接条目：防止"备份内软链指向 /etc"穿越写盘（审计 5.3）
  if tar -tvzf "$src" 2>/dev/null | awk '{print substr($1,1,1)}' | grep -qE '^[lh]'; then
    die "BACKUP_BAD" "备份包内含链接条目，已拒绝" "为防路径穿越，备份包只允许普通文件与目录"
  fi
  if ! tar -tzf "$src" 2>/dev/null | grep -q .; then
    die "BACKUP_BAD" "备份文件内容不符合 SeedRou 备份格式" "请确认上传的是本系统生成的备份包（.tar.gz）"
  fi
  snapshot_lastgood "r$(date +%s)"
  local stage; stage="$(mktemp -d /run/seedrou/restore.XXXXXX)"
  # --no-same-owner：root 解压不保留包内属主；防软链/目录覆盖类穿越（审计 5.3）
  tar -C "$stage" --no-same-owner --no-overwrite-dir -xzf "$src" 2>/dev/null \
    || { rm -rf "$stage"; die "BACKUP_BAD" "备份文件解压失败（文件可能损坏）"; }
  python3 -c 'import json;json.load(open("'"$stage"'/etc/seedrou/config.json"))' 2>/dev/null \
    || { rm -rf "$stage"; die "BACKUP_BAD" "备份中的配置无法解析"; }
  # 原子落盘
  if [ -d "$stage/etc/seedrou" ]; then
    while IFS= read -r -d '' f; do
      rel="${f#$stage/}"
      write_atomic "/${rel}" "$(stat -c %a "/$rel" 2>/dev/null || echo 600)" < "$f"
    done < <(find "$stage/etc/seedrou" -type f -print0)
  fi
  [ -f "$stage/var/lib/seedrou/notes.json" ] && write_atomic "${SEEDROU_VAR}/notes.json" 644 < "$stage/var/lib/seedrou/notes.json"
  rm -rf "$stage"
  chmod 600 "$SECRETS_JSON" 2>/dev/null || true
  # 备份不含 secrets：按 secrets.json 实际内容重算 has_password（复审 N-04）
  local pw_warn=""
  python3 - <<'PYEOF'
import json
try:
    cfg = json.load(open("/etc/seedrou/config.json"))
    sec = json.load(open("/etc/seedrou/secrets.json"))
except Exception:
    raise SystemExit
has = bool(sec.get("pppoe_password"))
cfg.setdefault("wan", {})["has_password"] = has
json.dump(cfg, open("/etc/seedrou/config.json.new", "w"), ensure_ascii=False, indent=1)
import os
os.replace("/etc/seedrou/config.json.new", "/etc/seedrou/config.json")
PYEOF
  if [ "$(python3 -c 'import json;c=json.load(open("'"$CONFIG_JSON"'"));print(c["wan"]["mode"]=="pppoe" and not c["wan"].get("has_password"))' 2>/dev/null)" = "True" ]; then
    pw_warn="注意：备份不含宽带密码，PPPoE 拨号尚未可用——请在「网络设置 → 上网设置」重新填写宽带密码并保存"
  fi
  # 重新生成 + 应用（失败必须如实上报，审计 B-08）
  local ap; ap="$(do_apply_all 2>&1)" || { printf '%s\n' "$ap"; exit 1; }
  ok_out "message" "配置已从备份恢复并生效${pw_warn:+。}$pw_warn"
}

