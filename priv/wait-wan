#!/usr/bin/env bash
# SeedRou × sing-box 共存组件：sing-box 启动前的 WAN 就绪等待。
# 由 install.sh / 收敛流程在检测到 sing-box.service 时自动安装为 systemd drop-in
# （ExecStartPre），取代游离的手工脚本——手工版本写死 ppp0，WAN 模式一变就失效。
#
# 逻辑按 /etc/seedrou/config.json 自适应：
#   PPPoE          → 等 ppp0 拿到 IPv4
#   DHCP / 静态    → 等任一 WAN 口拿到 IPv4
# 超时退出非 0，由 systemd Restart=on-failure 稍后重试。
# 为什么需要它：sing-box 的 tun auto_route 会在启动瞬间接管本机路由，若 WAN 未就绪，
# 本机出站（含 networkd 的前缀委派、dnsmasq 上游查询）会被塞进 tun 形成死循环。
set -u

WAIT_MAX="${SB_WAIT_WAN_TIMEOUT:-180}"
CFG="/etc/seedrou/config.json"

read -r MODE WANIF <<<"$(python3 - "$CFG" <<'PY'
import json, sys
try:
    cfg = json.load(open(sys.argv[1]))
    mode = cfg.get("wan", {}).get("mode", "dhcp")
    ifaces = [p["name"] for p in cfg.get("ports", []) if p.get("wan")]
except Exception:
    mode, ifaces = "dhcp", []
if mode == "pppoe":
    print("pppoe ppp0")
else:
    print("dhcp", " ".join(ifaces) if ifaces else "enp1s0")
PY
)"

wait_iface() {
    local i=0
    while [ "$i" -lt "$WAIT_MAX" ]; do
        if ip -4 addr show "$1" 2>/dev/null | grep -q 'inet '; then
            echo "wait-wan: $1 已就绪（等待 ${i}s）"
            return 0
        fi
        sleep 1; i=$((i+1))
    done
    echo "wait-wan: 等待 $1 获取 IPv4 超时（${WAIT_MAX}s），放弃本次启动" >&2
    return 1
}

if [ "$MODE" = "pppoe" ]; then
    wait_iface ppp0
else
    for IF in $WANIF; do
        if ip -4 addr show "$IF" 2>/dev/null | grep -q 'inet '; then
            echo "wait-wan: WAN($IF) 已就绪"
            exit 0
        fi
    done
    wait_iface "${WANIF%% *}"
fi
