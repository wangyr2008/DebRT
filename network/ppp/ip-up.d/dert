#!/bin/sh
# pppd ip-up.d 钩子：PPPoE 拨上后记录会话起点 + 更新上游 DNS + 重放 QoS
# 环境变量由 pppd 提供：$1=接口名 $2=tty $3=速率 $4=本地IP $5=对端IP $6=ipparam
IFACE="$1"
RUNDIR="/run/dert"
DNSDIR="/run/dert-dns"
CONF="${DNSDIR}/upstream.conf"
mkdir -p "$RUNDIR" "$DNSDIR"

# 会话起点（掉线重拨即归零；概览页"已连接 N 天"以此为准，审计 B-22）
date +%s > "${RUNDIR}/ppp-session-start" 2>/dev/null

# 观察②：与 70-dert-dns 的 ppp* 分支同构——合并而非全量覆盖。本钩子只产 v4，
# 若重拨瞬间 ip-up 在 dispatcher 之后跑，全量覆盖会把已写入的 v6 上游冲掉，
# 直到下一次 ppp0 事件才恢复；tmp 名带 $$：两个写者共用固定 .tmp 会交错写坏
{
  echo "# 由 pppd ip-up.d 生成（$IFACE）— 请勿手工修改"
  [ -f /etc/ppp/resolv.conf ] && grep -E '^nameserver' /etc/ppp/resolv.conf | awk '{print "server=" $2}'
  [ -f "$CONF" ] && grep -E '^server=' "$CONF" | grep ':'
} > "${CONF}.$$.tmp" 2>/dev/null
mv -f "${CONF}.$$.tmp" "$CONF"

systemctl is-active --quiet dnsmasq && pkill -HUP -x dnsmasq 2>/dev/null || true
[ -x /usr/local/lib/dert/qdisc-apply ] && /usr/local/lib/dert/qdisc-apply
[ -x /usr/local/lib/dert/wan-addr-sync ] && /usr/local/lib/dert/wan-addr-sync

# WAN 重拨后 PD 前缀可能变化，但 networkd-dispatcher 的 routable 事件不会因此触发
# （真机 2026-11-12 复现：ppp0 重拨后 br-lan 前缀从 a50:3d81 变成 a53:bf71，钩子零日志，
#  nft 的 v6 dnat 目标停在旧前缀，白名单设备的 v6 DNS 全部打向不存在的地址，437 个包落空）。
# 这里主动延迟 20 秒调一次——ppp0 ip-up 时 PD 还没委派到 br-lan，需要等它落地。
# 用 systemd-run 而不是后台 &：pppd 退出时会连带杀掉子进程。
# --collect：unit 执行完自动清理，避免每次重拨堆积一个 failed unit。
if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --on-active=20s --collect \
        /etc/networkd-dispatcher/routable.d/90-dert-lan-prefix br-lan routable \
        >/dev/null 2>&1 || true
fi

exit 0
