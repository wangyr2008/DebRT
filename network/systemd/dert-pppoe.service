[Unit]
Description=DebRT PPPoE 宽带拨号
Documentation=man:pppd(8)
After=systemd-networkd.service network-online.target
Wants=network-online.target
Before=dnsmasq.service
# 与 sing-box 无依赖关系（见 COEXISTENCE.md）；sing-box 的 auto_detect_interface 会跟踪 ppp0 默认路由

[Service]
Type=forking
ExecStart=/usr/sbin/pppd call dert
ExecStop=/usr/bin/poff dert
Restart=on-failure
RestartSec=5
TimeoutStartSec=90

# ---- 硬化（v0.1.96 / P4-3 收尾）----
# 与 dert-apply 同一套：只做**不把 /etc 挂成只读**的那几条。
# ProtectSystem=true 只锁 /usr 与 /boot；full/strict 会把 /etc 挂只读，
# 而这些单元都要写 /etc 或读 pppd 的 peer/chap-secrets 之外的东西。
ProtectSystem=true
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelLogs=true

[Install]
WantedBy=multi-user.target
