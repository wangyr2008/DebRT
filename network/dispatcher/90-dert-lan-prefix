#!/bin/sh
# WAN 重拨换 IPv6 前缀后的陈旧状态修复（networkd-dispatcher routable.d 钩子）。
#
# 背景（真机 2026-11-09 17:35，BRAS 主动 LCP terminated by peer 重拨）：
#   ① sing-box 的 tun auto_redirect 只在**启动时**构建 nft 集合 inet6_local_address_set。
#      WAN 换前缀后集合里仍是旧 /64 → 发往新 LAN 前缀（含路由器自身新地址）的 v6
#      被判成"非本地"，被劫持进 tun 当代理流量处理，白名单设备表现为"代理全挂"；
#      手动重启 sing-box 才恢复（这正是用户当时的自救动作）。
#   ② br-lan 上旧前缀的 RA on-link 路由（proto kernel + expires ≈60h）不会被自动清掉，
#      旧前缀流量继续被当本地直连；而旧前缀已不被运营商委派，源地址出网被 uRPF 丢弃。
#
# 本钩子：WAN/br-lan 的 routable 事件里，若 br-lan 全局 v6 前缀与上次记录不同
#   ① 清掉 br-lan 上不属于当前前缀的 RA 路由；② try-restart sing-box 重建集合。
# 只在真的换前缀时动作；开机首次（/run 已清空）只记录不重启——sing-box 启动时
# 本来就用当时的前缀建集合。
set -u

IFACE="${1:-}"
STATE="${2:-}"
[ "$STATE" = "routable" ] || exit 0
[ -f /etc/dert/config.json ] || exit 0

RUNDIR=/run/dert
REC="$RUNDIR/lan-prefix"
mkdir -p "$RUNDIR" 2>/dev/null || true

# 触发面：WAN 事件（ppp0 / DHCP-静态模式的 WAN 口）与 br-lan 事件。
# 前者是 PPPoE 重拨的主路径；后者兜住"会话没断但 PD 换前缀"的情形。
# 判据与 75-dert-pppoe-hotplug 同构
IS_TRIGGER=$(python3 - "$IFACE" <<'PYEOF'
import json, sys
try:
    cfg = json.load(open("/etc/dert/config.json"))
    ifaces = [p["name"] for p in cfg.get("ports", []) if p.get("wan")]
    if cfg.get("wan", {}).get("mode") == "pppoe":
        ifaces.append("ppp0")   # ppp0 由 25-ppp0.network 托管，其事件同样触发
except Exception:
    ifaces = []
ifaces.append("br-lan")
print("yes" if sys.argv[1] in ifaces else "no")
PYEOF
)
[ "$IS_TRIGGER" = "yes" ] || exit 0

# ppp0 down/up 会连发多个事件，只让一个实例干活（否则可能重复重启 sing-box）
# 注意：这行不能带 2>/dev/null——exec 的重定向是持久的，会把整个脚本的 stderr 吞掉
exec 9>"$RUNDIR/lan-prefix.lock"
flock -n 9 2>/dev/null || exit 0

# br-lan 当前全局 v6 前缀，统一成 x:x:x:x::/64，便于与路由表条目直接比对
lan_prefix() {
    ip -6 addr show dev br-lan scope global 2>/dev/null \
      | awk '$1 == "inet6" { split($2, a, "/"); if (split(a[1], h, ":") >= 4)
                               printf "%s:%s:%s:%s::/64\n", h[1], h[2], h[3], h[4] }' \
      | sort -u | tr '\n' ' ' | sed 's/ *$//'
}

# v0.1.66 移除了「首次记录时比对配置里的 v6 前缀」那段逻辑。
# 它读的是 00-dert-dns.json 里「按源 IP 分流」那条规则的 v6 网段字段，
# 而 v0.1.64 已把整条规则删掉（白名单 DNS 改由 nft 按 MAC 分流，不再靠源 IP）→ 判断恒为失败
# → 每次「基线缺失」都会无谓地重启一次 sing-box。
# 现在配置里已无任何前缀相关字段，唯一可能过期的是 nft 表里的 v6 DNAT 目标，
# 由 dns-split-sync 按当时地址重算即可——调它，不重启。
# 重启 sing-box 让 prepare 新写的 00-dert-dns.json 生效（在跑时顺带重建 local_address_set）
restart_singbox() {
    if systemctl is-active --quiet sing-box.service 2>/dev/null; then
        systemctl try-restart sing-box.service 2>/dev/null \
            && logger -t dert-lan "event=singbox_restart if=$1"
    else
        # 没在跑就不会触发 ExecStartPost，手动刷 nft 表让白名单 v6 目标跟上新前缀
        /usr/local/lib/dert/dns-split-sync 2>/dev/null || true
    fi
}

NEW="$(lan_prefix)"
OLD=""
[ -f "$REC" ] && OLD="$(cat "$REC" 2>/dev/null)"

# 不再在这里 sleep 轮询等前缀出现。
# 本钩子的主要触发者已改为 dert-netwatch：它订阅 rtnetlink，br-lan 一拿到
# 新的全局地址就立刻调用本钩子——那时前缀必然已经在位，不需要等。
# 而如果此刻取不到前缀（例如 networkd-dispatcher 在 PD 委派前就调了一次），
# 直接返回即可：等地址真正落地时 netwatch 会再调一次。
#
# 保留等待的害处：netwatch 的对账是串行的，钩子在这里阻塞 15 秒会把后续
# 事件（比如 tun0 建好、分流表该重建）一起拖住。
[ -n "$NEW" ] || exit 0

if [ -z "$OLD" ]; then
    printf '%s\n' "$NEW" > "$REC"
    # 基线缺失（/run 是 tmpfs，重启后本应由 dns-split-sync 在 ExecStartPost 里重建；
    # 钩子抢先于它运行时就会走到这里）。
    #
    # v0.1.64 之前这里要重生成 00-dert-dns.json 并重启 sing-box，因为配置里带着
    # 那条按源 IP 分流的规则，取不到前缀就会漏 v6 → 非白名单 AAAA 落 fakeip → v6 黑洞。
    # v0.1.64 起配置里已无任何前缀相关字段（direct inbound 监听 "::"，非白名单
    # 根本不进 sing-box），所以既不 prepare 也不重启。
    #
    # 唯一可能过期的是 nft 表里白名单的 v6 DNAT 目标（按建表那一刻的 GUA 写死）。
    # dns-split-sync 每次都按当时的 br-lan 地址重算，调它即可；它自己会判 sing-box
    # 是否在跑（没跑就直接退出），并发调也安全（nft -f 原子加载）。
    /usr/local/lib/dert/dns-split-sync 2>/dev/null || true
    exit 0
fi
[ "$OLD" = "$NEW" ] && exit 0

printf '%s\n' "$NEW" > "$REC"
logger -t dert-lan "event=prefix_change old=$OLD new=$NEW"

# ① 清旧前缀路由：只删 br-lan 上带 expires（RA/地址派生）且不在当前前缀集合里的，
#    静态路由（无 expires）一律不碰
for r in $(ip -6 route show dev br-lan 2>/dev/null \
           | awk '/expires/ && $1 ~ /:/ {print $1}'); do
    case " $NEW " in *" $r "*) continue ;; esac
    ip -6 route del "$r" dev br-lan 2>/dev/null \
        && logger -t dert-lan "event=stale_route_removed route=$r"
done

# ② 前缀变了，先重新生成 DNS 分流配置。
#    v0.1.64 起 00-dert-dns.json 里已没有前缀相关字段，prepare 本身与前缀无关；
#    这里仍然调用一次，是为了让「配置由本钩子重建」的语义保持完整（幂等、代价极低），
#    万一将来配置里又引入前缀相关的键，不会漏掉这一步。
/usr/local/lib/dert/dns-split-prepare 2>/dev/null || true

# ③ 重启 sing-box：主要目的是重建 local_address_set（auto_redirect 只在启动时构建，
#    换前缀后集合里仍是旧 /64，发往新 LAN 前缀的 v6 会被当成代理流量劫持进 tun）。
#    同时让 ② 写的新配置被读取——它只在启动时读配置。
#    v0.1.59 起不再以 local_address_set 存在为前提。
restart_singbox "sing-box 已重启（重建 local_address_set + 重载 DNS 分流配置）"
exit 0
