#!/bin/sh
# networkd-dispatcher 钩子（routable.d / no-carrier.d）
# 仅当事件接口是 WAN 口时：把 networkd 学到的上游 DNS 写入 /run/dert-dns/，
# dnsmasq 以 conf-dir=/run/dert-dns 动态读取。
IFACE="$1"
STATE="$2"
RUNDIR="/run/dert-dns"
CONF="${RUNDIR}/upstream.conf"

IS_WAN=$(python3 - "$IFACE" <<'PYEOF'
import json, sys
try:
    cfg = json.load(open("/etc/dert/config.json"))
    wans = [p["name"] for p in cfg.get("ports", []) if p.get("wan")]
    # R-02：PPPoE 下 ppp0 才是真正的 WAN 承载口，物理口只是二层链路
    # （v0.1.41 起 IPv6 也走 ppp0 的 DHCPv6，其 DNS 必须能被这里认到）
    if cfg.get("wan", {}).get("mode") == "pppoe":
        wans.append("ppp0")
except Exception:
    wans = []
print("yes" if sys.argv[1] in wans else "no")
PYEOF
)
[ "$IS_WAN" = "yes" ] || exit 0

mkdir -p "$RUNDIR"

case "$STATE" in
  routable) ;;
  *)
    # P3-17：链路消失时不再清空 upstream.conf。清空等于把"上一份有效上游"一起丢掉，
    # 而 ppp0 重拨时 routable 事件往往早于 DHCPv6 DNS 学到（此刻 links/$IDX 的 DNS=
    # 还没有 v6），v6 上游就此永久丢失（真机 2026-11-09 17:35 重拨：links 里两条 v6
    # 一直都在，CONF 却只剩 v4，面板与 dnsmasq 都看不到 v6）。保留文件 + ppp* 分支的
    # 空值回退，两者配合才自愈。链路不通时查询会直接 ENETUNREACH 快速失败，不会变慢。
    systemctl is-active --quiet dnsmasq && pkill -HUP -x dnsmasq 2>/dev/null
    exit 0 ;;
esac

IDX=$(cat "/sys/class/net/$IFACE/ifindex" 2>/dev/null) || exit 0
# A-09：改读 links/$IDX——其 DNS= 一行同时含 DHCPv4 与 RA/RDNSS/DHCPv6 学到的地址；
# 此前只读 leases/$IDX（纯 DHCPv4），RA 下发的 IPv6 上游永不生效（真机实录）
SRC="/run/systemd/netif/links/$IDX"
[ -f "$SRC" ] || exit 0

# R-02：PPPoE 的上游有两个来源——pppd ip-up.d 从 /etc/ppp/resolv.conf 抄来的 IPv4，
# 与 networkd 在 ppp0 上经 DHCPv6 学到的 IPv6。二者必须合并：若像物理口那样全量覆盖，
# 会把 ip-up 写入的 v4 冲掉；运营商不给 v6 DNS 时就等于没有上游。
case "$IFACE" in
  ppp*)
    # v4 上游两个来源，取到即用：
    #   ① /etc/ppp/resolv.conf —— pppd usepeerdns 的权威输出，会话期间一直有效
    #   ② CONF 里的旧 v4 —— 仅当 ① 为空时回退（N-05 保旧）
    # 只靠 ② 的话，一旦 CONF 丢了 v4，之后每次 ppp0 事件都只写 v6，运营商 v4 DNS
    # 要等到下一次拨号才回来（2026-11-09 真机踩到：手工把 CONF 换成只剩 v6 后，
    # 面板「DNS 服务器」一直是空的，而 /etc/ppp/resolv.conf 里两条一直都在）
    # v6 上游只有一个来源：links/$IDX 的 DNS=（networkd 在 ppp0 上经 DHCPv6 学到）。
    # 它会比 routable 事件晚到，为空时必须回退 CONF 里的旧 v6，否则重拨一次就永久丢失。
    V4=$(grep -E '^nameserver' /etc/ppp/resolv.conf 2>/dev/null | awk '{print "server=" $2}' | sort -u)
    V6=$(python3 - "$SRC" <<'PYEOF'
import sys
for line in open(sys.argv[1]):
    if line.startswith("DNS=") and line.strip() != "DNS=":
        for d in line.strip()[4:].split(" "):
            if d and ":" in d:      # ppp0 只取 IPv6；IPv4 见上面两个来源
                print(f"server={d}")
PYEOF
)
    [ -n "$V4" ] || V4=$(grep -E '^server=[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' "$CONF" 2>/dev/null | sort -u)
    [ -n "$V6" ] || V6=$(grep -E '^server=[0-9a-fA-F]*:[0-9a-fA-F:]+$' "$CONF" 2>/dev/null | sort -u)
    {
      echo "# 由 networkd-dispatcher 生成（$IFACE $STATE）— 请勿手工修改"
      printf '%s\n' "$V4" "$V6"
    } | grep -v '^$' > "${CONF}.$$.tmp" 2>/dev/null
    ;;
  *)
    {
      echo "# 由 networkd-dispatcher 生成（$IFACE $STATE）— 请勿手工修改"
      python3 - "$SRC" <<'PYEOF'
import sys
for line in open(sys.argv[1]):
    if line.startswith("DNS=") and line.strip() != "DNS=":
        for d in line.strip()[4:].split(" "):
            if d:
                print(f"server={d}")
PYEOF
    } > "${CONF}.$$.tmp" 2>/dev/null
    ;;
esac

# N-05：解析为空（WAN 刚重连、DNS 尚未学到）时保留上一份有效上游——
# links 文件总是存在，不像旧版 lease 缺失会 exit 0 天然保旧；空上游会让 dnsmasq 断解析
if grep -q '^server=' "${CONF}.$$.tmp" 2>/dev/null; then
  mv -f "${CONF}.$$.tmp" "$CONF"
else
  rm -f "${CONF}.$$.tmp"
fi
systemctl is-active --quiet dnsmasq && pkill -HUP -x dnsmasq 2>/dev/null || true
