[Unit]
# WAN 租约就绪后重建 dnsmasq 上游（事件驱动的开机路径）
# dnsmasq 不等它——先服务 DHCP/LAN，上游由本单元补齐后 HUP 生效
# 不依赖 network-online（同上）；等待逻辑在 wait-dns-upstream 内部（载波感知 ≤45s）
After=dnsmasq.service networkd-dispatcher.service
ConditionPathExists=/etc/networkd-dispatcher/routable.d/70-dert-dns

[Service]
Type=oneshot
# 有载波才等（最多 45s）；无线上位机/离线开机直接跳过，不拖慢启动
ExecStart=/usr/local/lib/dert/wait-dns-upstream
TimeoutStartSec=75

# ---- 硬化（v0.1.96 / P4-3 收尾）----
# 与 dert-apply 同一套：只做**不把 /etc 挂成只读**的那几条。
# ProtectSystem=true 只锁 /usr 与 /boot；full/strict 会把 /etc 挂只读，
# 而这些单元都要写 /etc 或读 pppd 的 peer/chap-secrets 之外的东西。
ProtectSystem=true
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelLogs=true
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
