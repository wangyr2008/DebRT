[Unit]
Description=DebRT 管理面板
# 只依赖 network.target，**不能**依赖"在线"目标（那个目标要等
# systemd-networkd-wait-online 判定所有受管接口就绪，而 br-lan 在网线没插时
# 永远不 routable，面板会被硬拖到超时（默认 90s+）才起来）。
# 面板只服务局域网，WAN 通不通与它无关——这一点和 sing-box drop-in 里的
# wait-wan 是同一类判断（那里明确写了不依赖"在线"目标）。
After=network.target

[Service]
Type=simple
User=dert
Group=dert
# 绑定 80 端口用 Ambient 即可；【不能】配 CapabilityBoundingSet —— bounding 集不含
# CAP_SETUID/CAP_SETGID 会让面板里的 setuid sudo 提权失败（"unable to change to root gid"，
# 真机首装实测），登录与全部特权操作断链。安全边界由 sudo 白名单 + 无 shell 用户保证。
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /usr/local/lib/dert/panel/dert_panel.py --port 80
Restart=on-failure
RestartSec=3
# ---- 硬化（v0.1.92 / P4-3）----
# 这里能做的只有"不挡子进程"的那几条。**不能**加 ProtectSystem：面板经 sudo
# 调起的 upgrade-apply 要整目录替换 /usr/local/lib/dert，挂成只读会让升级必失败
# ——升级通道本身不能成为风险点。同理不能加 NoNewPrivileges（会废掉 setuid sudo）。
# 原先这里有一条 ReadWritePaths=/var/lib/dert /run/dert，但**没有 ProtectSystem
# 时它是空操作**（ReadWritePaths 只对已被挂成只读的路径生效），属于给了假的安全感，
# 已删除；真要放开写权限，靠的是文件系统属主（dert:dert）而不是这条指令。
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=no

[Install]
WantedBy=multi-user.target
