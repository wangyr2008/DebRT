[Unit]
# pppd persist 对"接口被外部删除"不敏感：服务 active 但 ppp0 已消失时不会自愈
# （2026-11-05 真机实录）。由本单元周期探测，连续缺失 3 分钟则重启拨号。
Description=DebRT PPPoE 看门狗（ppp0 缺失时重启拨号）
After=network.target
ConditionPathExists=/etc/dert/config.json

[Service]
Type=oneshot
ExecStart=/usr/local/lib/dert/pppoe-watchdog
TimeoutStartSec=30

# ---- 硬化（v0.1.96 / P4-3 收尾）----
# 与 dert-apply 同一套：只做**不把 /etc 挂成只读**的那几条。
# ProtectSystem=true 只锁 /usr 与 /boot；full/strict 会把 /etc 挂只读，
# 而这些单元都要写 /etc 或读 pppd 的 peer/chap-secrets 之外的东西。
ProtectSystem=true
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelLogs=true
